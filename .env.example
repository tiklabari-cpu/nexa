# Nexa — local development environment.
# Copy to `.env` (`make env`). NEVER commit `.env`.

NODE_ENV=development
NEXA_REGION=eu
LOG_LEVEL=info

# --- Datastores (ports offset to avoid clashing with any local postgres/redis) ---
# Migrations/DDL run as the owner; the API runtime uses nexa_app so RLS applies.
DATABASE_URL=postgresql://nexa:nexa_dev_password@localhost:5433/nexa
DATABASE_APP_URL=postgresql://nexa_app:nexa_app_dev_password@localhost:5433/nexa
REDIS_URL=redis://localhost:6380

# --- Services ---
API_PORT=4000
API_HOST=0.0.0.0
RTM_PORT=4001
RTM_HOST=0.0.0.0
WEB_PORT=5173
WIDGET_PORT=5174
API_BASE_URL=http://localhost:4000
RTM_BASE_URL=ws://localhost:4001
# How many reverse proxies in front of the API are trusted to have appended to
# `X-Forwarded-For`. This is what `request.ip` is derived from, and `request.ip`
# is the anonymous rate-limit bucket, the customer IP ban and the agent IP
# allow-list — so it has to match the deployment: 0 when the API is reached
# directly, 1 behind a single reverse proxy (the default, and what the compose
# stack's nginx is), 2 for a CDN in front of an ingress. Too high and a caller
# can put an allow-listed address in the header and be believed.
TRUST_PROXY_HOPS=1
# How long a shutting-down process keeps answering after readiness turns false,
# in milliseconds (M-OPS-b). The gap is what lets an orchestrator notice the
# 503 on /health/ready and stop routing before the socket goes away; size it at
# or above its readiness probe period. Unset it follows the environment —
# production drains 5s, development and test drain 0, because nothing is
# probing a `make dev` and every suite closing a server would pay the wait.
# SHUTDOWN_DRAIN_MS=5000
# CORS origins the API answers cross-origin — the agent app, plus anything else
# a browser loads it from (e.g. a separately hosted chat page). Comma-separated;
# only production enforces the list, and a value that is not a bare
# `scheme://host[:port]` origin fails the boot rather than matching nothing.
WEB_ORIGIN=http://localhost:5173
# Origin serving the widget loader + iframe (the install snippet and
# `loader.js` point at this).
WIDGET_BASE_URL=http://localhost:5174

# --- Secrets (dev only — rotate for any real deployment) ---
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-0123456789abcdef
WEBHOOK_HMAC_SEED=dev-only-webhook-hmac-seed-change-me-0123456789abcdef
CUSTOMER_TOKEN_SECRET=dev-only-customer-token-secret-change-me-0123456789
UPLOAD_SIGNING_KEY=dev-only-upload-signing-key-change-me-0123456789
# Root of the audit chain's per-workspace keys (NFR-C6). Deliberately not stored
# in the database: an attacker holding the database can still delete audit rows,
# but without this they cannot recompute a chain that hides the deletion. Keep
# old values when rotating — entries written under them verify under them.
AUDIT_CHAIN_SECRET=dev-only-audit-chain-secret-change-me-0123456789abcdef

# --- Token lifetimes (seconds) ---
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
CUSTOMER_TOKEN_TTL=28800
AUTH_CODE_TTL=120
# The two-factor enrollment ticket (S11-2FA-k): long enough to install an
# authenticator app and wait for a code, short enough not to be a session.
TWO_FACTOR_ENROLLMENT_TICKET_TTL=600

# --- Rate limits (ADR-07) ---
RATE_LIMIT_AGENT_PER_MIN=180
RATE_LIMIT_AGENT_BURST=30
RATE_LIMIT_CUSTOMER_PER_MIN=60
# Unauthenticated per IP: sign-in, token exchange, widget tokens. The e2e suite
# drives all three in a tight loop — .env raises this locally, and CI does too.
RATE_LIMIT_ANON_PER_MIN=30
RATE_LIMIT_RTM_PER_SEC=10
# Anonymous public-KB reads, per IP — higher than the general anon limit
# because this is the SEO surface a search crawler indexes.
RATE_LIMIT_PUBKB_PER_MIN=300
# SCIM provisioning connectors, per token — higher because a directory sync
# is bursty (a full reconciliation pages the whole workspace at once).
RATE_LIMIT_SCIM_PER_MIN=300
# /health, per IP (M-SEC-b2) — high on purpose: a probe on a tight interval
# must never trip it, the ceiling only bounds abuse of a public endpoint.
RATE_LIMIT_HEALTH_PER_MIN=600
# Second-factor code presentations at /auth/authorize, per account per HOUR
# (S11-2FA-e). An hour, not a minute: this bounds a search of a six-digit
# code, and a window that resets every minute bounds nothing.
RATE_LIMIT_TWO_FACTOR_PER_HOUR=20

# --- Billing (ADR-13) — Stripe is mocked, no external calls ---
TRIAL_DAYS=14
UNIT_PRICE_CENTS=9900
AI_RESOLUTIONS_INCLUDED=200
AI_OVERAGE_CENTS=50
# API calls: 100,000 included, overage billed at $29.50 per 100,000 (FR-MOD-10.1.5)
API_CALLS_INCLUDED=100000
API_CALL_OVERAGE_CENTS=2950

# --- Mocked providers ---
LLM_PROVIDER=mock
# Where LLM_PROVIDER runs the inference (NFR-C4). Unset = this process's own
# region, which is the truth for the in-process stub. A deployment pointing at a
# model service elsewhere must say so: a workspace with a signed HIPAA agreement
# refuses every AI feature rather than sending its content out of region.
# LLM_PROVIDER_REGION=us
# Outgoing mail: `file` writes each message under MAIL_DIR instead of sending
# it (PLAN A4); `null` discards. The test fixture asks for `null`.
MAIL_PROVIDER=file
# Outgoing push: same pair of mocks, spooled under PUSH_DIR per license (13.7-d).
PUSH_PROVIDER=file
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
UPLOAD_URL_TTL=300
# The payment processor. `mock` accepts any unexpired card and charges nothing
# (ADR-13); there is no real implementation and none is in scope.
STRIPE_PROVIDER=mock
# `mock` flags the EICAR test file and passes the rest; `unavailable` is
# always-down, for exercising the fail-closed upload path in tests/drills.
VIRUS_SCANNER=mock

# Invitation links point at the agent app, not the API.
WEB_APP_URL=http://localhost:5173
# Outgoing mail is written here rather than sent (PLAN A4).
MAIL_DIR=.data/mail
# Push notifications, written per license rather than delivered (13.7-d).
PUSH_DIR=.data/push
# Where the scheduled SIEM sink writes the mock file target (NFR-C6 · C6-d).
SIEM_DIR=.data/siem
# Which SIEM destination this deployment can deliver to. A workspace may only
# choose a target this build implements; the sink fails loudly on any other.
SIEM_PROVIDER=file
# How far behind "now" the SIEM export stops, in milliseconds (NFR-C6 ·
# C6-b) — a correctness bound, not a throttle. See config/env.ts.
SIEM_EXPORT_HORIZON_MS=10000

# Domain a workspace forwards its support mail to (FR-MOD-08.5.3); must match
# what the web app shows on the Email channel card (VITE_INBOUND_EMAIL_DOMAIN).
INBOUND_EMAIL_DOMAIN=inbound.nexa.localhost
# Shared secret the mail provider presents on the inbound webhook. Unset
# leaves the endpoint open (fine here — dev/test default). REQUIRED in any
# real deployment, or anyone can post mail into a workspace's inbox — so
# `parseEnv` refuses to boot under NODE_ENV=production without it (M-PROD-CFG-a).
# INBOUND_EMAIL_SECRET=

# --- Data retention (NFR-C8, GDPR/KVKK) — windows in days for `retention:run` ---
# Closed conversations, visitor telemetry and outgoing mail older than these are
# hard-deleted by the retention sweep. Each must be a positive integer.
RETENTION_THREAD_DAYS=365
RETENTION_VISIT_DAYS=90
RETENTION_MAIL_DAYS=30
# Audit log window (NFR-S12: "last 30 days" of basic audit, every plan).
RETENTION_AUDIT_DAYS=30

# --- Observability (NFR-M5) — OpenTelemetry spans + metrics ---
# Unset follows the environment: on in dev/prod (console exporter — there is no
# collector here), off under test. Set true/false to override. Spans carry the
# request_id, so a trace joins to the matching log line and X-Request-Id header.
# OTEL_ENABLED=true

# --- Background jobs (M-SCHED) — the in-process scheduler ---
# Runs the sweeps that used to need a host cron: idle chat auto-close, SLA
# breach marking, the SIEM export, scheduled reports, retention and webhook
# redelivery. Unset it follows the environment — on in dev/prod, off under test.
# Each one also keeps its `pnpm --filter @nexa/api <job>:run` script, which is
# how a deployment that would rather drive them from outside the app does it.
# SCHEDULER_ENABLED=true
# Spread applied to every interval, in percent, so instances from one deploy do
# not tick in lockstep. 0 turns it off.
# SCHEDULE_JITTER_PCT=10
# Per-job intervals in milliseconds. The minute-scale ones are latency a person
# can feel; retention is hourly because it deletes and there is nothing to gain
# from looking more often.
# SCHEDULE_CHAT_TIMEOUT_MS=60000
# SCHEDULE_SLA_MS=60000
# SCHEDULE_SIEM_MS=300000
# SCHEDULE_SCHEDULED_REPORTS_MS=60000
# SCHEDULE_RETENTION_MS=3600000
# SCHEDULE_WEBHOOK_REDELIVERY_MS=60000
# Attempts an outbound webhook delivery gets in total: the three inside the
# request that fired the event, plus every scheduled redelivery after them.
# Eight is roughly four hours of backoff — long enough to ride out a receiver's
# deploy, short enough that a dead endpoint is declared dead the same day.
# WEBHOOK_MAX_ATTEMPTS=8
# The retention job is registered like the other five but does not run until
# this is set — it hard-deletes data, and unlike `retention:run --apply` there
# is no operator here to confirm each pass. /health shows it `disabled` either
# way, never simply absent.
# RETENTION_ENABLED=false
