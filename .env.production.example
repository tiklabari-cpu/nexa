# Nexa — production environment template. Sibling of `.env.example` (which is
# for `make dev`). Copy to `.env` on the host that runs `apps/api`/`apps/rtm`
# under NODE_ENV=production and fill in every value below that is not already
# a real one — `parseEnv` (apps/api/src/config/env.ts, apps/rtm/src/config/env.ts)
# refuses to boot until you do. See README "Production configuration" for the
# full reasoning; this file gives one line each.
#
# Contains NO real secrets. Every placeholder is either a literal you must
# replace or a generation instruction — never a working default. A value that
# still starts with `dev-only-` (the marker `.env.example` uses) is one of the
# things `parseEnv` refuses under production, on purpose (M-PROD-CFG-a).

NODE_ENV=production
NEXA_REGION=eu
# Which region this process's own AI inference and log timestamps belong to
# (NFR-C4). "us" is the only other value; must match what the RTM gateway is
# given, since both read the same variable.
LOG_LEVEL=info

# --- Datastores — all three REQUIRED, boot refuses without them ---
# Owner role: runs migrations. Never used by the request path (see DATABASE_APP_URL).
DATABASE_URL=postgresql://<owner_user>:<owner_password>@<db-host>:5432/<db>
# REQUIRED in production: the non-owner `nexa_app` role. Postgres exempts table
# owners from row level security, so pointing this at the owner (or leaving it
# unset, which falls back to DATABASE_URL) silently disables every tenant
# isolation policy while every test still passes.
DATABASE_APP_URL=postgresql://nexa_app:<app_password>@<db-host>:5432/<db>
REDIS_URL=redis://<redis-host>:6379

# --- Services ---
API_PORT=4000
API_HOST=0.0.0.0
RTM_PORT=4001
RTM_HOST=0.0.0.0
# Public URL agents/customers reach this deployment's API and RTM at — used to
# build absolute links (invitations, webhook docs), not for routing.
API_BASE_URL=https://<api-hostname>
RTM_BASE_URL=wss://<rtm-hostname>
# How many reverse-proxy hops in front of this process are trusted to have
# appended to X-Forwarded-For — decides the anon rate-limit bucket, the
# customer IP ban and the agent IP allow-list. Wrong in either direction is a
# security bug, not a cosmetic one: see README "Production configuration" for
# how to count it for your topology. 1 is correct only behind exactly one
# reverse proxy (e.g. the compose stack's nginx sidecar).
TRUST_PROXY_HOPS=1
# REQUIRED to change: comma-separated list of origins this deployment serves
# the agent panel (and any separately hosted chat page) from. Left at the
# localhost default, every real browser request is refused by CORS.
WEB_ORIGIN=https://panel.<your-domain>
# Origin serving the widget loader + iframe — the install snippet and
# loader.js point at this.
WIDGET_BASE_URL=https://widget.<your-domain>

# --- Secrets — REQUIRED, generate fresh per deployment, never reuse dev/staging ---
JWT_SIGNING_KEY=<üret: openssl rand -hex 32>
WEBHOOK_HMAC_SEED=<üret: openssl rand -hex 32>
# Must be byte-identical between apps/api and apps/rtm — both verify customer
# tokens with it, and a mismatch fails every widget connection.
CUSTOMER_TOKEN_SECRET=<üret: openssl rand -hex 32>
UPLOAD_SIGNING_KEY=<üret: openssl rand -hex 32>
# Root of the audit hash chain (NFR-C6). Deliberately never stored in the
# database, so a database compromise alone cannot recompute a chain that hides
# a deleted row. Keep every old value on rotation — entries already written
# only verify under the value they were written with.
AUDIT_CHAIN_SECRET=<üret: openssl rand -hex 32>

# --- Required in production only: inbound mail webhook auth ---
# Unset, this endpoint authenticates nobody — the recipient address is the
# only routing key, and it is handed to customers. `parseEnv` refuses to boot
# under production without it (M-PROD-CFG-a); dev/test leave it unset on purpose.
INBOUND_EMAIL_SECRET=<üret: openssl rand -hex 32>
# Domain a workspace's support mail forwards to; must match what the web app
# shows on the Email channel card (VITE_INBOUND_EMAIL_DOMAIN, apps/web's own .env).
INBOUND_EMAIL_DOMAIN=inbound.<your-domain>

# --- Everything below keeps its .env.example default unless your deployment
#     needs otherwise; uncomment to override, one line each for what changing
#     it does. None of these fail the boot on their own. ---

# ACCESS_TOKEN_TTL=3600                    # agent session access token, seconds
# REFRESH_TOKEN_TTL=2592000                # agent refresh token, seconds (30d)
# CUSTOMER_TOKEN_TTL=28800                 # widget customer token, seconds (8h)
# AUTH_CODE_TTL=120                        # OAuth 2.1/PKCE code lifetime, seconds
# TWO_FACTOR_ENROLLMENT_TICKET_TTL=600     # time to finish 2FA enrollment, seconds

# RATE_LIMIT_AGENT_PER_MIN=180             # signed-in agent requests
# RATE_LIMIT_AGENT_BURST=30
# RATE_LIMIT_CUSTOMER_PER_MIN=60           # widget customer requests
# RATE_LIMIT_ANON_PER_MIN=30               # unauthenticated: sign-in, token exchange, widget tokens
# RATE_LIMIT_RTM_PER_SEC=10                # RTM socket messages
# RATE_LIMIT_PUBKB_PER_MIN=300             # anonymous public-KB reads (SEO crawl surface)
# RATE_LIMIT_SCIM_PER_MIN=300              # per SCIM provisioning token
# RATE_LIMIT_HEALTH_PER_MIN=600            # /health probes, per IP
# RATE_LIMIT_TWO_FACTOR_PER_HOUR=20        # 2FA code attempts, per account per hour

# TRIAL_DAYS=14                            # billing: trial length
# UNIT_PRICE_CENTS=9900
# AI_RESOLUTIONS_INCLUDED=200
# AI_OVERAGE_CENTS=50
# API_CALLS_INCLUDED=100000
# API_CALL_OVERAGE_CENTS=2950

# --- Providers: this codebase mocks every external service on purpose
#     (CLAUDE.md — no real Stripe/WhatsApp/LLM/SMTP integration is in scope).
#     Leave these at their mock/local/file values in production too; there is
#     nothing else implemented for them to become. ---
LLM_PROVIDER=mock
# LLM_PROVIDER_REGION=eu                   # only if inference runs in a different region than this process (NFR-C4)
MAIL_PROVIDER=file
PUSH_PROVIDER=file
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.data/uploads          # move off the container filesystem if it must survive a redeploy
# UPLOAD_URL_TTL=300
STRIPE_PROVIDER=mock
VIRUS_SCANNER=mock

WEB_APP_URL=https://panel.<your-domain>
# MAIL_DIR=.data/mail
# PUSH_DIR=.data/push
# SIEM_DIR=.data/siem
# SIEM_PROVIDER=file
# SIEM_EXPORT_HORIZON_MS=10000

# RETENTION_THREAD_DAYS=365                # closed conversations
# RETENTION_VISIT_DAYS=90                  # visitor telemetry
# RETENTION_MAIL_DAYS=30                   # spooled outgoing mail
# RETENTION_AUDIT_DAYS=30                  # basic audit log (NFR-S12)

# OTEL_ENABLED=true                        # unset already means "on" in production; set false to opt out

# --- Background jobs (M-SCHED) — see README "Background jobs" for what each does ---
# SCHEDULER_ENABLED=true                   # unset already means "on" in production
# SCHEDULE_JITTER_PCT=10
# SCHEDULE_CHAT_TIMEOUT_MS=60000
# SCHEDULE_SLA_MS=60000
# SCHEDULE_SIEM_MS=300000
# SCHEDULE_SCHEDULED_REPORTS_MS=60000
# SCHEDULE_RETENTION_MS=3600000
# SCHEDULE_WEBHOOK_REDELIVERY_MS=60000
# WEBHOOK_MAX_ATTEMPTS=8
# RETENTION_ENABLED=false                  # stays off even with the scheduler on — review RETENTION_*_DAYS above first, this sweep hard-deletes
