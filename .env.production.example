# SiyahTuş — production environment template. Sibling of `.env.example` (which is
# for `make dev`). Copy to `.env` on the host that runs `apps/api`/`apps/rtm`
# under NODE_ENV=production and fill in every value below that is not already
# a real one — `parseEnv` (apps/api/src/config/env.ts, apps/rtm/src/config/env.ts)
# refuses to boot until you do. See README "Production configuration" for the
# full reasoning; this file gives one line each.
#
# Contains NO real secrets. Every placeholder is either a literal you must
# replace or a generation instruction — never a working default. A value that
# still starts with `dev-only-` (the marker `.env.example` uses) is one of the
# things `parseEnv` refuses under production, on purpose (M-PROD-CFG-a) — and so
# is any value still holding a `<…>` fill-in from this file (tm 255.15), named
# key by key at boot.
#
# The pilot (docker-compose.pilot.yml, tm 255.15) reads this file, filled in,
# as `.env` next to the compose file: both as every container's environment
# and as Compose's own `${…}` source. What it runs is written down below as the
# values that are set, not as comments: real LLM, real embeddings, real SMTP.
# Run procedure: docs/production-checklist.md "Pilot on Docker Compose".

NODE_ENV=production
SIYAHTUS_REGION=eu
# Which region this process's own AI inference and log timestamps belong to
# (NFR-C4). "us" is the only other value; must match what the RTM gateway is
# given, since both read the same variable.
LOG_LEVEL=info

# --- Pilot compose only: the database container's two passwords ---
# docker-compose.pilot.yml runs Postgres itself and assembles DATABASE_URL,
# DATABASE_APP_URL and REDIS_URL for api/rtm from these (its values override
# the three lines further down, which are for a database you run elsewhere).
# Hex only — they are spliced into a connection URL. SIYAHTUS_APP_DB_PASSWORD is
# applied to the `siyahtus_app` role on the FIRST start of an empty volume only
# (infra/db/pilot/10-app-role-password.sh); changing it later is a manual
# ALTER ROLE, see the checklist.
POSTGRES_PASSWORD=<üret: openssl rand -hex 32>
SIYAHTUS_APP_DB_PASSWORD=<üret: openssl rand -hex 32>

# --- Datastores — all three REQUIRED, boot refuses without them ---
# Owner role: runs migrations. Never used by the request path (see DATABASE_APP_URL).
DATABASE_URL=postgresql://<owner_user>:<owner_password>@<db-host>:5432/<db>
# REQUIRED in production: the non-owner `siyahtus_app` role. Postgres exempts table
# owners from row level security, so pointing this at the owner (or leaving it
# unset, which falls back to DATABASE_URL) silently disables every tenant
# isolation policy while every test still passes.
DATABASE_APP_URL=postgresql://siyahtus_app:<app_password>@<db-host>:5432/<db>
# Prisma connection pool size for this process (M-SCALE-b) — set explicitly
# once pod count > 1: pool size × pod count (api + rtm) must stay within
# Postgres' max_connections, with headroom left for the standalone job
# scripts and Postgres' own reserved connections. See README "Connection pool
# budget". If DATABASE_APP_URL points at PgBouncer in transaction-pooling
# mode, append `?pgbouncer=true` to it instead (see README "PgBouncer
# transaction-mode compatibility") — DATABASE_URL must keep reaching Postgres
# directly for migrations either way.
# DATABASE_POOL_SIZE=10
# OPTIONAL read replica for the heavy report queries (M-SCALE-c · NFR-P7/R4).
# Unset, those reads stay on DATABASE_APP_URL and behaviour is unchanged. Point
# it at a standby and the report/export/access-review endpoints and the
# scheduled-report sweep read there instead; everything that must read its own
# writes (billing, metering counters) stays on the primary regardless, because a
# standby is behind by an amount no application controls. Use the SAME non-owner
# role as DATABASE_APP_URL — a replica on the owner's credentials is exempt from
# row level security and would return every tenant's rows through an endpoint
# whose only isolation is RLS; boot refuses that combination rather than trusting
# anyone to notice. See README "Read replica".
# DATABASE_REPLICA_URL=postgresql://siyahtus_app:<app_password>@<replica-host>:5432/<db>
REDIS_URL=redis://<redis-host>:6379

# --- Services ---
API_PORT=4000
API_HOST=0.0.0.0
RTM_PORT=4001
RTM_HOST=0.0.0.0
# Public URL agents/customers reach this deployment's API and RTM at — used to
# build absolute links (invitations, webhook docs), not for routing.
API_BASE_URL=https://<api-hostname>
RTM_BASE_URL=wss://<rtm-hostname>
# How many reverse-proxy hops in front of this process are trusted to have
# appended to X-Forwarded-For — decides the anon rate-limit bucket, the
# customer IP ban and the agent IP allow-list. Wrong in either direction is a
# security bug, not a cosmetic one: see README "Production configuration" for
# how to count it for your topology. 1 is correct only behind exactly one
# reverse proxy on every path — the pilot's infra/pilot/Caddyfile.example is
# built for that: it sends the panel's /api/* straight to the api rather than
# through the panel's nginx, which would be a second hop. The proxy next to the
# API must connect from loopback or a private network; a public peer is read as
# the client (GHSA-3m5p-2c4r-xxw2).
TRUST_PROXY_HOPS=1
# How long api/rtm keep answering after SIGTERM turns /health/ready to 503,
# in milliseconds. Defaults to 5000 in production; raise it to your readiness
# probe period if that is longer, and keep it well under the orchestrator's own
# grace period (Kubernetes terminationGracePeriodSeconds, 30s by default) or
# SIGKILL lands mid-drain.
# SHUTDOWN_DRAIN_MS=5000
# REQUIRED to change: comma-separated list of EVERY origin a browser loads a
# SiyahTuş page from — the agent panel, any separately hosted chat page, and the
# widget origin below (WIDGET_BASE_URL). The widget has no same-origin backend:
# its browser code calls this API cross-origin, so a list naming only the panel
# serves agents and refuses every customer conversation, and refuses them
# silently — the browser drops the response and nothing here logs an error.
# Boot refuses a list that omits WIDGET_BASE_URL's origin rather than let that
# happen. Left at the localhost default, every real browser request is refused
# by CORS.
WEB_ORIGIN=https://panel.<your-domain>,https://widget.<your-domain>
# Origin serving the widget loader + iframe — the install snippet and
# loader.js point at this. Its origin must appear in WEB_ORIGIN above; serving
# the widget from the panel's own host satisfies that without a second entry.
WIDGET_BASE_URL=https://widget.<your-domain>

# --- Sign-up (tm 256.3) ---
# Sign-up is anonymous and checks no email: while it is open, anyone who finds
# this address can create a workspace and spend its model key and mailbox.
# Leave it true until the pilot's own workspaces exist (there is no seed — the
# first one is created by signing up in the panel), then set false and
# `docker compose -f docker-compose.pilot.yml up -d`. Closed, POST /auth/signup
# answers 403 and creates nothing; invitations keep working. Only `true` or
# `false` — anything else (an empty value included) stops the boot.
SIGNUP_ENABLED=true

# --- Secrets — REQUIRED, generate fresh per deployment, never reuse dev/staging ---
JWT_SIGNING_KEY=<üret: openssl rand -hex 32>
WEBHOOK_HMAC_SEED=<üret: openssl rand -hex 32>
# Must be byte-identical between apps/api and apps/rtm — both verify customer
# tokens with it, and a mismatch fails every widget connection.
CUSTOMER_TOKEN_SECRET=<üret: openssl rand -hex 32>
UPLOAD_SIGNING_KEY=<üret: openssl rand -hex 32>
# Root of the audit hash chain (NFR-C6). Deliberately never stored in the
# database, so a database compromise alone cannot recompute a chain that hides
# a deleted row. Keep every old value on rotation — entries already written
# only verify under the value they were written with.
AUDIT_CHAIN_SECRET=<üret: openssl rand -hex 32>

# --- Required in production only: inbound mail webhook auth ---
# Unset, this endpoint authenticates nobody — the recipient address is the
# only routing key, and it is handed to customers. `parseEnv` refuses to boot
# under production without it (M-PROD-CFG-a); dev/test leave it unset on purpose.
INBOUND_EMAIL_SECRET=<üret: openssl rand -hex 32>
# Domain a workspace's support mail forwards to; must match what the web app
# shows on the Email channel card (VITE_INBOUND_EMAIL_DOMAIN, apps/web's own .env).
INBOUND_EMAIL_DOMAIN=inbound.<your-domain>

# --- Everything below keeps its .env.example default unless your deployment
#     needs otherwise; uncomment to override, one line each for what changing
#     it does. None of these fail the boot on their own. ---

# ACCESS_TOKEN_TTL=3600                    # agent session access token, seconds
# REFRESH_TOKEN_TTL=2592000                # agent refresh token, seconds (30d)
# CUSTOMER_TOKEN_TTL=28800                 # widget customer token, seconds (8h)
# AUTH_CODE_TTL=120                        # OAuth 2.1/PKCE code lifetime, seconds
# TWO_FACTOR_ENROLLMENT_TICKET_TTL=600     # time to finish 2FA enrollment, seconds

# RATE_LIMIT_AGENT_PER_MIN=180             # signed-in agent requests
# RATE_LIMIT_AGENT_BURST=30
# RATE_LIMIT_CUSTOMER_PER_MIN=60           # widget customer requests
# RATE_LIMIT_ANON_PER_MIN=30               # unauthenticated: sign-in, token exchange, widget tokens
# RATE_LIMIT_RTM_PER_SEC=10                # RTM socket messages
# RATE_LIMIT_PUBKB_PER_MIN=300             # anonymous public-KB reads (SEO crawl surface)
# RATE_LIMIT_SCIM_PER_MIN=300              # per SCIM provisioning token
# RATE_LIMIT_HEALTH_PER_MIN=600            # /health probes, per IP
# RATE_LIMIT_TWO_FACTOR_PER_HOUR=20        # 2FA code attempts, per account per hour

# TRIAL_DAYS=14                            # trial length of workspaces signed up from now on (read since tm 256.1; see the checklist's pilot section)
# UNIT_PRICE_CENTS=9900
# AI_RESOLUTIONS_INCLUDED=200
# AI_OVERAGE_CENTS=50
# API_CALLS_INCLUDED=100000
# API_CALL_OVERAGE_CENTS=2950

# --- Providers. The pilot (owner decision 2026-09-22) runs three real ones —
#     the LLM, the embedding model and SMTP mail — and keeps the rest mocked:
#     payments, push, virus scanning and object storage are outside it. Each
#     real provider below is SET, so production refuses to boot until every
#     key it needs holds a real value (productionProblems names the missing
#     ones). Only key names are written here; the values belong in the
#     deployment's own .env and nowhere else — not in a ticket, a log or a
#     commit. ---

# Chat model: `openai` (ADR docs/adr/pilot-llm-embedding-provider.md §9.1,
# adapter tm 255.6). Needs all four keys plus LLM_PROVIDER_REGION, and the base
# URL must be the regional host for that region — the global api.openai.com is
# refused. LLM_PROVIDER_REGION is the region inference runs in (NFR-C4).
LLM_PROVIDER=openai
LLM_PROVIDER_REGION=eu
LLM_API_BASE_URL=https://eu.api.openai.com/v1
LLM_MODEL=<model id>
LLM_API_KEY=<from your provider>
# LLM_TIMEOUT_MS=20000
# LLM_MAX_OUTPUT_TOKENS=400
# LLM_MAX_PROMPT_CHARS=16000             # a longer prompt is never sent; a human answers

# Embeddings: `openai` (ADR §9.2, adapter tm 255.7), same rules under their own
# keys; EMBEDDING_API_KEY may hold the same value as LLM_API_KEY. A database
# that starts on `openai` has nothing to re-embed. One that stored knowledge
# under `mock` first has to be re-embedded after the switch: `pnpm --filter
# @siyahtus/api knowledge:reembed` (per source, resumable; `--status` shows what
# is left).
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_REGION=eu
EMBEDDING_API_BASE_URL=https://eu.api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=<from your provider>
# EMBEDDING_DIMENSIONS=1536               # an assertion: anything else refuses to boot
# EMBEDDING_TIMEOUT_MS=10000

# Mail: `smtp` really sends — through PrivateEmail in the pilot (ADR §9.3,
# carrier tm 255.3). Five keys are required once it is chosen. SMTP_FROM is a
# bare address (name@domain) — a display name (`SiyahTuş <…>`) stops the api at
# boot.
MAIL_PROVIDER=smtp
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<mailbox login>
SMTP_PASSWORD=<from your mail provider>
SMTP_FROM=<sender address>
# SMTP_TIMEOUT_MS=10000
# ASSIGNEE_EMAIL_COOLDOWN_MS=900000        # one assignee e-mail per chat per 15 min (tm 256.4); 0 = every message
PUSH_PROVIDER=file
# `local` keeps uploads on the pod that received them; with more than one
# replica an attachment is then invisible to the other pods (NFR-R1). Switch
# to `s3` and fill the five keys below for any deployment that scales out.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.data/uploads          # move off the container filesystem if it must survive a redeploy
# STORAGE_S3_ENDPOINT=https://s3.<region>.amazonaws.com
# STORAGE_S3_BUCKET=<your-bucket>
# STORAGE_S3_REGION=<region>
# STORAGE_S3_ACCESS_KEY_ID=<from your object store>
# STORAGE_S3_SECRET_ACCESS_KEY=<from your object store>
# STORAGE_S3_FORCE_PATH_STYLE=true         # false for AWS virtual-host buckets
# STORAGE_S3_TIMEOUT_MS=10000
# UPLOAD_URL_TTL=300
STRIPE_PROVIDER=mock
VIRUS_SCANNER=mock

# Where the panel is served. Its origin + /auth/callback becomes every workspace's
# OAuth redirect (tm 255.17): must be https (http is accepted on localhost only).
WEB_APP_URL=https://panel.<your-domain>
# MAIL_DIR=.data/mail
# PUSH_DIR=.data/push
# SIEM_DIR=.data/siem
# SIEM_PROVIDER=file
# SIEM_EXPORT_HORIZON_MS=10000

# RETENTION_THREAD_DAYS=365                # closed conversations
# RETENTION_VISIT_DAYS=90                  # visitor telemetry
# RETENTION_MAIL_DAYS=30                   # spooled outgoing mail
# RETENTION_AUDIT_DAYS=30                  # basic audit log (NFR-S12)

# OTEL_ENABLED=true                        # unset already means "on" in production; set false to opt out
# console | otlp | none. `none` until a collector exists (M-OTEL-a) — and the
# pilot has none. Left at the `console` default, the tm 255.15 rehearsal's api
# wrote 566 log lines in five minutes, 33 of them its own log records: every
# span is printed as a multi-line dump, and the base log the pilot relies on
# drowns in it. `none` keeps the instrumentation (spans still carry request_id)
# and exports nothing.
OTEL_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # only read when OTEL_EXPORTER=otlp

# --- Background jobs (M-SCHED) — see README "Background jobs" for what each does ---
# SCHEDULER_ENABLED=true                   # unset already means "on" in production
# SCHEDULE_JITTER_PCT=10
# SCHEDULE_CHAT_TIMEOUT_MS=60000
# SCHEDULE_SLA_MS=60000
# SCHEDULE_SIEM_MS=300000
# SCHEDULE_SCHEDULED_REPORTS_MS=60000
# SCHEDULE_RETENTION_MS=3600000
# SCHEDULE_WEBHOOK_REDELIVERY_MS=60000
# WEBHOOK_MAX_ATTEMPTS=8
# RETENTION_ENABLED=false                  # stays off even with the scheduler on — review RETENTION_*_DAYS above first, this sweep hard-deletes
