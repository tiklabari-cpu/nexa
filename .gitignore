# --- Secrets / env (ASLA commit'lenmez) ---
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secrets/

# --- Bağımlılıklar / çıktı ---
node_modules/
# Depo pnpm-only (package.json packageManager: pnpm@11.15.1 · pnpm-lock.yaml tek kilit dosyası).
# Yanlışlıkla koşulan bir `npm install` package-lock.json bırakıp çalışma alanını kirletiyor ve
# sağlık taramasında yeni bir bulgu olarak geri geliyor — hiçbir dalda izlenmedi, izlenmeyecek.
package-lock.json
yarn.lock
dist/
build/
.next/
coverage/
*.tsbuildinfo

# --- Expo / Metro cache (apps/mobile) ---
# `expo export` ve `expo start` proje köküne .expo/ yazar: cihaz eşleşmeleri, paket
# hash'leri ve makineye özgü yollar. dist/ zaten yukarıda; bu onun kardeşi.
.expo/

# --- Turborepo / araç cache ---
.turbo/
.cache/
.eslintcache

# --- Otonom döngü logları ---
.loop-logs/

# --- Task Master (görev ağacı git'te KALIR; sadece yerel/gizli kısımlar hariç) ---
.taskmaster/**/*.log
.taskmaster/reports/
.taskmaster/config.local.json
# Pencerelerin görev ağacını incelerken yazdığı tek seferlik analiz script'leri/dökümleri.
# `package-lock.json` ile aynı gerekçe: kimse silmediği için çalışma alanı kirli kalıyor ve
# sağlık taraması her turda bunu yeni bir bulgu olarak geri getiriyordu.
.taskmaster/tmp-*

# --- Test / e2e artefaktları ---
playwright-report/
test-results/
# Playwright MCP'nin sayfa dökümleri (`.playwright-mcp/page-*.yml`) — pencere başına üretilir,
# kimse silmediği için depoda birikiyordu (tm 132.4 · 14 dosya temizlendi).
.playwright-mcp/

# --- OS / editör ---
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# --- Yerel çalışma verisi (dev runtime: mock mail + uploads) ---
.data/

# --- Yedekler (scripts/backup.sh çıktısı — asla commit'lenmez) ---
backups/
