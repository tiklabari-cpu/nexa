{
  "name": "@siyahtus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "tsx scripts/run-sharded.ts vitest run --passWithNoTests",
    "test:unit": "tsx scripts/with-test-datastores.ts vitest run --passWithNoTests --dir src",
    "test:integration": "tsx scripts/run-sharded.ts vitest run --passWithNoTests --dir test/integration",
    "mock-idp": "tsx scripts/mock-idp-server.ts",
    "mock-smtp": "tsx scripts/mock-smtp-server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:check-drift": "tsx scripts/check-drift.ts",
    "seed:fps-bench": "tsx scripts/seed-fps-workspace.ts",
    "measure:concurrent-migrate": "tsx scripts/measure-concurrent-migrate.ts",
    "measure:knowledge-recall": "tsx scripts/measure-knowledge-recall.ts",
    "measure:knowledge-retrieval": "tsx scripts/measure-knowledge-retrieval.ts",
    "measure:transcript-page": "tsx scripts/measure-transcript-page.ts",
    "retention:run": "tsx src/services/retention/run.ts",
    "chat-timeout:run": "tsx src/services/chat/chat-timeout-run.ts",
    "scheduled-reports:run": "tsx src/services/reports/scheduled-reports-run.ts",
    "siem:run": "tsx src/services/audit/siem-run.ts",
    "sla:run": "tsx src/services/sla/sla-run.ts",
    "knowledge-refresh:run": "tsx src/services/ai/knowledge-refresh-run.ts",
    "knowledge:reembed": "tsx src/services/ai/knowledge-reembed-run.ts",
    "invoice-close:run": "tsx src/services/billing/invoice-close-run.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/proxy-addr": "^5.1.1",
    "@fastify/sensible": "^6.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.1.0",
    "@siyahtus/ai-mock": "workspace:*",
    "@siyahtus/contract": "workspace:*",
    "@siyahtus/types": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "prisma": "^6.1.0",
    "xml-crypto": "^6.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
