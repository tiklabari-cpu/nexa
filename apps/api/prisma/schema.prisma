// Nexa data model.
//
// Source of truth: PRD §8.4 + rapor-2 §5.3. The legacy
// `LiveChat_ER_Diyagram.mermaid` contradicts both and is NOT used.
//
// Models arrive with the slice that needs them:
//   slice 2 — tenancy & auth
//   slice 3 — the conversation core, configuration, AI, billing and audit tables
//
// Every tenant-scoped table carries `license_id` (and `organization_id` where
// the resource outlives a license). Row level security is defined in the SQL
// migrations, not here — Prisma has no schema syntax for policies, and the
// policies are the load-bearing part of tenant isolation.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // plpgsql is a Postgres built-in and always present; declaring it keeps
  // `prisma migrate diff` clean so a real drift is never lost in the noise.
  extensions = [pgcrypto, citext, vector, plpgsql(schema: "pg_catalog")]
}

/// Tenant root.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Where this workspace's data lives: `eu` or `us` (ADR-12, widened by C4-a).
  /// Chosen at signup and immutable afterwards — the CHECK constraint and the
  /// `organizations_region_immutable` trigger enforce both halves, neither of
  /// which Prisma models, so this comment is the only place the schema says so.
  region    String   @default("eu")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  licenses     License[]
  oauthClients OauthClient[]

  @@map("organizations")
}

/// Billing and membership boundary. One organization may hold several.
///
/// PRD §8.4 gives licenses a bigint id rather than a uuid. The backing sequence
/// is created in the RLS migration and starts at 1000001, so ids never resemble
/// row counts or test fixtures.
model License {
  id                    BigInt    @id @default(autoincrement())
  organizationId        String    @map("organization_id") @db.Uuid
  plan                  String    @default("growth")
  billingCycle          String    @default("monthly") @map("billing_cycle")
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  status                String    @default("trialing")
  /// First-run setup (FR-MOD-00.4): null until the new owner finishes or skips
  /// the wizard. A per-license fact — the workspace is set up — so the wizard
  /// gates once for the whole workspace.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  /// When the owner accepted the HIPAA Business Associate Agreement (NFR-C4 ·
  /// C4-d), or null if never. Only a workspace hosted in `us` may hold a value
  /// here — HIPAA cover is conditional on US hosting, and the
  /// `licenses_baa_requires_us_region` trigger enforces that across tables,
  /// which Prisma cannot model, so this comment is where the schema says so.
  hipaaBaaSignedAt      DateTime? @map("hipaa_baa_signed_at") @db.Timestamptz(6)
  /// When the onboarding sample data was laid down, so the seed never runs twice.
  demoSeededAt          DateTime? @map("demo_seeded_at") @db.Timestamptz(6)
  /// The production licence this one is a sandbox of (FR-MOD-11.5 · 11.5-f), or
  /// null on a real workspace. A sandbox is a *second tenant*: its own
  /// organization, its own RLS scope, its own everything — this column is the
  /// only thread back, and it exists so the meter, the invoice and the seat
  /// count can all ask one question. Unique, so a licence has at most one
  /// sandbox; nesting is refused by `licenses_sandbox_not_nested`, which Prisma
  /// cannot model, so this comment is where the schema says so.
  sandboxOfLicenseId    BigInt?   @unique @map("sandbox_of_license_id")
  /// When this sandbox was last wiped, or null if never. Kept on the row rather
  /// than in the audit trail because a reset destroys the sandbox's own trail,
  /// and writing into the *parent's* would be the one cross-licence write this
  /// slice exists to make impossible. Only a sandbox may carry a value —
  /// `licenses_sandbox_reset_requires_sandbox` enforces that.
  sandboxResetAt        DateTime? @map("sandbox_reset_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sandboxOf              License?                @relation("LicenseSandbox", fields: [sandboxOfLicenseId], references: [id], onDelete: Cascade)
  sandbox                License?                @relation("LicenseSandbox")
  memberships            AgentMembership[]
  apiTokens              ApiToken[]
  refreshTokens          OauthRefreshToken[]
  groups                 Group[]
  expertise              Expertise[]
  chats                  Chat[]
  tags                   Tag[]
  tickets                Ticket[]
  cannedResponses        CannedResponse[]
  campaigns              Campaign[]
  campaignSends          CampaignSend[]
  goals                  Goal[]
  aiAgents               AiAgent[]
  skills                 Skill[]
  workflows              Workflow[]
  routingRules           RoutingRule[]
  ticketRules            TicketRule[]
  ticketEmailTemplates   TicketEmailTemplate[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  channels               Channel[]
  channelIdentities      ChannelIdentity[]
  channelMessages        ChannelMessage[]
  websites               Website[]
  brands                 Brand[]
  webhooks               Webhook[]
  webhookDeliveries      WebhookDelivery[]
  subscriptions          Subscription[]
  usageRecords           UsageRecord[]
  apiPackagePurchases    ApiPackagePurchase[]
  paymentMethod          PaymentMethod?
  auditEntries           AuditLogEntry[]
  auditChainHead         AuditChainHead?
  siemExportCursors      SiemExportCursor[]
  ipAllowlistEntries     IpAllowlistEntry[]
  ssoConnections         SsoConnection[]
  securitySettings       SecuritySettings[]
  inboxSettings          InboxSettings[]
  widgetSettings         WidgetSettings[]
  appInstallations       AppInstallation[]
  kbCategories           KbCategory[]
  kbArticles             KbArticle[]
  kbSettings             KbSettings?
  workSchedules          WorkSchedule[]
  presenceEvents         AgentPresenceEvent[]
  scheduledReports       ScheduledReport[]
  scheduledReportRuns    ScheduledReportRun[]
  chatSupervisions       ChatSupervision[]
  goalAchievements       GoalAchievement[]
  salesTrackerSettings   SalesTrackerSettings?
  trackedSales           TrackedSale[]
  slaPolicy              SlaPolicy?
  slaBreaches            SlaBreach[]

  invitations Invitation[]

  @@index([organizationId])
  @@map("licenses")
}

/// A person. One account can be a member of many licenses.
model Account {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  name         String
  avatarUrl    String?   @map("avatar_url")
  /// scrypt (RFC 7914). Null for accounts that only sign in via SSO.
  passwordHash String?   @map("password_hash")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships        AgentMembership[]
  authorizationCodes OauthAuthorizationCode[]
  refreshTokens      OauthRefreshToken[]
  groupMemberships   GroupAgent[]
  expertise          AgentExpertise[]
  passwordResets     PasswordResetToken[]
  invitationsSent    Invitation[]
  ticketFollows      TicketFollower[]
  workSchedules      WorkSchedule[]
  presenceEvents     AgentPresenceEvent[]
  supervisions       ChatSupervision[]

  @@map("accounts")
}

/// Membership carries the role, availability and routing capacity of an agent
/// within one license. PRD §8.4.
model AgentMembership {
  licenseId            BigInt    @map("license_id")
  agentId              String    @map("agent_id") @db.Uuid
  role                 String
  routingStatus        String    @default("offline") @map("routing_status")
  concurrentChatsLimit Int       @default(6) @map("concurrent_chats_limit")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  /// Per-user, per-license opt-out for the e-mail notification channel (FR-MOD-13.8).
  notifyEmail          Boolean   @default(true) @map("notify_email")
  /// Master switch over the *interruptive* channels below — sound, desktop,
  /// push. Not over `notifyEmail`: e-mail is the fallback for somebody who is
  /// not at a screen, and "stop alerting me now" was never a request to stop
  /// that too (`@nexa/types` · `pushAllowed`).
  notifyEnabled        Boolean   @default(true) @map("notify_enabled")
  notifySound          Boolean   @default(true) @map("notify_sound")
  notifyDesktop        Boolean   @default(true) @map("notify_desktop")
  /// Push to this member's registered handsets (FR-MOD-13.7 · read by 13.7-d).
  /// The three above governed a browser and lived in `localStorage` until
  /// 13.7-c; push is chosen by the *server*, so a preference it cannot read is
  /// a preference that does not apply to the one channel reaching a closed
  /// laptop. That is what moved all four onto the membership.
  notifyPush           Boolean   @default(true) @map("notify_push")
  awaitingApproval     Boolean   @default(false) @map("awaiting_approval")
  suspended            Boolean   @default(false) @map("suspended")
  /// Tie-breaker for round-robin assignment (ADR-08 step 4).
  lastAssignedAt       DateTime? @map("last_assigned_at") @db.Timestamptz(6)
  /// The identity provider's own id for this member, when the membership is
  /// managed over SCIM (NFR-S11 · S11-e). On the membership rather than the
  /// account because it is *one* workspace's directory speaking: the same
  /// person may work for another workspace whose IdP calls them something else.
  scimExternalId       String?   @map("scim_external_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license      License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent        Account       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceTokens DeviceToken[]

  @@id([licenseId, agentId])
  /// At most one member per external id. NULLs are distinct in Postgres, so
  /// members who never came from a directory are unaffected.
  @@unique([licenseId, scimExternalId])
  @@index([agentId])
  @@map("agent_memberships")
}

/// Registered OAuth 2.1 application.
model OauthClient {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name")
  /// Null for public clients — OAuth 2.1 requires PKCE instead of a secret.
  secretHash     String?  @map("secret_hash")
  redirectUris   String[] @map("redirect_uris")
  clientType     String   @default("public") @map("client_type")
  scopes         String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorizationCodes OauthAuthorizationCode[]
  refreshTokens      OauthRefreshToken[]

  @@index([organizationId])
  @@map("oauth_clients")
}

/// Single-use authorization code. Stored hashed: a leaked database backup must
/// not hand an attacker live codes.
model OauthAuthorizationCode {
  codeHash            String    @id @map("code_hash")
  clientId            String    @map("client_id")
  accountId           String    @map("account_id") @db.Uuid
  licenseId           BigInt    @map("license_id")
  organizationId      String    @map("organization_id") @db.Uuid
  redirectUri         String    @map("redirect_uri")
  scopes              String[]
  /// PKCE — S256 only. OAuth 2.1 forbids `plain`.
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client  OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

/// Refresh token with rotation lineage.
///
/// `replacedById` records which token superseded this one. Reuse of an already
/// rotated token is the classic signal of a stolen refresh token, so detecting
/// it lets us revoke the whole family rather than just refusing one request.
model OauthRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  clientId       String    @map("client_id")
  accountId      String    @map("account_id") @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  scopes         String[]
  /// All tokens rotated from one original login share a family id.
  familyId       String    @map("family_id") @db.Uuid
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client  OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  license License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([accountId])
  @@map("oauth_refresh_tokens")
}

/// End users who talk to the workspace. Scoped to the organization rather than
/// a license, because a person is the same person across licenses (PRD §8.4).
///
/// Pulled into slice 2 (from slice 3) because `/customer/token` cannot be
/// implemented — or tested — without it.
model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String?
  email          String?   @db.Citext
  phone          String?
  countryCode    String?   @map("country_code") @db.Char(2)
  country        String?
  isLead         Boolean   @default(false) @map("is_lead")
  chatsCount     Int       @default(0) @map("chats_count")
  ticketsCount   Int       @default(0) @map("tickets_count")
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)
  bannedAt       DateTime? @map("banned_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  chats             Chat[]
  tickets           Ticket[]
  visits            Visit[]
  channelIdentities ChannelIdentity[]
  campaignSends     CampaignSend[]
  customFieldValues CustomFieldValue[]
  goalAchievements  GoalAchievement[]
  trackedSales      TrackedSale[]

  @@index([organizationId, lastActivityAt(sort: Desc)])
  @@index([organizationId, email])
  @@map("customers")
}

/// Origins allowed to embed the widget and mint customer tokens (NFR-S6).
///
/// Ships with the endpoint it protects rather than being added later: an
/// allowlist retrofitted after integrators depend on the open behaviour is a
/// breaking change nobody wants to make.
model TrustedDomain {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  licenseId         BigInt   @map("license_id")
  /// Hostname only, lowercase, no scheme or port, e.g. `shop.example.com`.
  domain            String
  /// Also allow `*.domain`. Never permits a bare public suffix.
  includeSubdomains Boolean  @default(false) @map("include_subdomains")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, domain])
  @@index([licenseId])
  @@map("trusted_domains")
}

/// IP addresses and CIDR ranges permitted to reach the agent/admin panel
/// (FR-MOD-08.9.6). The allow-side counterpart to `SecuritySettings`
/// `banned_customer_ips` (a deny-list on the customer/widget surface,
/// FR-MOD-08.9.2): here a license lists the sources it trusts for its own staff.
///
/// An entry is a single IPv4/IPv6 address or a CIDR range in canonical form; a
/// record is unique per (license, entry). CIDR/IP matching (08.9.6-c) and
/// enforcement (08.9.6-e) live elsewhere — this model is only the storage, closed
/// to its tenant by the RLS policy in the migration.
model IpAllowlistEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  licenseId      BigInt   @map("license_id")
  /// A single IPv4/IPv6 address or a CIDR range, canonical form.
  entry          String
  /// Optional human label, e.g. `Office VPN`.
  label          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, entry])
  @@index([licenseId])
  @@map("ip_allowlist_entries")
}

/// A SAML 2.0 identity provider a license federates sign-in to (NFR-S11).
///
/// Storage only at this stage: nothing reads this to authenticate anyone. The
/// write surface is S11-a2, assertion validation S11-b, the SP endpoints S11-d.
/// Closed to its tenant by the RLS policy in the migration.
///
/// `idpCertificatePem` is the IdP's *public* signing certificate, so it is
/// stored as it arrives — not hashed, not encrypted. Hashing it would make the
/// one operation this feature actually performs on it (verifying an assertion
/// signature) impossible, and there is nothing to protect: the same bytes are
/// published in the IdP's own metadata. The secret in this feature is the SCIM
/// bearer token (S11-e), which is hashed.
model SsoConnection {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         BigInt   @map("license_id")
  /// Human label for the connection, e.g. `Okta (corp)`.
  name              String
  /// The IdP's SAML EntityID — what an assertion's `Issuer` must equal.
  idpEntityId       String   @map("idp_entity_id")
  /// Absolute `http(s)` URL an AuthnRequest is sent to (HTTP-Redirect binding).
  idpSsoUrl         String   @map("idp_sso_url")
  /// PEM-encoded X.509 signing certificate published by the IdP.
  idpCertificatePem String   @map("idp_certificate_pem")
  /// The certificate this connection was rotated away from, kept trusted until
  /// `previousCertificateExpiresAt` so an IdP key roll does not black out
  /// sign-in while the IdP is still signing with the old key. Null unless the
  /// rotation asked for an overlap — replacing a certificate revokes the old one
  /// at commit by default, because the rotation that matters most is the one
  /// answering a compromise. Read through `activePreviousCertificate`, never
  /// directly: a lapsed overlap must read as no overlap.
  previousCertificatePem       String?   @map("previous_certificate_pem")
  previousCertificateExpiresAt DateTime? @map("previous_certificate_expires_at") @db.Timestamptz(6)
  /// Which assertion attribute fills which account field; see
  /// `SSO_ATTRIBUTE_MAPPING_KEYS`. `{}` means the connection said nothing.
  attributeMapping  Json     @default("{}") @map("attribute_mapping")
  /// Accept an assertion sent with no AuthnRequest of ours to correlate it
  /// against. Off by default — that flow gives up the `InResponseTo` binding
  /// replay detection rests on, so it is chosen, never inherited.
  allowIdpInitiated Boolean  @default(false) @map("allow_idp_initiated")
  /// Whether sign-in through this connection is live. Off until configured, so
  /// a half-written row can never become a way in.
  enabled           Boolean  @default(false) @map("enabled")
  /// Make this connection the *only* way in: password sign-in is refused for
  /// the license while this is set and `enabled` is too (NFR-S11 · S11-h). Read
  /// as the pair, never alone — a disabled connection enforces nothing, which is
  /// how a workspace recovers when its IdP stops answering. The owner keeps a
  /// password door either way (§C-A17.7), and it cannot be switched on unless
  /// somebody still holds a key to it.
  enforced          Boolean  @default(false) @map("enforced")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// One connection per IdP within a license. Two rows for one EntityID would
  /// make "which connection issued this assertion?" ambiguous exactly where the
  /// answer decides whose certificate verifies it. Its index also serves every
  /// read this table has — "the connections of this license" — so there is no
  /// separate `@@index([licenseId])`.
  @@unique([licenseId, idpEntityId])
  @@map("sso_connections")
}

/// Bearer credentials: OAuth access tokens, personal access tokens and bot
/// tokens. Only the hash is stored — the plaintext is shown once, at creation.
model ApiToken {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  /// Account uuid for pat/oauth; bot id for bot tokens.
  ownerId        String    @map("owner_id")
  kind           String
  tokenHash      String    @unique @map("token_hash")
  /// Human label, for the PAT management screen.
  name           String?
  scopes         String[]  @default([])
  clientId       String?   @map("client_id")
  /// Ties an access token to the refresh family that minted it, so revoking a
  /// family also kills its access tokens.
  familyId       String?   @map("family_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, kind])
  @@index([ownerId])
  @@index([familyId])
  @@map("api_tokens")
}

/// A handset that has asked to receive this member's push notifications
/// (FR-MOD-13.7 · 13.7-c). Registration and revocation are 13.7-c; sending is
/// 13.7-d.
///
/// **`token` is stored in plain text, and it is the one credential here that
/// cannot be hashed.** `ApiToken` above hashes because the only operation ever
/// performed on it is *comparison* — a caller presents a token and the server
/// asks "is this the one?". A push token is the opposite: nobody presents it,
/// the server has to hand the literal bytes to APNs/FCM to address a device, so
/// a digest would make the column useless for its only purpose. The decision is
/// recorded as an assumption in PLAN §C; what it buys instead of hashing is
/// four narrower guarantees, each enforced somewhere a careless caller cannot
/// undo it:
///
///   1. The column is never in a response — reads return id, platform and last
///      seen, and nothing else (`routes/notifications.ts`).
///   2. It is never in an audit entry — the writers here pass an id and a
///      platform, and `sanitizeAuditMetadata` would strip a `token` key anyway.
///   3. It is never in a log line — `req.body.token` is on the server's pino
///      redaction list, which is why the request field is named `token`.
///   4. RLS is as tight as `api_tokens`', and the row is reachable only through
///      the membership it belongs to (below).
///
/// The foreign key is composite — `(license_id, account_id)` into
/// `agent_memberships` — rather than a plain account reference, and that is a
/// tenant guard, not tidiness. A device belongs to a *person in a workspace*: if
/// the row pointed at an account alone, a membership that was removed would
/// leave a live delivery target for a workspace the person no longer works for,
/// and the cascade is what makes "took them off the team" also mean "their
/// phone stops buzzing".
model DeviceToken {
  id         String    @id @default(uuid()) @db.Uuid
  licenseId  BigInt    @map("license_id")
  accountId  String    @map("account_id") @db.Uuid
  /// 'ios' | 'android' — constrained in the database (see the migration).
  platform   String
  /// The APNs/FCM delivery address for this handset. Never returned, logged or
  /// audited. See the note above for why it is not hashed.
  token      String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Refreshed every time the app re-registers, so a workspace can tell a live
  /// handset from one reinstalled onto somebody else's phone a year ago.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Set rather than deleted, so a revoked device is still evidence that the
  /// delivery target existed — the same reason `api_tokens` keeps a revoked row.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership AgentMembership @relation(fields: [licenseId, accountId], references: [licenseId, agentId], onDelete: Cascade)

  /// One row per (workspace, token): re-registering the same handset updates the
  /// row instead of adding a second one, which is what stops a device that
  /// launches daily from accumulating a year of duplicates and being sent the
  /// same message once per launch. Scoped to the license rather than global on
  /// purpose — a global unique index would answer "is this token registered
  /// somewhere else?" to a caller who is not allowed to know that.
  @@unique([licenseId, token])
  /// The sender's only question: which live devices does this member have?
  @@index([licenseId, accountId, revokedAt])
  @@map("device_tokens")
}

// ===========================================================================
// Teams
// ===========================================================================

/// Departments / chatting teams. PRD §8.4 gives groups a per-license integer id
/// rather than a uuid, so the primary key is composite.
model Group {
  id           BigInt   @default(autoincrement())
  licenseId    BigInt   @map("license_id")
  name         String
  languageCode String   @default("en") @map("language_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agents  GroupAgent[]

  @@id([licenseId, id])
  @@map("groups")
}

/// Membership of an agent in a team, with the routing preference that decides
/// who gets offered a chat first (ADR-08 step 2).
model GroupAgent {
  licenseId BigInt @map("license_id")
  groupId   BigInt @map("group_id")
  agentId   String @map("agent_id") @db.Uuid
  priority  String @default("normal")

  group Group   @relation(fields: [licenseId, groupId], references: [licenseId, id], onDelete: Cascade)
  agent Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, groupId, agentId])
  @@index([agentId])
  @@map("group_agents")
}

// ===========================================================================
// Agent expertise (skill-based routing — FR-MOD-08.6.3)
// ===========================================================================

/// An area of expertise an agent can carry, the catalogue "expertise/skill
/// based" routing draws on (08.6.3-c). Named `expertise` at the data layer
/// because `skills` is already the AI-automation Skill (ADR-14, a wholly
/// different concept). License-scoped with a Group-style composite key, so an
/// id is a small per-license integer the routing UI can show, and a slug is
/// unique within a license.
model Expertise {
  id        BigInt   @default(autoincrement())
  licenseId BigInt   @map("license_id")
  name      String
  slug      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agents  AgentExpertise[]

  @@id([licenseId, id])
  @@unique([licenseId, slug])
  @@map("expertise")
}

/// The tie between an agent and an area of expertise — the row routing reads to
/// decide who is qualified for a chat. Composite key mirrors group_agents; the
/// license flows in through the expertise relation, and the agent index serves
/// the "what is this agent good at" lookup.
model AgentExpertise {
  licenseId   BigInt @map("license_id")
  agentId     String @map("agent_id") @db.Uuid
  expertiseId BigInt @map("expertise_id")

  expertise Expertise @relation(fields: [licenseId, expertiseId], references: [licenseId, id], onDelete: Cascade)
  agent     Account   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, agentId, expertiseId])
  @@index([agentId])
  @@map("agent_expertise")
}

// ===========================================================================
// Conversation core: chat → thread → event
// ===========================================================================

/// A continuing relationship with one customer. Threads come and go inside it;
/// the chat itself persists, which is what makes "resume" meaningful.
///
/// A partial unique index (in the migration) enforces at most one *active* chat
/// per license+customer — the invariant the whole inbox model rests on.
model Chat {
  id         String   @id @db.VarChar(12)
  licenseId  BigInt   @map("license_id")
  customerId String   @map("customer_id") @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license          License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  threads          Thread[]
  users            ChatUser[]
  access           ChatAccess[]
  supervisions     ChatSupervision[]
  ratings          Rating[]
  tickets          Ticket[]
  skillRuns        SkillRun[]
  goalAchievements GoalAchievement[]
  trackedSales     TrackedSale[]

  @@index([licenseId, createdAt(sort: Desc)])
  @@index([customerId])
  @@map("chats")
}

/// One continuous exchange within a chat. Closing a thread archives it; the
/// customer coming back opens a new thread on the same chat.
model Thread {
  id               String    @id @db.VarChar(12)
  chatId           String    @map("chat_id") @db.VarChar(12)
  licenseId        BigInt    @map("license_id")
  active           Boolean   @default(true)
  /// Null once assigned; set while waiting in the routing queue.
  queuePosition    Int?      @map("queue_position")
  queuedAt         DateTime? @map("queued_at") @db.Timestamptz(6)
  /// Agent currently responsible. Null means unassigned or queued.
  assigneeId       String?   @map("assignee_id") @db.Uuid
  summary          String?
  summaryUpdatedAt DateTime? @map("summary_updated_at") @db.Timestamptz(6)
  /// Monotonic per-thread event counter. Event ids are derived from it, which
  /// is what makes "everything after event N" answerable without timestamps.
  eventSequence    Int       @default(0) @map("event_sequence")
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)

  chat   Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tags   ThreadTag[]
  events Event[]

  @@index([chatId, createdAt])
  @@index([licenseId, active, createdAt(sort: Desc)])
  @@index([assigneeId])
  @@map("threads")
}

/// Everything that ever happened in a thread.
///
/// Range-partitioned by month in the migration — this is by far the largest
/// table, and partitioning is what keeps list queries, vacuum cost and archival
/// bounded as it grows. Prisma has no syntax for partitioning, so the CREATE
/// TABLE is hand-written; queries are unaffected.
model Event {
  id            String   @db.VarChar(40)
  threadId      String   @map("thread_id") @db.VarChar(12)
  /// Denormalised from the thread so transcript queries need no join.
  chatId        String   @map("chat_id") @db.VarChar(12)
  licenseId     BigInt   @map("license_id")
  type          String
  text          String?
  authorId      String?  @map("author_id")
  authorType    String   @map("author_type")
  /// `all` reaches the customer; `agents` is an internal note.
  recipients    String   @default("all")
  attachmentUrl String?  @map("attachment_url")
  properties    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([threadId, createdAt])
  @@index([chatId, createdAt])
  @@index([licenseId, createdAt])
  /// Reports filter on event properties; GIN turns that from a scan into a lookup.
  @@index([properties(ops: JsonbPathOps)], type: Gin, map: "idx_events_properties")
  @@map("events")
}

/// Who is in a chat, and how much of it they have seen.
model ChatUser {
  chatId   String    @map("chat_id") @db.VarChar(12)
  userId   String    @map("user_id")
  userType String    @map("user_type")
  present  Boolean   @default(true)
  seenUpTo DateTime? @map("seen_up_to") @db.Timestamptz(6)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_users")
}

/// Which teams may see a chat. This is the access control list the inbox
/// filters on — an agent sees a chat only through a group they belong to.
model ChatAccess {
  chatId  String @map("chat_id") @db.VarChar(12)
  groupId BigInt @map("group_id")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, groupId])
  @@index([groupId])
  @@map("chat_access")
}

/// Which agent is watching a chat right now (FR-MOD-13.2 "Supervise").
///
/// Supervising is not assignment: the supervisor reads the conversation without
/// taking it over, so nothing in `threads` records it. Without this table the
/// Traffic board has no source at all for its `supervised` state — the button
/// today only navigates to the inbox and writes nowhere.
///
/// One row per (chat, agent): two supervisors on the same chat are two rows,
/// and the same agent re-opening the same chat updates a row instead of
/// duplicating it. `last_seen_at` is the heartbeat 13.2-d refreshes while the
/// panel is open — a row that has gone stale is a closed tab, not a watcher, so
/// the read side filters on it rather than trusting the row's existence.
///
/// Stored in Postgres rather than Redis presence on purpose (§C): the tenant
/// boundary then rests on an RLS policy the database enforces, and the row is
/// deterministic evidence the DoD gate can assert on.
model ChatSupervision {
  chatId     String   @map("chat_id") @db.VarChar(12)
  agentId    String   @map("agent_id") @db.Uuid
  licenseId  BigInt   @map("license_id")
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([chatId, agentId])
  @@index([licenseId, lastSeenAt(sort: Desc)])
  @@map("chat_supervisions")
}

/// Tags applied to a thread, not a chat: what a conversation was *about* can
/// change between one visit and the next.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  authorId  String?  @map("author_id")
  groupIds  BigInt[] @default([]) @map("group_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  threads ThreadTag[]
  tickets TicketTag[]

  @@unique([licenseId, name])
  @@map("tags")
}

/// A tag applied to a ticket (FR-MOD-08.6.2). Like `thread_tags` it has no
/// license column of its own — it inherits tenant visibility from the ticket it
/// hangs off, and RLS scopes it through that foreign key. Reuses the same `Tag`
/// library the inbox and thread tagging draw on.
model TicketTag {
  ticketId String   @map("ticket_id") @db.VarChar(12)
  tagId    String   @map("tag_id") @db.Uuid
  taggedAt DateTime @default(now()) @map("tagged_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

/// Ticket automation (FR-MOD-08.6.2): a condition plus an action. When a ticket
/// is opened, every enabled rule whose condition matches applies its action —
/// auto-assign, set priority, or tag. Both a condition and an action are
/// required (KK "koşul+eylem zorunlu"); the shapes live in the JSON columns so a
/// new condition or action kind needs no migration. Rules run in `position`
/// order, so a later rule's assignment wins over an earlier one's.
model TicketRule {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  name       String
  conditions Json     @default("{}")
  actions    Json     @default("{}")
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, enabled, position])
  @@map("ticket_rules")
}

/// Branded, variabled ticket e-mail template (FR-MOD-08.7.5): reusable subject +
/// body a workspace authors once, carrying `{{ group.field }}` placeholders
/// filled in per ticket at send time. Both halves are validated against the
/// fixed variable catalogue on every save, so a template can never be stored
/// naming a variable the product cannot fill (KK "Geçersiz değişken/format
/// engeli"). License-scoped like ticket rules; RLS narrows every row to its
/// workspace.
model TicketEmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
  @@map("ticket_email_templates")
}

/// A custom field a workspace has defined on tickets or contacts (FR-MOD-08.7.6):
/// an extra field the product does not ship with — a player id, a KYC status, an
/// account balance. Two properties carry the requirement (KK "Tip/zorunluluk"):
/// `type` decides how a value is validated, `required` whether it may be blank.
/// License-scoped like ticket rules; RLS narrows every row to its workspace. A
/// label is unique per (license, entity) so a field cannot be defined twice.
model CustomFieldDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  /// 'ticket' or 'contact'.
  entity        String
  label         String
  /// 'text' | 'number' | 'boolean' | 'date'.
  type          String
  required      Boolean  @default(false)
  /// 'pre_chat' or 'post_chat' when this contact field is also asked on one of
  /// the widget's forms (FR-MOD-08.7.7) — before the conversation starts, or once
  /// it ends — or null for a CRM-only field. A CHECK in the migration keeps a
  /// placement to `entity = 'contact'` and to those two values.
  formPlacement String?  @map("form_placement")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([licenseId, entity, label])
  @@map("custom_field_definitions")
}

/// A value stored for one custom field on one ticket or one contact
/// (FR-MOD-08.7.6). Exactly one of `ticketId` / `customerId` is set — a CHECK in
/// the migration enforces that — and it points at the entity the definition is
/// for. The value is kept as text in its canonical form (see checkCustomFieldValue
/// in @nexa/types); one value per field per entity. Deleting the definition, the
/// ticket or the contact cascades the value away.
model CustomFieldValue {
  id           String   @id @default(uuid()) @db.Uuid
  licenseId    BigInt   @map("license_id")
  definitionId String   @map("definition_id") @db.Uuid
  ticketId     String?  @map("ticket_id") @db.VarChar(12)
  customerId   String?  @map("customer_id") @db.Uuid
  value        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license    License               @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  ticket     Ticket?               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer   Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([definitionId, ticketId])
  @@unique([definitionId, customerId])
  @@index([ticketId])
  @@index([customerId])
  @@map("custom_field_values")
}

model ThreadTag {
  threadId String   @map("thread_id") @db.VarChar(12)
  tagId    String   @map("tag_id") @db.Uuid
  taggedAt DateTime @default(now()) @map("tagged_at") @db.Timestamptz(6)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
  @@map("thread_tags")
}

/// Asynchronous conversations (email and the like), as opposed to live chats.
///
/// The HelpDesk layer (FR-MOD-13.6) adds three things on top of the ticket core:
///   - `priority` — an integer the queue can be worked by; higher is more urgent.
///   - `mergedIntoId` — a self reference. A merge is *non-destructive*: it only
///     points the secondary at its primary, so an unmerge is a clean inverse
///     (clear the pointer) rather than a reconstruction. A merged ticket is
///     folded under its primary and hidden from the lists.
///   - `followers` — agents watching a ticket without owning it.
model Ticket {
  id            String    @id @db.VarChar(12)
  licenseId     BigInt    @map("license_id")
  customerId    String?   @map("customer_id") @db.Uuid
  sourceChatId  String?   @map("source_chat_id") @db.VarChar(12)
  subject       String
  status        String    @default("open")
  /// Queue priority (FR-MOD-13.6). Higher is more urgent; 0 is the default. A
  /// signed integer rather than an enum so the ordering is the database's, not
  /// a lookup the query has to carry.
  priority      Int       @default(0)
  assigneeId    String?   @map("assignee_id") @db.Uuid
  groupId       BigInt?   @map("group_id")
  /// The primary this ticket was merged into, or null when it stands alone. The
  /// FK is `ON DELETE SET NULL`, and a CHECK in the migration forbids pointing at
  /// itself; "no chains" (a merged ticket cannot itself be a target) is enforced
  /// in the service.
  mergedIntoId  String?   @map("merged_into_id") @db.VarChar(12)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license           License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceChat        Chat?              @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)
  mergedInto        Ticket?            @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTickets     Ticket[]           @relation("TicketMerge")
  followers         TicketFollower[]
  tags              TicketTag[]
  customFieldValues CustomFieldValue[]

  @@index([licenseId, status, lastMessageAt(sort: Desc)])
  @@index([assigneeId])
  @@index([licenseId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "tickets_license_last_message_idx")
  @@index([licenseId, assigneeId, lastMessageAt(sort: Desc)], map: "tickets_license_assignee_idx")
  @@index([mergedIntoId])
  @@map("tickets")
}

/// Agents watching a ticket (FR-MOD-13.6 "followers"). Like `thread_tags` it has
/// no license column of its own — it inherits tenant visibility from the ticket
/// it hangs off, and the RLS policy in the migration scopes it through that FK.
model TicketFollower {
  ticketId  String   @map("ticket_id") @db.VarChar(12)
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([ticketId, accountId])
  @@index([accountId])
  @@map("ticket_followers")
}

/// Password recovery (PRD FR-MOD-00.3). Not in §8.4 — see PLAN §D12.
///
/// Only the hash is stored: a leaked backup of this table must not be a set of
/// working reset links.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("password_reset_tokens")
}

/// Team invitations (PRD FR-MOD-04.4). Not in §8.4 — see PLAN §D12.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  invitedBy Account @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt(sort: Desc)], map: "invitations_license_id_idx")
  @@map("invitations")
}

/// Customer satisfaction, recorded against the chat (PRD §8.4).
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.VarChar(12)
  licenseId BigInt   @map("license_id")
  threadId  String?  @map("thread_id") @db.VarChar(12)
  value     String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
  @@map("ratings")
}

// ===========================================================================
// Agent productivity
// ===========================================================================

/// Saved replies, inserted in the composer with `#shortcut`.
model CannedResponse {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  scope      String   @default("chat")
  shortcut   String
  text       String
  groupId    BigInt?  @map("group_id")
  visibility String   @default("all")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, scope, shortcut])
  @@index([licenseId, groupId])
  @@map("canned_responses")
}

// ===========================================================================
// Engage: campaigns, goals, visitor telemetry
// ===========================================================================

/// Proactive greetings and targeted messages.
model Campaign {
  id         String    @id @default(uuid()) @db.Uuid
  licenseId  BigInt    @map("license_id")
  name       String
  type       String    @default("targeted_message")
  status     String    @default("inactive")
  /// Trigger predicate: url, time on page, exit intent, geo, …
  conditions Json      @default("{}")
  content    Json      @default("{}")
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  recurring  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  sends   CampaignSend[]

  @@index([licenseId, status])
  @@map("campaigns")
}

/// One row per visitor a campaign has fired to (FR-MOD-03.3.2/.3).
///
/// The trigger engine writes one when a live visitor matches an active
/// campaign; the unique `(campaign_id, customer_id)` pair is what stops a
/// campaign firing twice at the same person. It is also the source of the card's
/// numbers (FR-MOD-03.3.3): rows are Displayed, `engaged` rows are Chats, and
/// `converted` rows are Conversions — counted, never stored on the campaign, so
/// the figures can never drift from the sends they summarise.
model CampaignSend {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  campaignId String   @map("campaign_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  /// The proactive conversation this send opened, once the visitor engages.
  chatId     String?  @map("chat_id") @db.VarChar(12)
  /// The visitor replied — this send counts as a Chat.
  engaged    Boolean  @default(false)
  /// The visitor reached a goal — this send counts as a Conversion.
  converted  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([licenseId, campaignId])
  @@map("campaign_sends")
}

/// A conversion worth counting — visitor reached a page, completed a purchase.
model Goal {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  name       String
  definition Json     @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license      License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  achievements GoalAchievement[]

  @@index([licenseId, active])
  @@map("goals")
}

/// One row per visitor who has reached a goal (FR-MOD-13.3) — the last stage of
/// the visitor → chat → conversion funnel.
///
/// `goals` holds only the *definition* of a conversion; until now nothing
/// recorded that one had happened, so "achieved goals in this window" was not a
/// question the database could answer. A timestamped row is what makes it
/// answerable — and comparable with the window before it.
///
/// `campaign_sends.converted` is not that record: it is a free boolean with no
/// `goal_id`, so it cannot say *which* goal was reached, and it exists only for
/// visitors a campaign happened to fire at.
model GoalAchievement {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  goalId     String   @map("goal_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  /// The conversation the visitor was in when the goal was reached, when there
  /// was one — the funnel's middle stage.
  chatId     String?  @map("chat_id") @db.VarChar(12)
  achievedAt DateTime @default(now()) @map("achieved_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chat     Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  /// The idempotency constraint. The matcher (13.3-d) re-evaluates a visitor on
  /// every page view; a person converts on a goal once, and the second hit must
  /// be a no-op rather than a second row inflating the funnel.
  @@unique([goalId, customerId])
  @@index([licenseId, achievedAt])
  @@map("goal_achievements")
}

/// Per-license sales tracker configuration (FR-MOD-13.5, "İzleme yapılandırması").
///
/// A per-license singleton shaped like `widget_settings` before Multibrand
/// touched it: `license_id` alone is the primary key. Unlike widget
/// appearance or inbox behaviour, nothing in FR-MOD-13.5 varies tracking by
/// brand — a conversion either counts for the workspace or it doesn't — so
/// this table was designed brand-agnostic from the start, the same way
/// `goals` (13.3) was. Nothing creates the row at signup; the settings
/// endpoint (13.5-b) upserts it on first save, and a read with no row falls
/// back to the schema defaults (tracking off).
model SalesTrackerSettings {
  licenseId             BigInt   @id @map("license_id")
  enabled               Boolean  @default(false)
  currency              String   @default("USD")
  attributionWindowDays Int      @default(7) @map("attribution_window_days")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("sales_tracker_settings")
}

/// One order reported by the widget snippet's `nexa('trackSale', …)` call
/// (FR-MOD-13.5) — `Rating`'s event-table shape: one row per occurrence, not
/// a running total. `attributed`, `chatId` and `customerId` stay at their
/// unset defaults until the ingest endpoint (13.5-c) matches the order to a
/// chat within the license's attribution window.
model TrackedSale {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  /// The chat the visitor was in when attributed, or null before attribution
  /// runs (or when none is found). `SET NULL` on delete, like
  /// `goal_achievements.chat_id`: a sale must outlive the chat's retention
  /// window, so purging the chat drops only the pointer.
  chatId          String?  @map("chat_id") @db.VarChar(12)
  customerId      String?  @map("customer_id") @db.Uuid
  externalOrderId String   @map("external_order_id")
  amountCents     Int      @map("amount_cents")
  currency        String
  attributed      Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat     Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// The ingest endpoint may see the same order more than once (an
  /// at-least-once retry from the merchant's own backend); a second row would
  /// double the sale in every downstream report.
  @@unique([licenseId, externalOrderId])
  @@index([licenseId, createdAt])
  @@map("tracked_sales")
}

/// Browsing telemetry behind the real-time visitor list.
model Visit {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  licenseId  BigInt    @map("license_id")
  cameFrom   String?   @map("came_from")
  pages      Json      @default("[]")
  /// Personal data (NFR-S9): subject to the retention policy, and never
  /// returned to the widget.
  ip         String?
  os         String?
  browser    String?
  userAgent  String?   @map("user_agent")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, startedAt(sort: Desc)])
  @@index([licenseId, startedAt(sort: Desc)])
  @@map("visits")
}

// ===========================================================================
// AI
// ===========================================================================

/// An AI agent (customer-facing) or Copilot (agent-facing).
model AiAgent {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  kind        String   @default("ai_agent")
  name        String
  persona     Json     @default("{}")
  tone        String?
  avatarUrl   String?  @map("avatar_url")
  languages   String[] @default([])
  instruction String?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license          License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  skills           Skill[]
  knowledgeSources KnowledgeSource[]

  @@index([licenseId, kind])
  @@map("ai_agents")
}

/// A named capability, expressed as an ordered list of steps compiled from a
/// natural-language instruction (ADR-14 — Skill is the single paradigm).
model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  aiAgentId   String?  @map("ai_agent_id") @db.Uuid
  name        String
  kind        String
  instruction String?
  /// Ordered: detect_intent, request_info, tag, summarize, send_message,
  /// transfer_to_team.
  steps       Json     @default("[]")
  trigger     Json     @default("{}")
  active      Boolean  @default(false)
  runsCount   Int      @default(0) @map("runs_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent AiAgent?   @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  runs    SkillRun[]

  @@index([licenseId, kind, active])
  @@map("skills")
}

/// Audit trail for skill executions — what ran, against which chat, and why it
/// did what it did.
model SkillRun {
  id        String   @id @default(uuid()) @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  chatId    String?  @map("chat_id") @db.VarChar(12)
  licenseId BigInt   @map("license_id")
  status    String   @default("succeeded")
  log       Json     @default("[]")
  ranAt     DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  chat  Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([skillId, ranAt(sort: Desc)])
  @@index([licenseId, ranAt(sort: Desc)])
  @@map("skill_runs")
}

/// Visual node/edge automation. The table exists so the schema matches PRD §8.4,
/// but ADR-14 defers the editor to v2 — nothing writes here yet.
model Workflow {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, status])
  @@map("workflows")
}

/// A document, page or FAQ the AI may draw on.
model KnowledgeSource {
  id        String   @id @default(uuid()) @db.Uuid
  aiAgentId String   @map("ai_agent_id") @db.Uuid
  licenseId BigInt   @map("license_id")
  type      String
  name      String
  sourceUrl String?  @map("source_url")
  content   String?
  status    String   @default("ready")
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent          @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  @@index([aiAgentId, type])
  @@index([licenseId])
  @@map("knowledge_sources")
}

/// Retrieval unit. The embedding column is pgvector; its ivfflat index is
/// created in the migration because Prisma cannot express index methods.
model KnowledgeChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  sourceId   String                       @map("source_id") @db.Uuid
  licenseId  BigInt                       @map("license_id")
  chunkText  String                       @map("chunk_text")
  embedding  Unsupported("vector(1536)")?
  tokenCount Int?                         @map("token_count")
  position   Int                          @default(0)
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, position])
  @@index([licenseId])
  @@map("knowledge_chunks")
}

// ===========================================================================
// Configuration
// ===========================================================================

/// Rules deciding which team a new conversation lands in (ADR-08 step 1).
model RoutingRule {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  name          String?
  kind          String   @default("chat")
  /// url / domain / geolocation / page predicates.
  conditions    Json     @default("{}")
  targetGroupId BigInt?  @map("target_group_id")
  priority      Int      @default(0)
  /// The catch-all used when nothing else matches. At most one per license+kind.
  isFallback    Boolean  @default(false) @map("is_fallback")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, kind, enabled, priority])
  @@map("routing_rules")
}

/// A connected inbound channel.
model Channel {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  brandId   String   @map("brand_id") @db.Uuid
  type      String
  status    String   @default("off")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Brand-scoped, not just license-scoped: one license may run the same channel
  // type once per brand (Multibrand, PRD §5.3). RLS narrows visibility to the
  // active brand on top of this key.
  @@unique([licenseId, brandId, type])
  // A second, platform-wide uniqueness rule lives in
  // 20260809090000_channel_address_uniqueness and cannot be written here:
  // UNIQUE (type, (config->>'address')) WHERE status = 'connected' AND
  // config->>'address' IS NOT NULL. It is what makes an inbound webhook's
  // address resolve to exactly one workspace (NFR-S4/S5); Prisma can express
  // neither a JSON expression index nor a WHERE predicate, so it is hand-written
  // and registered in `scripts/check-drift.ts` (KNOWN_UNMODELLABLE).
  @@map("channels")
}

/// Maps a channel's external sender identity (a Messenger PSID, a phone number)
/// to a customer (FR-MOD-08.5.4-.6). A returning contact is matched here, so
/// their history is one thread rather than a new stranger each time, and an
/// outbound reply is addressed by looking the external id back up from the chat.
model ChannelIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  channelType String   @map("channel_type")
  externalId  String   @map("external_id")
  customerId  String   @map("customer_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([licenseId, channelType, externalId])
  @@map("channel_identities")
}

/// One message that crossed a channel adapter — the audit trail of what entered
/// (inbound) and left (outbound) the workspace over Messenger/SMS/WhatsApp.
/// `chat_id` is a soft reference (no FK): the record outlives the conversation.
model ChannelMessage {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         BigInt   @map("license_id")
  channelType       String   @map("channel_type")
  direction         String
  externalId        String   @map("external_id")
  chatId            String?  @map("chat_id")
  text              String?
  providerMessageId String?  @map("provider_message_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, channelType, createdAt])
  @@index([licenseId, chatId])
  @@map("channel_messages")
}

/// A site the widget is installed on.
///
/// Brand-scoped, not just license-scoped (Multibrand, PRD §5.3): a site belongs
/// to exactly one brand, and the same domain may be added once per brand — the
/// `(license, brand, domain)` unique key. RLS narrows the list to the active
/// brand on top of that; a license-wide request (no brand) still sees every
/// brand's sites, so a single-brand workspace is unchanged.
model Website {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   BigInt    @map("license_id")
  brandId     String    @map("brand_id") @db.Uuid
  domain      String
  createdBy   String?   @map("created_by")
  connectedAt DateTime? @map("connected_at") @db.Timestamptz(6)
  setup       String    @default("manual")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([licenseId, brandId, domain])
  @@map("websites")
}

/// A brand under a license — the Multibrand surface (PRD §5.3 · NFR-S4).
///
/// Shaped like `Website`: license-scoped, a uuid id, `onDelete: Cascade`. Every
/// license owns at least one brand — the migration backfill and the seed lay
/// down a single `Default` (`is_default`) row, so a workspace that never touches
/// Multibrand keeps behaving exactly as one brand. At most one default per
/// license is enforced by a partial unique index (`ON brands(license_id) WHERE
/// is_default`), which Prisma cannot express and the migration adds by hand.
model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  slug      String
  logoUrl   String?  @map("logo_url")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license          License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  channels         Channel[]
  websites         Website[]
  securitySettings SecuritySettings[]
  inboxSettings    InboxSettings[]
  widgetSettings   WidgetSettings[]

  @@unique([licenseId, slug])
  @@map("brands")
}

/// Outbound webhook registration.
///
/// `secretKey` is the HMAC signing key (v2-04 §6.2). Unlike the platform this
/// clones, it is never echoed back inside the payload — only the signature
/// travels, so the secret cannot leak through a customer's request logs.
model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  clientId  String?  @map("client_id")
  url       String
  action    String
  secretKey String   @map("secret_key")
  type      String   @default("license")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license    License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([licenseId, action, enabled])
  @@map("webhooks")
}

/// One outbound delivery attempt (FR-MOD-08.8.4 · NFR-M5; redelivery M-SCHED-e).
///
/// Every attempt — the first try, each in-request retry and each scheduled
/// redelivery — writes a row, so the trail of what was sent and how it fared is
/// complete and auditable. Two kinds of column live here and they behave
/// differently:
///
///   * **History** (`attempt`, `ok`, `status_code`, `error`, `created_at`) is
///     written once and never changed. It records one send.
///   * **Queue state** (`state`, `next_attempt_at`, `payload`) is mutable, and
///     is only ever live on the newest row of a delivery. It is what lets a
///     redelivery survive a restart: `pending` means "this attempt failed and
///     another is owed at `next_attempt_at`", and the payload beside it is the
///     exact body to re-sign and re-send.
///
/// `event_id` groups the attempts of one logical delivery (one domain event to
/// one webhook). A partial unique index on `(license_id, event_id) WHERE state
/// = 'pending'` — hand-written in the migration, since Prisma cannot express a
/// predicate — is what guarantees an event is queued in exactly one place, and
/// so can never be picked up and delivered twice.
///
/// `permanent` is now the boolean shadow of `state = 'exhausted'`, held to it
/// by a CHECK. It used to mean "the third in-request attempt failed", which
/// stopped meaning "gave up" the moment a scheduler began carrying the row on.
model WebhookDelivery {
  id        String @id @default(uuid()) @db.Uuid
  licenseId BigInt @map("license_id")
  webhookId String @map("webhook_id") @db.Uuid
  /// Null on rows written before redelivery existed; those can never be queued.
  eventId    String? @map("event_id") @db.Uuid
  action     String
  attempt    Int
  ok         Boolean
  statusCode Int?    @map("status_code")
  error      String?
  permanent  Boolean @default(false)
  /// `pending` | `delivered` | `failed` | `exhausted`. The migration's CHECK
  /// constraint is the authority on the vocabulary; there is deliberately no
  /// default, so every writer has to say which of the four it means.
  state      String
  /// Live only while `state = 'pending'`: when the delivery is next owed a try
  /// and — pushed forward by the sweep that claims it — the lease that stops a
  /// second worker taking the same row.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// The exact serialized body to re-send, held only while a retry is still
  /// owed and cleared the moment the delivery is terminal. Text rather than
  /// jsonb because these are the bytes the signature commits to and jsonb
  /// would reorder them; kept off terminal rows so a delivered webhook leaves
  /// no lasting copy of a customer payload in the log.
  payload   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([licenseId, webhookId, createdAt])
  @@index([licenseId, state, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Per-brand security configuration (PRD §8.4 `security_settings` · §5.3).
///
/// Keyed by `(license, brand)`, one row per brand (Multibrand). The settings
/// screen resolves the row from `X-Nexa-Brand`, or the license default when no
/// brand is named — so a single-brand workspace keeps its single row. RLS
/// narrows the row to the active brand on top of the license match.
model SecuritySettings {
  licenseId                 BigInt   @map("license_id")
  brandId                   String   @map("brand_id") @db.Uuid
  bannedCustomerIps         String[] @default([]) @map("banned_customer_ips")
  spamFilterEnabled         Boolean  @default(true) @map("spam_filter_enabled")
  fileSharingEnabled        Boolean  @default(true) @map("file_sharing_enabled")
  allowedFileTypes          String[] @default(["image/png", "image/jpeg", "application/pdf"]) @map("allowed_file_types")
  maxFileSizeBytes          Int      @default(10485760) @map("max_file_size_bytes")
  requireTwoFactor          Boolean  @default(false) @map("require_two_factor")
  /// Whether the `ipAllowlistEntries` list is enforced for agent/PAT/bot requests
  /// (FR-MOD-08.9.6). When true, the auth edge (plugins/auth.ts) admits only
  /// source addresses matching an entry; off, or with an empty list, imposes no
  /// restriction. Customer/widget traffic is exempt (that surface uses
  /// `bannedCustomerIps`).
  ipAllowlistEnforced       Boolean  @default(false) @map("ip_allowlist_enforced")
  /// Seconds of inactivity before a session is force-expired. Null disables
  /// the policy (the default) — nothing enforces this yet.
  sessionIdleTimeoutSeconds Int?     @map("session_idle_timeout_seconds")
  /// Per-owner cap on simultaneous active sessions. Null falls back to the
  /// fixed `MAX_ACTIVE_TOKENS_PER_OWNER` constant (25) — nothing reads this
  /// column to enforce it yet.
  maxConcurrentSessions     Int?     @map("max_concurrent_sessions")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("security_settings")
}

/// Per-brand inbox behaviour (FR-MOD-08.7, "Settings/Inbox tools").
///
/// A singleton keyed by `(license, brand)`, like `SecuritySettings`. Signup does
/// not create the row — the settings endpoint upserts it on first save under the
/// resolved brand, and a read with no row falls back to the schema defaults — so
/// a workspace that has never touched these behaves as "everything off".
model InboxSettings {
  licenseId          BigInt   @map("license_id")
  brandId            String   @map("brand_id") @db.Uuid
  /// Auto-close a chat after this many seconds with no activity (FR-MOD-08.7.3).
  /// Null disables it. Only a positive value is ever written — enforced at the
  /// settings endpoint and re-checked by the sweep, so a zero or negative window
  /// (which would close every live chat at once) can never take effect.
  chatTimeoutSeconds Int?     @map("chat_timeout_seconds")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("inbox_settings")
}

/// Per-brand widget appearance (FR-MOD-11.7, "Widget customization").
///
/// A singleton keyed by `(license, brand)`, like `InboxSettings`. Signup does
/// not create the row — the settings endpoint upserts it on first save under the
/// resolved brand, and a read with no row falls back to the schema defaults — so
/// a workspace that has never touched these renders the shipped look. The column
/// defaults mirror `DEFAULT_WIDGET_APPEARANCE` in `@nexa/types` value-for-value.
model WidgetSettings {
  licenseId        BigInt   @map("license_id")
  brandId          String   @map("brand_id") @db.Uuid
  /// Brand colour — a `#rrggbb` hex, checked by the settings endpoint and the
  /// `widget_settings_color_check` DB invariant so nothing but a colour is ever
  /// stored (it is embedded in the install snippet and applied to CSS).
  primaryColor     String   @default("#2d67fa") @map("primary_color")
  /// `bottom-right` | `bottom-left` — the `widget_settings_position_check`.
  position         String   @default("bottom-right")
  /// `auto` | `light` | `dark` — the `widget_settings_theme_check`.
  theme            String   @default("auto")
  mobileFullscreen Boolean  @default(true) @map("mobile_fullscreen")
  /// The removable "Powered by Nexa" footer (FR-MOD-11.5).
  poweredBy        Boolean  @default(true) @map("powered_by")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("widget_settings")
}

// ===========================================================================
// Billing (ADR-13 — Stripe is mocked)
// ===========================================================================

/// The payment method on file (FR-MOD-10.3, "ödeme yöntemi güncelleme").
///
/// A singleton per license, like `SecuritySettings`. Billing is mocked
/// (ADR-13), and real card entry is out of scope (PRD §11.1/1) — so this stores
/// only the *masked* representation a real processor would hand back after
/// tokenising a card (`brand` + `last4` + expiry + holder), never a full PAN.
/// Nothing here is PCI-sensitive and nothing is charged.
model PaymentMethod {
  licenseId  BigInt   @id @map("license_id")
  /// Card network — `visa`, `mastercard`, `amex`, `discover`.
  brand      String
  /// Last four digits only — the one card fragment that is safe to store.
  last4      String   @db.Char(4)
  expMonth   Int      @map("exp_month")
  expYear    Int      @map("exp_year")
  holderName String   @map("holder_name")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  licenseId             BigInt    @map("license_id")
  plan                  String    @default("growth")
  billingCycle          String    @default("monthly") @map("billing_cycle")
  seats                 Int       @default(1)
  unitPriceCents        Int       @default(9900) @map("unit_price_cents")
  aiResolutionsIncluded Int       @default(200) @map("ai_resolutions_included")
  status                String    @default("trialing")
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd      DateTime? @map("current_period_end") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, status])
  @@map("subscriptions")
}

/// Metered usage, aggregated per calendar month.
///
/// `ai_resolutions` is the single counter behind both billing and the Reports
/// "Automated" figure (ADR-09) — two counters would inevitably disagree.
model UsageRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  licenseId             BigInt   @map("license_id")
  metric                String
  /// `yyyymm`.
  period                String   @db.Char(6)
  quantity              BigInt   @default(0)
  included              BigInt   @default(0)
  overageUnit           Int      @default(1) @map("overage_unit")
  overageUnitPriceCents Int      @default(0) @map("overage_unit_price_cents")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, metric, period])
  @@map("usage_records")
}

/// One purchased API request package (FR-MOD-09.3).
///
/// The quota a purchase buys lives in `usage_records.included` — buying raises
/// the period's included calls — so this table is not the quota, it is the
/// *record of the sale*: which license bought which catalogue package, for how
/// many calls, at what price, into which period. Nothing else holds that.
/// Payment is mocked (ADR-13), so no external processor keeps a receipt, and
/// `usage_records` carries only the summed total, with no trace of what raised
/// it. Without this row a workspace could be charged with nothing to show for
/// what, and the invoice line item (09.3-e) would have nothing to derive from.
///
/// `package_id` names an `API_PACKAGE_CATALOG` entry in code rather than a row
/// — the catalogue is static (`@nexa/types`) — so it carries no foreign key and
/// no domain CHECK, the same way `scheduled_reports.group_id` names a
/// REPORT_GROUPS entry; the purchase route validates it instead. The quota and
/// the price are *copied* rather than looked up, so re-pricing a package in
/// code never rewrites what a workspace already paid.
model ApiPackagePurchase {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  /// An `API_PACKAGE_CATALOG` id — `essential`, `pro`, `pro-plus`.
  packageId   String   @map("package_id")
  /// Calls this purchase added, as the catalogue priced them at sale time.
  apiCalls    BigInt   @map("api_calls")
  priceCents  Int      @map("price_cents")
  /// `yyyymm` — the `usage_records` period the quota was added to.
  period      String   @db.Char(6)
  purchasedAt DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, period])
  @@map("api_package_purchases")
}

// ===========================================================================
// Audit
// ===========================================================================

/// Security-relevant actions. PRD §8.4 makes this available on every plan,
/// not just Enterprise as the source platform does.
model AuditLogEntry {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  actorId   String?  @map("actor_id")
  actorType String   @default("agent") @map("actor_type")
  action    String
  target    String?
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Tamper-evident chain (NFR-C6 · C6-c). `chainSeq` is this workspace's own
  /// row counter — gapless by construction, so a missing number *is* a deleted
  /// entry — and `hash` is an HMAC over the row's content and `prevHash`, so a
  /// changed entry no longer matches the link that points at it. Nullable only
  /// because entries written before the chain existed cannot be back-computed:
  /// the key lives outside the database and a migration has no access to it.
  /// Claiming those rows are chained would be the false assurance this whole
  /// control exists to prevent, so they are honestly marked as not chained; the
  /// verifier reports any *post-genesis* row that is unchained as a finding.
  chainSeq  BigInt?  @map("chain_seq")
  prevHash  String?  @map("prev_hash")
  hash      String?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// No two entries may hold the same position. Postgres treats NULLs as
  /// distinct, so the pre-chain rows above are all still permitted — the
  /// constraint binds exactly the rows that make a claim.
  @@unique([licenseId, chainSeq])
  @@index([licenseId, createdAt(sort: Desc)])
  @@index([licenseId, action, createdAt(sort: Desc)])
  /// The export reads the same table the *other* way round — oldest first, from
  /// a keyset position — so the descending indexes above serve it backwards.
  /// Ascending index of its own, because a SIEM feed is a forward scan and the
  /// alternative is a sort of the workspace's entire trail on every poll.
  @@index([licenseId, createdAt, id])
  @@map("audit_log")
}

/// The head of a workspace's audit chain (NFR-C6 · C6-c).
///
/// One row per licence, holding the position and hash the *next* entry will
/// build on. It exists rather than being read back off `audit_log` for two
/// reasons, and both are about what happens after retention runs.
///
/// First, the anchor has to outlive the rows. Pruning removes the oldest
/// entries; if the next sequence number were `max(chain_seq) + 1` off the
/// table, a workspace whose trail was pruned to nothing would silently start
/// again at 1 and two different entries would carry the same position — so two
/// exports taken a year apart could disagree about which row seq 7 was.
///
/// Second, `prunedThroughSeq` is what tells a legitimate absence apart from a
/// deletion. Without it the verifier can only check that what remains is
/// contiguous, which means removing entries from the *front* of the retained
/// trail leaves no trace. With it, the first surviving row is expected at
/// `prunedThroughSeq + 1`, and anything else is a finding.
model AuditChainHead {
  licenseId BigInt @id @map("license_id")
  /// The position of the last entry chained for this licence. Advanced under a
  /// row lock, which is what serialises concurrent writers: two transactions
  /// reading the same head would otherwise fork the chain in two.
  seq       BigInt @default(0)
  /// That entry's hash — the `prevHash` of whatever comes next. Null only
  /// between the row being created and the first entry landing.
  hash      String?
  /// When this licence's chain began. A row written after this instant and left
  /// unchained is a finding, which is what stops "unchained" being usable as a
  /// way to hide an entry in plain sight.
  genesisAt DateTime @default(now()) @map("genesis_at") @db.Timestamptz(6)
  /// The highest position retention has legitimately removed. Written by
  /// `audit_prune_expired`, the one function permitted to delete from the log.
  prunedThroughSeq BigInt? @map("pruned_through_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("audit_chain_heads")
}

/// Where a workspace's audit trail is shipped, and how far it has got
/// (NFR-C6 · C6-b).
///
/// One row per (licence, target). The row is *both* the configuration and the
/// position, deliberately: they cannot be allowed to disagree. Held apart, a
/// workspace could point the export at a new destination while the old
/// destination's position carried on, and the trail would appear delivered to
/// somewhere it never reached.
///
/// The position is the last row this target has been *delivered*, as the full
/// keyset `(created_at, id)` — the same sort key the export pages on, so a
/// resume lands exactly where the last delivery ended. It is written by the
/// scheduled sink (C6-d); the pull endpoint (`GET /audit-log/export`) does not
/// touch it, because there the caller holds the cursor and two consumers
/// sharing one position would each skip the other's rows.
model SiemExportCursor {
  id        String @id @default(uuid()) @db.Uuid
  licenseId BigInt @map("license_id")
  /// A `SIEM_EXPORT_TARGETS` value — `file` today, the `.data/siem` sink.
  /// Constrained in the database (`siem_export_cursors_target_check`): a target
  /// nothing can deliver to would sit in the settings screen looking like a
  /// live export while nothing ever leaves.
  target    String
  /// Configuration and delivery are two decisions, like `SsoConnection.enabled`:
  /// a workspace can name its destination before turning the feed on.
  enabled   Boolean @default(false)

  /// The keyset position of the last delivered entry — `audit_log.id` and its
  /// `created_at`. Soft reference, no foreign key: retention prunes the trail
  /// (`audit_prune_expired`) and the position must survive the disappearance of
  /// the row it names, or pruning would drag the cursor back to the beginning
  /// and re-deliver everything. Both halves are set together or neither is
  /// (`siem_export_cursors_cursor_halves_check`) — half a keyset is an
  /// ambiguous resume point, and the ambiguity resolves to either skipping or
  /// re-sending an unbounded number of rows.
  lastExportedId String?   @map("last_exported_id") @db.Uuid
  lastExportedAt DateTime? @map("last_exported_at") @db.Timestamptz(6)
  /// When a delivery last completed — *not* the cursor. The two differ by the
  /// age of the trail: a sink that ran a minute ago and found nothing new has a
  /// fresh `lastRunAt` and an old `lastExportedAt`, and the status screen has to
  /// tell "nothing happened" apart from "nothing is being shipped".
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  /// Running total of entries delivered to this target, ever. Cheap to keep and
  /// the only figure that survives retention pruning the rows it counted.
  exportedCount  BigInt    @default(0) @map("exported_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, target])
  @@map("siem_export_cursors")
}

// ===========================================================================
// Apps marketplace (FR-MOD-09.1)
// ===========================================================================

/// A third-party integration a workspace has connected through the (mock) OAuth
/// flow. The catalogue of *available* apps is static (@nexa/types APP_CATALOG);
/// this table records only which of them a licence has connected, one row per
/// app. `externalAccount` is the account label the mock grant returned; the
/// granted scopes are the catalogue entry's, so they are not stored again here.
model AppInstallation {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  appId           String   @map("app_id")
  status          String   @default("connected")
  externalAccount String   @map("external_account")
  connectedAt     DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, appId])
  @@map("app_installations")
}

// ===========================================================================
// Public knowledge base (self-service KB — PRD §5.3, v2)
// ===========================================================================

/// A grouping public KB readers browse (KK "self-servis gezinme"). Deliberately
/// a separate model from `KnowledgeSource` — that table feeds the AI Agent's
/// RAG retrieval, this one is reader-facing taxonomy; the two never share rows
/// (§C-PUBKB-1). A slug is unique within a license, like `Brand`/`Expertise`.
model KbCategory {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  slug      String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  articles KbArticle[]

  @@unique([licenseId, slug])
  @@map("kb_categories")
}

/// A public KB article. `seoTitle`/`seoDescription` carry the KK "SEO'lu" half
/// of the requirement; `status` the "public" half (a draft is never served by
/// the anonymous read path, built in PUBKB-c). `categoryId` is optional so an
/// article can exist before it is filed under a category; deleting a category
/// clears the link rather than deleting the article.
model KbArticle {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  categoryId     String?   @map("category_id") @db.Uuid
  slug           String
  title          String
  body           String
  excerpt        String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  /// 'draft' | 'published'.
  status         String    @default("draft")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  license  License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  category KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([licenseId, slug])
  @@index([licenseId, status, publishedAt(sort: Desc)])
  @@map("kb_articles")
}

/// Per-license switch and public address for the KB (license-singleton, keyed
/// and shaped like `payment_methods`). `publicSlug` is GLOBAL unique — unlike
/// every other slug in this schema — because it is the path segment on a
/// single shared public host (§C-PUBKB-4), not a value scoped inside one
/// license's own namespace.
model KbSettings {
  licenseId  BigInt   @id @map("license_id")
  enabled    Boolean  @default(false)
  publicSlug String   @unique @map("public_slug")
  siteTitle  String?  @map("site_title")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("kb_settings")
}

// ===========================================================================
// Work scheduler / staffing prediction (PRD §5.3-Vardiya, v2)
// ===========================================================================

/// An agent's standing weekly availability (WORKSCHED). Keyed `(license, agent)`
/// like `AgentMembership` — one plan per agent per workspace, and an agent who
/// works in two workspaces keeps two independent plans.
///
/// Deliberately separate from `AgentMembership.routingStatus`: that column is
/// the *live* toggle an agent flips themselves right now, this is the *plan*
/// the staffing forecast (WORKSCHED-g) reads to predict coverage ahead of time.
/// Collapsing them would make "is Ayşe online?" and "is Ayşe rostered?" the
/// same question, and the forecast needs both.
///
/// `schedule` is the `WorkScheduleSlot[]` of `@nexa/types`, stored as JSONB
/// because it is read and written whole — never queried slot-by-slot. The DB
/// guarantees only that it is an array (`work_schedules_schedule_is_array_check`);
/// the per-slot rules (known weekday, no repeats, `HH:MM`, start < end) are
/// `normalizeWorkSchedule()`'s job at the boundary. No row means the agent has
/// never opened the editor, which reads as `DEFAULT_WORK_SCHEDULE`.
model WorkSchedule {
  licenseId BigInt   @map("license_id")
  agentId   String   @map("agent_id") @db.Uuid
  /// IANA zone. A plan without one cannot be compared against real traffic, so
  /// the column defaults to `DEFAULT_WORK_SCHEDULE.timezone` value-for-value.
  timezone  String   @default("UTC")
  schedule  Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, agentId])
  @@index([agentId])
  @@map("work_schedules")
}

/// A workspace's SLA targets (FR-MOD-11.5 · §5.4 "Kurumsal").
///
/// One row per licence — `license_id` *is* the primary key, because a target is
/// a workspace-wide policy rather than a list of them. The plural table name is
/// the plan's; the singular row is what the requirement asks for, and a second
/// row would immediately raise "which one applies?" with no answer written down.
///
/// Both minute columns are nullable and mean *no target*, which is a different
/// statement from a target of zero; a positivity CHECK in the migration keeps
/// the two from being confused. `business_hours_only` decides whether the clock
/// runs continuously or only during the hours `work_schedules` says the
/// workspace is open — no second calendar model was opened for it (§C-A27).
///
/// A row survives a downgrade (§C-A26): the read path stops honouring it, so a
/// re-upgrade restores the workspace's configuration instead of finding it
/// erased. `lib/entitlements.ts` is where that rule lives.
model SlaPolicy {
  licenseId            BigInt   @id @map("license_id")
  firstResponseMinutes Int?     @map("first_response_minutes")
  resolutionMinutes    Int?     @map("resolution_minutes")
  businessHoursOnly    Boolean  @default(false) @map("business_hours_only")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

/// One recorded miss — the report row a breach produces (§C-A27).
///
/// Append-only in shape, like `AgentPresenceEvent`: a row is a fact about a
/// moment that passed, so nothing edits one afterwards except `notified_at`,
/// which records that the alert for it went out. The unique key
/// `(licence, subject, target)` is what makes marking *idempotent*: the clock
/// stopping and the sweep can both notice the same miss, and the second one to
/// arrive changes nothing. Without it a case left open over a weekend would
/// collect one row per sweep.
///
/// `target_minutes` and `business_hours_only` are copied onto the row rather
/// than joined from the policy, because the policy is editable: a report that
/// re-read it would describe last month's misses against this month's targets.
model SlaBreach {
  id                String    @id @default(uuid()) @db.Uuid
  licenseId         BigInt    @map("license_id")
  /// `thread` or `ticket` — `SLA_SUBJECT_TYPES` in `@nexa/types`.
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id")
  /// `first_response` or `resolution` — `SLA_TARGETS` in `@nexa/types`.
  target            String
  targetMinutes     Int       @map("target_minutes")
  /// Elapsed when the miss was noticed; business minutes when the policy said so.
  elapsedMinutes    Int       @map("elapsed_minutes")
  businessHoursOnly Boolean   @map("business_hours_only")
  detectedAt        DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  /// When the alert for this miss was sent, or null while it is still pending.
  notifiedAt        DateTime? @map("notified_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, subjectType, subjectId, target], map: "sla_breaches_subject_key")
  @@index([licenseId, detectedAt(sort: Desc)])
  @@index([licenseId, notifiedAt])
  @@map("sla_breaches")
}

/// One recorded change of an agent's routing status — the presence history the
/// forecast compares the plan against ("rostered until 18:00, actually went
/// offline at 16:20").
///
/// Append-only in shape: a row is a fact about a moment, so there is no
/// `updated_at` and nothing edits one after the fact. It is an event log like
/// `WebhookDelivery`, not a settings row, and carries its own `license_id` so
/// the tenant policy is the plain license match.
///
/// The index is `(license, agent, changed_at)` because every reader asks the
/// same question — one agent's transitions inside one workspace over a window.
model AgentPresenceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  agentId   String   @map("agent_id") @db.Uuid
  /// One of `ROUTING_STATUSES` (`@nexa/types`), the same domain as
  /// `AgentMembership.routingStatus` — enforced by
  /// `agent_presence_events_status_check`, the mirror of
  /// `agent_memberships_routing_status_check`.
  status    String
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([licenseId, agentId, changedAt])
  @@map("agent_presence_events")
}

// ===========================================================================
// Scheduled report exports (PRD §5.3-Reports, v2)
// ===========================================================================

/// A standing instruction to mail one report group out on a cadence
/// (07.9-sched). The definition only; the scheduler that acts on it lands in
/// 07.9-sched-e and writes a `ScheduledReportRun` per period.
///
/// `groupId` names a `REPORT_GROUPS` entry (`routes/reports-export.ts`) rather
/// than a row in a table, so there is deliberately no foreign key and no domain
/// CHECK: the catalogue lives in code and grew by four groups in 07.7 alone, and
/// a database constraint would turn each addition into a migration. The route
/// (07.9-sched-b) validates the id against `reportGroup()` at the boundary, the
/// same place the manual export already does.
model ScheduledReport {
  id               String    @id @default(uuid()) @db.Uuid
  licenseId        BigInt    @map("license_id")
  /// A `REPORT_GROUPS` id — 'overview', 'leads', 'sales', …
  groupId          String    @map("group_id")
  /// 'daily' | 'weekly' | 'monthly'. Constrained in the database
  /// (`scheduled_reports_frequency_check`) because the period key the scheduler
  /// deduplicates on is derived *from* this value: an unknown frequency would
  /// yield an undefined period, and with it no "already delivered" answer.
  frequency        String
  /// 'csv' — the only shape the scheduler produces. Left unconstrained on
  /// purpose: PDF is a plausible later addition (07.7-g already renders one for
  /// the manual export) and a CHECK here would cost a migration to allow it,
  /// while a wrong value fails loudly at generation time rather than corrupting
  /// anything.
  format           String    @default("csv")
  /// Mailbox addresses the run is delivered to. Never empty
  /// (`scheduled_reports_recipients_not_empty_check`): a definition with no
  /// recipients would still claim its period and so deliver to nobody, silently,
  /// forever.
  recipients       String[]
  enabled          Boolean   @default(true)
  /// Soft reference to `accounts.id`, like `Skill.createdBy` and
  /// `KbArticle.createdBy` — no FK, so the workspace keeps its schedule when the
  /// agent who set it up leaves.
  createdByAgentId String?   @map("created_by_agent_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set by the scheduler after a successful delivery. A convenience for the
  /// list screen (07.9-sched-h) only — never the idempotency check, which reads
  /// `scheduled_report_runs`.
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(6)

  license License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  runs    ScheduledReportRun[]

  /// Not decoration — the target of `scheduled_report_runs`' composite foreign
  /// key, which is what stops one license claiming a period on another's
  /// schedule. Doubles as the index behind the by-id lookup routes (07.9-sched-c).
  @@unique([licenseId, id])
  /// The sweep's only question: which of this license's schedules are live?
  @@index([licenseId, enabled])
  @@map("scheduled_reports")
}

/// One period's delivery of a scheduled report — the history, and the lock.
///
/// `@@unique([scheduledReportId, periodKey])` is what makes the scheduler
/// idempotent: the run row is inserted *before* the mail goes out, so a second
/// sweep (a retry, an overlapping cron, two API instances) collides on the
/// constraint and knows the period is taken. That is why a failed delivery keeps
/// its row with `status = 'failed'` rather than deleting it — releasing the
/// period would let the next sweep mail the same report again. Modelled on
/// `CampaignSend`'s `(campaign_id, customer_id)` pair, which stops a campaign
/// firing twice at the same visitor.
///
/// The link to the schedule is a *composite* foreign key on
/// `(license_id, scheduled_report_id)` — the `AgentExpertise` pattern — and it
/// is a tenant guard, not a formality. With a plain `scheduled_report_id` FK,
/// tenant A could insert a run carrying its own `license_id` while pointing at
/// tenant B's schedule: the RLS `WITH CHECK` would pass, because the row really
/// is A's, yet the claim would occupy B's `(schedule, period)` slot and B's
/// report would silently never be delivered for that period. The composite key
/// makes that row impossible to write rather than merely invisible.
model ScheduledReportRun {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         BigInt   @map("license_id")
  scheduledReportId String   @map("scheduled_report_id") @db.Uuid
  /// The period this run covers, as a deterministic label derived from the
  /// frequency: `2026-07-31` (daily), `2026-W31` (weekly), `2026-07` (monthly).
  /// Shape-checked in the database (`scheduled_report_runs_period_key_check`):
  /// an empty or free-form key would collapse every period onto one row, and the
  /// report would be delivered exactly once and never again.
  periodKey         String   @map("period_key")
  periodFrom        DateTime @map("period_from") @db.Timestamptz(6)
  periodTo          DateTime @map("period_to") @db.Timestamptz(6)
  /// 'pending' (claimed, not yet delivered) | 'sent' | 'failed'.
  status            String   @default("pending")
  recipientCount    Int      @default(0) @map("recipient_count")
  rowCount          Int      @default(0) @map("row_count")
  /// Why the delivery failed, for the history screen (07.9-sched-g).
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license         License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  scheduledReport ScheduledReport @relation(fields: [licenseId, scheduledReportId], references: [licenseId, id], onDelete: Cascade)

  @@unique([scheduledReportId, periodKey])
  @@index([licenseId, scheduledReportId, createdAt])
  @@map("scheduled_report_runs")
}
