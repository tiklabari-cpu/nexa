// SiyahTuş data model.
//
// Source of truth: PRD §8.4 + rapor-2 §5.3. The legacy
// `LiveChat_ER_Diyagram.mermaid` contradicts both and is NOT used.
//
// Models arrive with the slice that needs them:
//   slice 2 — tenancy & auth
//   slice 3 — the conversation core, configuration, AI, billing and audit tables
//
// Every tenant-scoped table carries `license_id` (and `organization_id` where
// the resource outlives a license). Row level security is defined in the SQL
// migrations, not here — Prisma has no schema syntax for policies, and the
// policies are the load-bearing part of tenant isolation.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // plpgsql is a Postgres built-in and always present; declaring it keeps
  // `prisma migrate diff` clean so a real drift is never lost in the noise.
  extensions = [pgcrypto, citext, vector, pg_trgm, plpgsql(schema: "pg_catalog")]
}

/// Tenant root.
model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  /// Where this workspace's data lives: `eu` or `us` (ADR-12, widened by C4-a).
  /// Chosen at signup and immutable afterwards — the CHECK constraint and the
  /// `organizations_region_immutable` trigger enforce both halves, neither of
  /// which Prisma models, so this comment is the only place the schema says so.
  region      String   @default("eu")
  /// Company details (FR-MOD-08.3 · M-CO-a): the billing/branding/report basis
  /// PRD §8.4 asks for. Closed list, not free text — reportable rather than
  /// merely descriptive, matching every other classification column here
  /// (`region`, `licenses.billing_cycle`, `licenses.status`): a workspace
  /// typing "Gaming" today and "gaming" tomorrow would fragment a report that
  /// groups by this column. `COMPANY_SECTORS` (`@siyahtus/types`) is the value
  /// list; `organizations_sector_check` is the other half Prisma cannot model.
  /// Null until a workspace fills in Settings → Company details.
  sector      String?
  /// Free text (FR-MOD-08.3). Unlike `sector` this has no natural closed set —
  /// postal formats vary too widely across the regions this product serves —
  /// so it stays one string rather than a structured street/city/postal
  /// breakdown; MVP collects no separate billing address to reuse one from.
  address     String?
  /// IANA zone, e.g. `"Europe/Istanbul"` (FR-MOD-08.3). Defaults to UTC like
  /// `work_schedules.timezone`. Whether this is the source an agent's own
  /// work-schedule timezone defaults from, or a separate fact, is M-CO-b's
  /// decision — this column only records the workspace-level one.
  timezone    String   @default("UTC")
  /// Head-count bucket (FR-MOD-00.4 · FR-MOD-08.3): the onboarding wizard's
  /// "şirket büyüklüğü" step writes here, same as `sector` — one set of
  /// company facts, no second table for what the wizard collects. Closed
  /// list, not free text, for the identical reason `sector` is one:
  /// reportable rather than merely descriptive. `COMPANY_SIZES` (`@siyahtus/types`)
  /// is the value list; `organizations_company_size_check` is the other half
  /// Prisma cannot model. Null until a workspace sets one.
  companySize String?  @map("company_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  licenses     License[]
  oauthClients OauthClient[]

  @@map("organizations")
}

/// Billing and membership boundary. One organization may hold several.
///
/// PRD §8.4 gives licenses a bigint id rather than a uuid. The backing sequence
/// is created in the RLS migration and starts at 1000001, so ids never resemble
/// row counts or test fixtures.
model License {
  id                    BigInt    @id @default(autoincrement())
  organizationId        String    @map("organization_id") @db.Uuid
  plan                  String    @default("growth")
  billingCycle          String    @default("monthly") @map("billing_cycle")
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  status                String    @default("trialing")
  /// First-run setup (FR-MOD-00.4): null until the new owner finishes or skips
  /// the wizard. A per-license fact — the workspace is set up — so the wizard
  /// gates once for the whole workspace.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  /// When the owner accepted the HIPAA Business Associate Agreement (NFR-C4 ·
  /// C4-d), or null if never. Only a workspace hosted in `us` may hold a value
  /// here — HIPAA cover is conditional on US hosting, and the
  /// `licenses_baa_requires_us_region` trigger enforces that across tables,
  /// which Prisma cannot model, so this comment is where the schema says so.
  hipaaBaaSignedAt      DateTime? @map("hipaa_baa_signed_at") @db.Timestamptz(6)
  /// When the workspace's owner accepted the deployment's terms of service at
  /// sign-up (tm 257.9 · `TERMS_URL`), and which version (`TERMS_VERSION`) —
  /// both null when the deployment named no terms. Written only by
  /// `auth_signup`, in the transaction that creates the workspace;
  /// `licenses_terms_acceptance_check` keeps the two null together, which
  /// Prisma cannot model, so this comment is where the schema says so.
  termsAcceptedAt       DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion          String?   @map("terms_version")
  /// This workspace's own retention window for closed conversations (NFR-C8),
  /// or null to inherit the deployment default (`RETENTION_THREAD_DAYS`). One of
  /// `@siyahtus/types`' `RETENTION_TIERS` — `'30d' | '60d' | '365d' | 'unlimited'` —
  /// a checked string, the `device_tokens.platform` pattern, since Prisma has no
  /// shared enum for it; `licenses_retention_thread_window_check` is where the
  /// database says so. Stored as the tier rather than a day count so "unlimited"
  /// is not a number: the one integer it would naturally be (`0`) is the value
  /// `cutoffFor` refuses, because a zero window matches every row.
  /// A workspace under HIPAA scope has this capped at `HIPAA_RETENTION_CEILING`
  /// when the sweep reads it (NFR-C4 · C4-e); the stored choice is left alone.
  retentionThreadWindow String?   @map("retention_thread_window")
  /// The same, for visitor telemetry (`visits`) — null inherits
  /// `RETENTION_VISIT_DAYS`.
  retentionVisitWindow  String?   @map("retention_visit_window")
  /// When the onboarding sample data was laid down, so the seed never runs twice.
  demoSeededAt          DateTime? @map("demo_seeded_at") @db.Timestamptz(6)
  /// The "What are you tracking?" survey popover's answer (FR-MOD-07.2), or
  /// null before it is answered/skipped. One of the five values `@siyahtus/types`'
  /// `ONBOARDING_SURVEY_ANSWERS` names — Prisma has no shared enum for this, so
  /// it is a checked string, the `device_tokens.platform` pattern.
  surveyAnswer          String?   @map("survey_answer")
  /// When the survey was answered or skipped — either way, so "tek sefer"
  /// (shown once) holds regardless of which exit the owner used.
  surveyAnsweredAt      DateTime? @map("survey_answered_at") @db.Timestamptz(6)
  /// The production licence this one is a sandbox of (FR-MOD-11.5 · 11.5-f), or
  /// null on a real workspace. A sandbox is a *second tenant*: its own
  /// organization, its own RLS scope, its own everything — this column is the
  /// only thread back, and it exists so the meter, the invoice and the seat
  /// count can all ask one question. Unique, so a licence has at most one
  /// sandbox; nesting is refused by `licenses_sandbox_not_nested`, which Prisma
  /// cannot model, so this comment is where the schema says so.
  sandboxOfLicenseId    BigInt?   @unique @map("sandbox_of_license_id")
  /// When this sandbox was last wiped, or null if never. Kept on the row rather
  /// than in the audit trail because a reset destroys the sandbox's own trail,
  /// and writing into the *parent's* would be the one cross-licence write this
  /// slice exists to make impossible. Only a sandbox may carry a value —
  /// `licenses_sandbox_reset_requires_sandbox` enforces that.
  sandboxResetAt        DateTime? @map("sandbox_reset_at") @db.Timestamptz(6)
  /// The platform's override of this workspace's daily AI token caps (tm 283.2
  /// · AI-16-S2), or null to inherit the plan's and then the deployment's
  /// (`services/ai/ai-caps.ts`: `override ?? plan ?? deployment`). At least 1
  /// when set (`licenses_ai_daily_caps_check`). Written by the platform only:
  /// `licenses_ai_caps_platform_only` refuses the tenant API's role, which
  /// Prisma cannot model, so this comment is where the schema says so.
  aiDailyLlmTokensCap       BigInt? @map("ai_daily_llm_tokens_cap")
  aiDailyEmbeddingTokensCap BigInt? @map("ai_daily_embedding_tokens_cap")
  /// When the override above lapses (tm 389.12), or null for "until changed".
  /// Past it the workspace reads as if no override were set. Only beside an
  /// override (`licenses_ai_daily_caps_expiry_check`); platform-only, like the
  /// caps (`licenses_ai_caps_platform_only`).
  aiDailyCapsExpiresAt      DateTime? @map("ai_daily_caps_expires_at") @db.Timestamptz(6)
  /// The permission matrix's revision (tm 325.2 · RL-02): 0 until the Founder
  /// first changes it, plus one for every change that moved a stored row —
  /// bumped in that transaction, so a cache keyed by licence and version is
  /// never older than the rows once a reader asks for the current version.
  permissionsVersion    Int       @default(0) @map("permissions_version")
  /// The platform's suspension (tm 389.2): set with `status = 'suspended'`
  /// and cleared when it is lifted (`licenses_suspension_check`). The reason
  /// is the operator's and is shown to nobody in the workspace. All three are
  /// written by the platform only — `licenses_suspension_platform_only`
  /// refuses the tenant API's role, which Prisma cannot model.
  suspendedAt           DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason       String?   @map("suspended_reason")
  /// The status a suspension interrupted (tm 389.10), so lifting it puts the
  /// workspace back where it was — a trial resumes as a trial, a paid licence
  /// as paid. Only a suspended licence carries one
  /// (`licenses_suspended_from_status_check`); platform-written, like the two
  /// above.
  suspendedFromStatus   String?   @map("suspended_from_status")
  /// When the platform's purge job (389.10) may delete this workspace's data,
  /// if nobody lifts the suspension or the cancellation first.
  purgeScheduledAt      DateTime? @map("purge_scheduled_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sandboxOf              License?                @relation("LicenseSandbox", fields: [sandboxOfLicenseId], references: [id], onDelete: Cascade)
  sandbox                License?                @relation("LicenseSandbox")
  memberships            AgentMembership[]
  apiTokens              ApiToken[]
  refreshTokens          OauthRefreshToken[]
  groups                 Group[]
  expertise              Expertise[]
  chats                  Chat[]
  tags                   Tag[]
  tickets                Ticket[]
  ticketMessages         TicketMessage[]
  cannedResponses       CannedResponse[]
  campaigns              Campaign[]
  campaignSends          CampaignSend[]
  goals                  Goal[]
  aiAgents               AiAgent[]
  skills                 Skill[]
  workflows              Workflow[]
  routingRules           RoutingRule[]
  ticketRules            TicketRule[]
  ticketEmailTemplates   TicketEmailTemplate[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  channels               Channel[]
  channelIdentities      ChannelIdentity[]
  channelMessages        ChannelMessage[]
  inboundEmailAddresses  InboundEmailAddress[]
  websites               Website[]
  brands                 Brand[]
  webhooks               Webhook[]
  webhookDeliveries      WebhookDelivery[]
  subscriptions          Subscription[]
  usageRecords           UsageRecord[]
  aiDailyUsage           AiDailyUsage[]
  aiCustomerDailyUsage   AiCustomerDailyUsage[]
  aiUsageEvents          AiUsageEvent[]
  aiUsageAlerts          AiUsageAlert[]
  aiUsageAlertRecipients AiUsageAlertRecipient[]
  knowledgeStaleNotices  KnowledgeTableStaleNotice[]
  aiDecisionLogs         AiDecisionLog[]
  aiJobs                 AiJob[]
  queueEntries           QueueEntry[]
  aiConversations        AiConversation[]
  aiHandoffSettings      AiHandoffSettings[]
  aiGuidanceRules        AiGuidanceRule[]
  aiHandoffRules         AiHandoffRule[]
  handoffRoutes          HandoffRoute[]
  kbPaymentMethods       KbPaymentMethod[]
  kbBonuses              KbBonus[]
  kbKycDocuments         KbKycDocument[]
  kbRules                KbRule[]
  aiAccessInfo           AiAccessInfo[]
  aiGuardrailSettings    AiGuardrailSettings[]
  aiGuardrailRules       AiGuardrailRule[]
  aiForbiddenPhrases     AiForbiddenPhrase[]
  aiGuardrailHits        AiGuardrailHit[]
  riskFlags              RiskFlag[]
  aiHandoffs             AiHandoff[]
  riskFlagSettings       RiskFlagSettings?
  aiProcedureExamples    AiProcedureExample[]
  aiTestScenarios        AiTestScenario[]
  aiTestRuns             AiTestRun[]
  aiTestRunResults       AiTestRunResult[]
  aiSandboxSessions      AiSandboxSession[]
  aiUnresolvedItems      AiUnresolvedItem[]
  aiUnresolvedClusters   AiUnresolvedCluster[]
  aiUnresolvedSettings   AiUnresolvedSettings?
  aiConfigChanges        AiConfigChange[]
  aiConfigVersions       AiConfigVersion[]
  aiSuggestions          AiSuggestion[]
  mailDailyUsage         MailDailyUsage[]
  apiPackagePurchases    ApiPackagePurchase[]
  aiPackagePurchases     AiPackagePurchase[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  paymentMethod          PaymentMethod?
  auditEntries           AuditLogEntry[]
  auditChainHead         AuditChainHead?
  pendingAuditEntries    PendingAuditEntry[]
  roleCapabilityOverrides RoleCapabilityOverride[]
  siemExportCursors      SiemExportCursor[]
  ipAllowlistEntries     IpAllowlistEntry[]
  ssoConnections         SsoConnection[]
  ssoDomainVerifications SsoDomainVerification[]
  securitySettings       SecuritySettings[]
  inboxSettings          InboxSettings[]
  widgetSettings         WidgetSettings[]
  appInstallations       AppInstallation[]
  kbCategories           KbCategory[]
  kbArticles             KbArticle[]
  kbSettings             KbSettings?
  workSchedules          WorkSchedule[]
  presenceEvents         AgentPresenceEvent[]
  scheduledReports       ScheduledReport[]
  scheduledReportRuns    ScheduledReportRun[]
  reportShareLinks       ReportShareLink[]
  chatSupervisions       ChatSupervision[]
  goalAchievements       GoalAchievement[]
  salesTrackerSettings   SalesTrackerSettings?
  appearanceSettings     WorkspaceAppearanceSettings?
  trackedSales           TrackedSale[]
  slaPolicy              SlaPolicy?
  slaBreaches            SlaBreach[]
  bots                   Bot[]
  botRules               BotRule[]
  botGroups              BotGroup[]

  memberTokenKey            MemberTokenKey?
  memberTokenRevocations    MemberTokenRevocation[]
  memberRecognitionSettings MemberRecognitionSettings?

  invitations Invitation[]

  /// Platform-side rows about this workspace (tm 389.1). The tenant role cannot
  /// read any of them; they are listed here only because they reference it.
  platformNotes          PlatformNote[]
  platformImpersonations PlatformImpersonationSession[]
  platformCredits        PlatformCredit[]
  /// The platform's override of the plan (tm 389.2) — readable here, written
  /// only by the platform.
  override               LicenseOverride?

  @@index([organizationId])
  @@map("licenses")
}

/// A person. One account can be a member of many licenses.
model Account {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  name         String
  avatarUrl    String?   @map("avatar_url")
  /// scrypt (RFC 7914). Null for accounts that only sign in via SSO.
  passwordHash String?   @map("password_hash")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When somebody proved this address (tm 257.7). Null for an owner who signed
  /// up while `SIGNUP_EMAIL_VERIFICATION=true`, and for an account an invitation
  /// link created (tm 282), until the link mailed to the address is opened with
  /// the password; SSO, SCIM and the seed are verified by this default.
  emailVerifiedAt DateTime? @default(now()) @map("email_verified_at") @db.Timestamptz(6)
  /// Set by the root panel (tm 389.11): no sign-in, no token, no socket in any
  /// workspace until it is lifted; the memberships stay. The platform's alone —
  /// a trigger refuses the tenant role a change to either column.
  platformSuspendedAt     DateTime? @map("platform_suspended_at") @db.Timestamptz(6)
  platformSuspendedReason String?   @map("platform_suspended_reason")

  memberships        AgentMembership[]
  authorizationCodes OauthAuthorizationCode[]
  refreshTokens      OauthRefreshToken[]
  groupMemberships   GroupAgent[]
  expertise          AgentExpertise[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  invitationsSent    Invitation[]             @relation("InvitationInviter")
  invitationsPending Invitation[]             @relation("InvitationPendingAccount")
  ticketFollows      TicketFollower[]
  workSchedules      WorkSchedule[]
  presenceEvents     AgentPresenceEvent[]
  supervisions       ChatSupervision[]
  twoFactor          AccountTwoFactor?
  recoveryCodes      TwoFactorRecoveryCode[]
  aiUsageAlertsTo    AiUsageAlertRecipient[]
  /// Platform operators who looked at a workspace as this member (tm 389.1).
  platformImpersonations PlatformImpersonationSession[]
  /// The AI suggestions this member made and reviewed (tm 318.1 · AI-23).
  aiSuggestionsMade     AiSuggestion[] @relation("AiSuggestionAuthor")
  aiSuggestionsReviewed AiSuggestion[] @relation("AiSuggestionReviewer")

  @@map("accounts")
}

/// Membership carries the role, availability and routing capacity of an agent
/// within one license. PRD §8.4.
model AgentMembership {
  licenseId            BigInt    @map("license_id")
  agentId              String    @map("agent_id") @db.Uuid
  role                 String
  routingStatus        String    @default("offline") @map("routing_status")
  concurrentChatsLimit Int       @default(6) @map("concurrent_chats_limit")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  /// Per-user, per-license opt-out for the e-mail notification channel (FR-MOD-13.8).
  notifyEmail          Boolean   @default(true) @map("notify_email")
  /// Master switch over the *interruptive* channels below — sound, desktop,
  /// push. Not over `notifyEmail`: e-mail is the fallback for somebody who is
  /// not at a screen, and "stop alerting me now" was never a request to stop
  /// that too (`@siyahtus/types` · `pushAllowed`).
  notifyEnabled        Boolean   @default(true) @map("notify_enabled")
  notifySound          Boolean   @default(true) @map("notify_sound")
  notifyDesktop        Boolean   @default(true) @map("notify_desktop")
  /// Push to this member's registered handsets (FR-MOD-13.7 · read by 13.7-d).
  /// The three above governed a browser and lived in `localStorage` until
  /// 13.7-c; push is chosen by the *server*, so a preference it cannot read is
  /// a preference that does not apply to the one channel reaching a closed
  /// laptop. That is what moved all four onto the membership.
  notifyPush           Boolean   @default(true) @map("notify_push")
  /// Whether the Settings side navigation is shown pinned (FR-MOD-08.1 ·
  /// "Unpin side navigation"). Per user and per license, like the notify_*
  /// columns above, and read by `/agents/me/ui-preferences`.
  settingsNavPinned    Boolean   @default(true) @map("settings_nav_pinned")
  /// This member's own panel font (owner, 2026-10-13; `@siyahtus/types` ·
  /// `PANEL_FONT_PRESETS`). NULL = follow the workspace default. The later of
  /// this and `workspace_appearance_settings.font_preset_set_at` applies.
  fontPreset           String?   @map("font_preset")
  fontPresetSetAt      DateTime? @map("font_preset_set_at") @db.Timestamptz(6)
  /// The language this member reads the panel in (`en` | `tr`, tm 265) — what
  /// mail sent to them later is written in. Recorded by `GET /auth/me`; NULL
  /// (never seen) reads as English.
  locale               String?
  awaitingApproval     Boolean   @default(false) @map("awaiting_approval")
  suspended            Boolean   @default(false) @map("suspended")
  /// Tie-breaker for round-robin assignment (ADR-08 step 4).
  lastAssignedAt       DateTime? @map("last_assigned_at") @db.Timestamptz(6)
  /// The identity provider's own id for this member, when the membership is
  /// managed over SCIM (NFR-S11 · S11-e). On the membership rather than the
  /// account because it is *one* workspace's directory speaking: the same
  /// person may work for another workspace whose IdP calls them something else.
  scimExternalId       String?   @map("scim_external_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license      License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent        Account       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceTokens DeviceToken[]

  @@id([licenseId, agentId])
  /// At most one member per external id. NULLs are distinct in Postgres, so
  /// members who never came from a directory are unaffected.
  @@unique([licenseId, scimExternalId])
  @@index([agentId])
  @@map("agent_memberships")
}

/// Registered OAuth 2.1 application.
model OauthClient {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name")
  /// Null for public clients — OAuth 2.1 requires PKCE instead of a secret.
  secretHash     String?  @map("secret_hash")
  redirectUris   String[] @map("redirect_uris")
  clientType     String   @default("public") @map("client_type")
  scopes         String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorizationCodes OauthAuthorizationCode[]
  refreshTokens      OauthRefreshToken[]

  @@index([organizationId])
  @@map("oauth_clients")
}

/// Single-use authorization code. Stored hashed: a leaked database backup must
/// not hand an attacker live codes.
model OauthAuthorizationCode {
  codeHash            String    @id @map("code_hash")
  clientId            String    @map("client_id")
  accountId           String    @map("account_id") @db.Uuid
  licenseId           BigInt    @map("license_id")
  organizationId      String    @map("organization_id") @db.Uuid
  redirectUri         String    @map("redirect_uri")
  scopes              String[]
  /// PKCE — S256 only. OAuth 2.1 forbids `plain`.
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client  OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

/// Refresh token with rotation lineage.
///
/// `replacedById` records which token superseded this one. Reuse of an already
/// rotated token is the classic signal of a stolen refresh token, so detecting
/// it lets us revoke the whole family rather than just refusing one request.
model OauthRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  clientId       String    @map("client_id")
  accountId      String    @map("account_id") @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  scopes         String[]
  /// All tokens rotated from one original login share a family id.
  familyId       String    @map("family_id") @db.Uuid
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client  OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  license License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([accountId])
  @@map("oauth_refresh_tokens")
}

/// End users who talk to the workspace. Scoped to the organization rather than
/// a license, because a person is the same person across licenses (PRD §8.4).
///
/// Pulled into slice 2 (from slice 3) because `/customer/token` cannot be
/// implemented — or tested — without it.
model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String?
  email          String?   @db.Citext
  /// The username the visitor typed into the widget's pre-chat form — their
  /// handle on the embedding site, unverified, kept as typed.
  username       String?
  /// `lower(btrim(username))`, for search and possible-match lookups — never
  /// an identity key. A STORED generated column in the database
  /// (20261015090000_customer_username_normalized); modelled as a
  /// `dbgenerated` default only so queries can filter on it. NEVER WRITE IT:
  /// Postgres rejects any value for a generated column (`428C9`).
  usernameNormalized String? @default(dbgenerated("lower(btrim(username))")) @map("username_normalized")
  /// The language of the widget this visitor last opened a chat from (WG-02) —
  /// what the transcript e-mail is written in. Null = unknown (never the
  /// widget). `customers_locale_check` holds it to the eight widget languages.
  locale         String?
  phone          String?
  countryCode    String?   @map("country_code") @db.Char(2)
  country        String?
  isLead         Boolean   @default(false) @map("is_lead")
  chatsCount     Int       @default(0) @map("chats_count")
  ticketsCount   Int       @default(0) @map("tickets_count")
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)
  bannedAt       DateTime? @map("banned_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Until when a widget may still trade this customer's bare id for a member
  /// token, once (ID-03 · K4 · tm 287.2): set only on customers that existed
  /// when member tokens arrived (20261016090000_member_adoption), cleared by
  /// that one adoption or by a revocation. NULL — every customer created since —
  /// means the id alone never reaches this record.
  memberAdoptableUntil DateTime? @map("member_adoptable_until") @db.Timestamptz(6)
  /// When the member last passed the widget's human check (tm 339.2 · GV-01);
  /// a pass spares them another for `CHALLENGE_PASS_TTL_HOURS`. NULL: never.
  challengePassedAt    DateTime? @map("challenge_passed_at") @db.Timestamptz(6)

  chats             Chat[]
  tickets           Ticket[]
  visits            Visit[]
  channelIdentities ChannelIdentity[]
  campaignSends     CampaignSend[]
  customFieldValues CustomFieldValue[]
  goalAchievements  GoalAchievement[]
  trackedSales      TrackedSale[]
  aiDecisionLogs    AiDecisionLog[]
  riskFlags         RiskFlag[]
  aiCustomerDailyUsage AiCustomerDailyUsage[]

  memberTokenRevocations MemberTokenRevocation[]
  identityLinksAsA       CustomerIdentityLink[]  @relation("IdentityLinkA")
  identityLinksAsB       CustomerIdentityLink[]  @relation("IdentityLinkB")

  @@index([organizationId, lastActivityAt(sort: Desc)])
  @@index([organizationId, email])
  /// Serves the Contacts filter panel's country condition (FR-MOD-03.2.1) —
  /// an equality lookup, not a pattern match, so a plain composite index can
  /// carry it. `country_code` is written and matched upper-case only (the
  /// same normalisation `routing-service.ts` already applies), which is what
  /// keeps this a plain `=` rather than a case-insensitive one no plain btree
  /// index can serve.
  @@index([organizationId, countryCode])
  /// Not modelled: `customers_organization_id_username_normalized_idx` on
  /// `(organization_id, username_normalized) WHERE username_normalized IS NOT
  /// NULL` (20261015090100) — equality on the folded username, reachable under
  /// RLS. Prisma cannot express the WHERE, so `scripts/check-drift.ts` allows
  /// it by name.
  @@map("customers")
}

/// Origins allowed to embed the widget and mint customer tokens (NFR-S6).
///
/// Ships with the endpoint it protects rather than being added later: an
/// allowlist retrofitted after integrators depend on the open behaviour is a
/// breaking change nobody wants to make.
model TrustedDomain {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  licenseId         BigInt   @map("license_id")
  /// Hostname only, lowercase, no scheme or port, e.g. `shop.example.com`.
  domain            String
  /// Also allow `*.domain`. Never permits a bare public suffix.
  includeSubdomains Boolean  @default(false) @map("include_subdomains")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, domain])
  @@index([licenseId])
  @@map("trusted_domains")
}

// ---------------------------------------------------------------------------
// Member recognition (SiyahTuş analysis ID-03 · owner decision K4 · tm 287.1).
// A returning visitor is recognised by a member token the server signs and the
// widget keeps, never by the bare `customer_id` — see
// docs/adr/member-recognition.md. The CHECKs and RLS policies live in
// 20261015180000_member_recognition; Prisma models none of them.
// ---------------------------------------------------------------------------

/// A licence's member-token signing key. One row per licence, created by the
/// first mint. `keyCiphertext` is AES-256-GCM (`lib/credential-cipher.ts`
/// format), bound to this licence and version by its additional data, under a
/// key-encryption key from the deployment's environment — the database alone
/// signs nothing. A rotation keeps the replaced key in `previous*` until
/// `previousKeyValidUntil` (all three or none; one slot). Never deleted by the
/// application role.
model MemberTokenKey {
  licenseId             BigInt    @id @map("license_id")
  /// The version a token names as its signer; 1 for the first key.
  keyVersion            Int       @map("key_version")
  keyCiphertext         String    @map("key_ciphertext")
  keyCreatedAt          DateTime  @default(now()) @map("key_created_at") @db.Timestamptz(6)
  previousKeyVersion    Int?      @map("previous_key_version")
  previousKeyCiphertext String?   @map("previous_key_ciphertext")
  previousKeyValidUntil DateTime? @map("previous_key_valid_until") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("member_token_keys")
}

/// The member-token revocation list. Tokens are signed, not stored, so a row
/// revokes by issue time: every token this licence issued before `revokedAt`
/// for `customerId` — or for every member when `customerId` is null (bulk) —
/// is refused. Append-only for the application role.
model MemberTokenRevocation {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  customerId String?  @map("customer_id") @db.Uuid
  revokedAt  DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)
  /// The account that revoked, null for the system. No FK: the audit trail is
  /// the record of who did what.
  revokedBy  String?  @map("revoked_by") @db.Uuid

  license  License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([licenseId, customerId, revokedAt])
  @@map("member_token_revocations")
}

/// Settings › Security › "Member recognition". A licence singleton, not a brand
/// one: the token and its key are the licence's, and a member is the same
/// person on every brand's site. No row until the first save; a read with no
/// row gets these defaults (`@siyahtus/types` `MEMBER_TOKEN_TTL`).
model MemberRecognitionSettings {
  licenseId              BigInt   @id @map("license_id")
  /// How long a token lives without a visit — sliding, every mint re-signs it.
  /// 1–365 days (`member_recognition_settings_ttl_check`).
  tokenTtlSeconds        Int      @default(2592000) @map("token_ttl_seconds")
  /// Whether agents see possible matches: other customers with the same
  /// pre-chat username or e-mail, unverified.
  possibleMatchesEnabled Boolean  @default(true) @map("possible_matches_enabled")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("member_recognition_settings")
}

/// An agent's confirmation that two customer records are the same person —
/// how a member from another device is joined to their earlier record. Joins
/// the agent's history view only: the day's conversation and the AI's memory
/// stay keyed by the customer number. Organization-scoped like `Customer`; one
/// row per pair in canonical order (`customerAId < customerBId`, which also
/// refuses a self-link); unlinking stamps `unlinkedAt` + `unlinkedBy` (both or
/// neither) and a relink clears them. The RLS policy refuses a row whose two
/// customers are not both in the caller's organization.
model CustomerIdentityLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerAId    String    @map("customer_a_id") @db.Uuid
  customerBId    String    @map("customer_b_id") @db.Uuid
  /// Account ids, no FK — the audit trail records who did what.
  linkedBy       String    @map("linked_by") @db.Uuid
  linkedAt       DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedBy     String?   @map("unlinked_by") @db.Uuid
  unlinkedAt     DateTime? @map("unlinked_at") @db.Timestamptz(6)

  customerA Customer @relation("IdentityLinkA", fields: [customerAId], references: [id], onDelete: Cascade)
  customerB Customer @relation("IdentityLinkB", fields: [customerBId], references: [id], onDelete: Cascade)

  @@unique([customerAId, customerBId])
  @@index([customerBId])
  @@map("customer_identity_links")
}

/// IP addresses and CIDR ranges permitted to reach the agent/admin panel
/// (FR-MOD-08.9.6). The allow-side counterpart to `SecuritySettings`
/// `banned_customer_ips` (a deny-list on the customer/widget surface,
/// FR-MOD-08.9.2): here a license lists the sources it trusts for its own staff.
///
/// An entry is a single IPv4/IPv6 address or a CIDR range in canonical form; a
/// record is unique per (license, entry). CIDR/IP matching (08.9.6-c) and
/// enforcement (08.9.6-e) live elsewhere — this model is only the storage, closed
/// to its tenant by the RLS policy in the migration.
model IpAllowlistEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  licenseId      BigInt   @map("license_id")
  /// A single IPv4/IPv6 address or a CIDR range, canonical form.
  entry          String
  /// Optional human label, e.g. `Office VPN`.
  label          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, entry])
  @@index([licenseId])
  @@map("ip_allowlist_entries")
}

/// A SAML 2.0 identity provider a license federates sign-in to (NFR-S11).
///
/// Storage only at this stage: nothing reads this to authenticate anyone. The
/// write surface is S11-a2, assertion validation S11-b, the SP endpoints S11-d.
/// Closed to its tenant by the RLS policy in the migration.
///
/// `idpCertificatePem` is the IdP's *public* signing certificate, so it is
/// stored as it arrives — not hashed, not encrypted. Hashing it would make the
/// one operation this feature actually performs on it (verifying an assertion
/// signature) impossible, and there is nothing to protect: the same bytes are
/// published in the IdP's own metadata. The secret in this feature is the SCIM
/// bearer token (S11-e), which is hashed.
model SsoConnection {
  id                           String    @id @default(uuid()) @db.Uuid
  licenseId                    BigInt    @map("license_id")
  /// Human label for the connection, e.g. `Okta (corp)`.
  name                         String
  /// The IdP's SAML EntityID — what an assertion's `Issuer` must equal.
  idpEntityId                  String    @map("idp_entity_id")
  /// Absolute `http(s)` URL an AuthnRequest is sent to (HTTP-Redirect binding).
  idpSsoUrl                    String    @map("idp_sso_url")
  /// PEM-encoded X.509 signing certificate published by the IdP.
  idpCertificatePem            String    @map("idp_certificate_pem")
  /// The certificate this connection was rotated away from, kept trusted until
  /// `previousCertificateExpiresAt` so an IdP key roll does not black out
  /// sign-in while the IdP is still signing with the old key. Null unless the
  /// rotation asked for an overlap — replacing a certificate revokes the old one
  /// at commit by default, because the rotation that matters most is the one
  /// answering a compromise. Read through `activePreviousCertificate`, never
  /// directly: a lapsed overlap must read as no overlap.
  previousCertificatePem       String?   @map("previous_certificate_pem")
  previousCertificateExpiresAt DateTime? @map("previous_certificate_expires_at") @db.Timestamptz(6)
  /// Which assertion attribute fills which account field; see
  /// `SSO_ATTRIBUTE_MAPPING_KEYS`. `{}` means the connection said nothing.
  attributeMapping             Json      @default("{}") @map("attribute_mapping")
  /// The e-mail domains this identity provider has been declared authoritative
  /// for. Just-in-time provisioning — SAML sign-in and the workspace's SCIM
  /// connector alike — may only name addresses inside them, so an IdP cannot
  /// adopt a stranger's account or squat an address that never signed up
  /// (PLAN §D116). Stored lowercase and matched exactly, never by suffix: a
  /// workspace that verified `acme.test` has said nothing about
  /// `mail.acme.test`. An empty list provisions nobody — "nothing verified"
  /// must not read as "everything verified", which is why the migration
  /// back-fills existing rows from their members' own domains instead of
  /// treating empty as open.
  ///
  /// This is the list the workspace *claims*, not the list provisioning reads
  /// (PLAN §D134). A claim only counts once its `SsoDomainVerification` row
  /// carries a `verifiedAt`; the two are kept in step by a trigger, so adding a
  /// domain here opens a pending proof and removing one destroys it.
  verifiedDomains              String[]  @default([]) @map("verified_domains")
  /// Accept an assertion sent with no AuthnRequest of ours to correlate it
  /// against. Off by default — that flow gives up the `InResponseTo` binding
  /// replay detection rests on, so it is chosen, never inherited.
  allowIdpInitiated            Boolean   @default(false) @map("allow_idp_initiated")
  /// Whether sign-in through this connection is live. Off until configured, so
  /// a half-written row can never become a way in.
  enabled                      Boolean   @default(false) @map("enabled")
  /// Make this connection the *only* way in: password sign-in is refused for
  /// the license while this is set and `enabled` is too (NFR-S11 · S11-h). Read
  /// as the pair, never alone — a disabled connection enforces nothing, which is
  /// how a workspace recovers when its IdP stops answering. The owner keeps a
  /// password door either way (§C-A17.7), and it cannot be switched on unless
  /// somebody still holds a key to it.
  enforced                     Boolean   @default(false) @map("enforced")
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  license             License                 @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  domainVerifications SsoDomainVerification[]

  /// One connection per IdP within a license. Two rows for one EntityID would
  /// make "which connection issued this assertion?" ambiguous exactly where the
  /// answer decides whose certificate verifies it. Its index also serves every
  /// read this table has — "the connections of this license" — so there is no
  /// separate `@@index([licenseId])`.
  @@unique([licenseId, idpEntityId])
  @@map("sso_connections")
}

/// Proof that a workspace controls one of the domains its SSO connection claims
/// (NFR-S11 · PLAN §D134).
///
/// `SsoConnection.verifiedDomains` is a list the workspace writes about itself,
/// so on its own it proves nothing: the threat actor in §D116 MEDIUM (a) is the
/// workspace's own owner, and the write surface being `exactRole: 'owner'` does
/// not constrain them. This row is where the claim becomes a fact — a token
/// mailed to a reserved mailbox at the domain (`postmaster@`, `admin@`,
/// `administrator@`, `hostmaster@`, `webmaster@`) and returned through the API.
///
/// Only a row with `verifiedAt` takes part in just-in-time provisioning, and the
/// resolvers intersect it with the claim list, so a proof that outlived its
/// claim provisions nobody. Rows are created and destroyed by a trigger on the
/// connection, never by a route: a rule a caller has to remember is a rule some
/// later caller will not.
model SsoDomainVerification {
  id               String    @id @default(uuid()) @db.Uuid
  connectionId     String    @map("connection_id") @db.Uuid
  /// Denormalised from the connection so this table carries the same ordinary
  /// tenant policy as every other one, rather than reaching through a join.
  licenseId        BigInt    @map("license_id")
  /// Normalised exactly as `readVerifiedDomain` produces it — lowercase, no
  /// trailing dot — because it is compared with plain equality against both the
  /// claim list and the domain half of an asserted address.
  domain           String
  /// SHA-256 of the challenge token, never the token. Null before the first
  /// challenge and again after a successful one: a spent secret left in the row
  /// is a secret waiting to be replayed.
  tokenHash        String?   @map("token_hash")
  /// The address the challenge went to, so the screen can say where to look.
  challengeMailbox String?   @map("challenge_mailbox")
  challengeSentAt  DateTime? @map("challenge_sent_at") @db.Timestamptz(6)
  /// When the token came back. Null means claimed but unproved — inert.
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  license    License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// One proof per domain per connection; also the only read this table has.
  @@unique([connectionId, domain])
  @@map("sso_domain_verifications")
}

/// Bearer credentials: OAuth access tokens, personal access tokens and bot
/// tokens. Only the hash is stored — the plaintext is shown once, at creation.
model ApiToken {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  /// Account uuid for pat/oauth/enrollment; bot id for bot tokens. A scim token
  /// records the admin who minted it, and is deliberately never resolved
  /// through that membership — see `token-service.ts`.
  ownerId        String    @map("owner_id")
  kind           String
  tokenHash      String    @unique @map("token_hash")
  /// Human label, for the PAT management screen.
  name           String?
  scopes         String[]  @default([])
  clientId       String?   @map("client_id")
  /// Ties an access token to the refresh family that minted it, so revoking a
  /// family also kills its access tokens.
  familyId       String?   @map("family_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// The platform session an `impersonation` token was traded for (tm 389.2),
  /// and set on no other kind (`api_tokens_impersonation_session_check`).
  /// Minted only by `auth_consume_impersonation_handoff`; the session's end
  /// and window bound the token in `auth_resolve_token`.
  impersonationSessionId String? @map("impersonation_session_id") @db.Uuid

  license              License                       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  impersonationSession PlatformImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: Cascade)

  @@index([licenseId, kind])
  @@index([ownerId])
  @@index([familyId])
  @@index([impersonationSessionId])
  @@map("api_tokens")
}

/// A handset that has asked to receive this member's push notifications
/// (FR-MOD-13.7 · 13.7-c). Registration and revocation are 13.7-c; sending is
/// 13.7-d.
///
/// **`token` is stored in plain text, and it is the one credential here that
/// cannot be hashed.** `ApiToken` above hashes because the only operation ever
/// performed on it is *comparison* — a caller presents a token and the server
/// asks "is this the one?". A push token is the opposite: nobody presents it,
/// the server has to hand the literal bytes to APNs/FCM to address a device, so
/// a digest would make the column useless for its only purpose. The decision is
/// recorded as an assumption in PLAN §C; what it buys instead of hashing is
/// four narrower guarantees, each enforced somewhere a careless caller cannot
/// undo it:
///
///   1. The column is never in a response — reads return id, platform and last
///      seen, and nothing else (`routes/notifications.ts`).
///   2. It is never in an audit entry — the writers here pass an id and a
///      platform, and `sanitizeAuditMetadata` would strip a `token` key anyway.
///   3. It is never in a log line — `req.body.token` is on the server's pino
///      redaction list, which is why the request field is named `token`.
///   4. RLS is as tight as `api_tokens`', and the row is reachable only through
///      the membership it belongs to (below).
///
/// The foreign key is composite — `(license_id, account_id)` into
/// `agent_memberships` — rather than a plain account reference, and that is a
/// tenant guard, not tidiness. A device belongs to a *person in a workspace*: if
/// the row pointed at an account alone, a membership that was removed would
/// leave a live delivery target for a workspace the person no longer works for,
/// and the cascade is what makes "took them off the team" also mean "their
/// phone stops buzzing".
model DeviceToken {
  id         String    @id @default(uuid()) @db.Uuid
  licenseId  BigInt    @map("license_id")
  accountId  String    @map("account_id") @db.Uuid
  /// 'ios' | 'android' — constrained in the database (see the migration).
  platform   String
  /// The APNs/FCM delivery address for this handset. Never returned, logged or
  /// audited. See the note above for why it is not hashed.
  token      String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Refreshed every time the app re-registers, so a workspace can tell a live
  /// handset from one reinstalled onto somebody else's phone a year ago.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Set rather than deleted, so a revoked device is still evidence that the
  /// delivery target existed — the same reason `api_tokens` keeps a revoked row.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership AgentMembership @relation(fields: [licenseId, accountId], references: [licenseId, agentId], onDelete: Cascade)

  /// One row per (workspace, token): re-registering the same handset updates the
  /// row instead of adding a second one, which is what stops a device that
  /// launches daily from accumulating a year of duplicates and being sent the
  /// same message once per launch. Scoped to the license rather than global on
  /// purpose — a global unique index would answer "is this token registered
  /// somewhere else?" to a caller who is not allowed to know that.
  @@unique([licenseId, token])
  /// The sender's only question: which live devices does this member have?
  @@index([licenseId, accountId, revokedAt])
  @@map("device_tokens")
}

// ===========================================================================
// Teams
// ===========================================================================

/// Departments / chatting teams. PRD §8.4 gives groups a per-license integer id
/// rather than a uuid, so the primary key is composite.
model Group {
  id             BigInt   @default(autoincrement())
  licenseId      BigInt   @map("license_id")
  name           String
  languageCode   String   @default("en") @map("language_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The topic this team's queue is for (AU-01 · K14 · tm 305.1): one of
  /// `QUEUE_TOPIC_ROLES` (`@siyahtus/types`), enforced by the CHECK
  /// `groups_topic_role_check`; at most one team per licence holds a role (the
  /// partial unique index `groups_license_id_topic_role_key`, hand-written in
  /// the migration). Null for an ordinary team.
  topicRole      String?  @map("topic_role")
  /// What the team's queue does when nobody is on shift: one of
  /// `AFTER_HOURS_MODES`, enforced by `groups_after_hours_mode_check`.
  afterHoursMode String   @default("queue") @map("after_hours_mode")

  license           License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agents            GroupAgent[]
  bots              BotGroup[]
  requiredExpertise GroupExpertise[]
  invitations       InvitationGroup[]

  @@id([licenseId, id])
  @@map("groups")
}

/// Membership of an agent in a team, with the routing preference that decides
/// who gets offered a chat first (ADR-08 step 2).
model GroupAgent {
  licenseId BigInt  @map("license_id")
  groupId   BigInt  @map("group_id")
  agentId   String  @map("agent_id") @db.Uuid
  priority  String  @default("normal")
  /// Whether this member leads the team (RL-01 · tm 324.1). A lead is a member
  /// too, offered the team's chats like anyone in it; one person may lead
  /// several teams (RL-01-S2). "Which teams does this person lead" is the
  /// partial index `group_agents_lead_agent_id_idx`, hand-written in the
  /// migration (Prisma cannot spell its WHERE).
  isLead    Boolean @default(false) @map("is_lead")

  group Group   @relation(fields: [licenseId, groupId], references: [licenseId, id], onDelete: Cascade)
  agent Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, groupId, agentId])
  @@index([agentId])
  @@map("group_agents")
}

// ===========================================================================
// Agent expertise (skill-based routing — FR-MOD-08.6.3)
// ===========================================================================

/// An area of expertise an agent can carry, the catalogue "expertise/skill
/// based" routing draws on (08.6.3-c). Named `expertise` at the data layer
/// because `skills` is already the AI-automation Skill (ADR-14, a wholly
/// different concept). License-scoped with a Group-style composite key, so an
/// id is a small per-license integer the routing UI can show, and a slug is
/// unique within a license.
model Expertise {
  id        BigInt   @default(autoincrement())
  licenseId BigInt   @map("license_id")
  name      String
  slug      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agents  AgentExpertise[]
  groups  GroupExpertise[]

  @@id([licenseId, id])
  @@unique([licenseId, slug])
  @@map("expertise")
}

/// The tie between an agent and an area of expertise — the row routing reads to
/// decide who is qualified for a chat. Composite key mirrors group_agents; the
/// license flows in through the expertise relation, and the agent index serves
/// the "what is this agent good at" lookup.
model AgentExpertise {
  licenseId   BigInt @map("license_id")
  agentId     String @map("agent_id") @db.Uuid
  expertiseId BigInt @map("expertise_id")

  expertise Expertise @relation(fields: [licenseId, expertiseId], references: [licenseId, id], onDelete: Cascade)
  agent     Account   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, agentId, expertiseId])
  @@index([agentId])
  @@map("agent_expertise")
}

/// An area of expertise a team requires of the agents it gives conversations
/// to (AU-01 · tm 305.1) — every one of a team's rows, not any. `agent_expertise`
/// says what an agent holds; this says what a team's queue needs, so routing
/// and draining can ask the same question of every team (ADR-08a §2.2) and the
/// Responsible Gambling team admits only trained agents (§2.6). Rows go with
/// the team or the area (cascade); a set is replaced, never edited. The second
/// index serves the cascade from `expertise` and "which teams need this area".
model GroupExpertise {
  licenseId   BigInt @map("license_id")
  groupId     BigInt @map("group_id")
  expertiseId BigInt @map("expertise_id")

  group     Group     @relation(fields: [licenseId, groupId], references: [licenseId, id], onDelete: Cascade)
  expertise Expertise @relation(fields: [licenseId, expertiseId], references: [licenseId, id], onDelete: Cascade)

  @@id([licenseId, groupId, expertiseId])
  @@index([licenseId, expertiseId])
  @@map("group_expertise")
}

// ===========================================================================
// Conversation core: chat → thread → event
// ===========================================================================

/// The member's conversation container ("Thread ID" in the panel). Threads
/// ("Chat ID", one connection each) come and go inside it; the chat itself
/// persists, which is what makes "resume" meaningful.
///
/// A partial unique index (in the migration) enforces at most one *active* chat
/// per license+customer — the invariant the whole inbox model rests on.
///
/// ID-02 (tm 286) files a chat under one conversation day: `localDay` +
/// `dayTz`, written together once when the chat opens and never recomputed.
/// Not modelled here: `uq_chat_customer_day` on `(license_id, customer_id,
/// local_day) WHERE local_day IS NOT NULL` — one chat per member per day
/// (20261015160100_chats_customer_day_index; Prisma cannot express the WHERE)
/// — and the CHECKs `chats_local_day_tz_pair` / `chats_day_tz_check`
/// (20261015160000_conversation_day). A chat opened before ID-02 has neither
/// column and spans the whole relationship, as every chat did before.
model Chat {
  id          String    @id @db.VarChar(12)
  licenseId   BigInt    @map("license_id")
  customerId  String    @map("customer_id") @db.Uuid
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When this conversation last moved — the `created_at` of its newest event,
  /// or its own creation time while it has none. This is the inbox list's sort
  /// key (FR-MOD-02.2.2 "RTM'de yukarı taşınır"), maintained on the write path
  /// rather than derived per read so the order is one index range scan.
  lastEventAt DateTime  @default(now()) @map("last_event_at") @db.Timestamptz(6)
  /// The conversation day (`localDayKey`, `@siyahtus/types`) in the workspace's
  /// day boundary at opening. Null = filed under no day (opened before ID-02).
  localDay    DateTime? @map("local_day") @db.Date
  /// The IANA zone `localDay` was counted in — the boundary may change later.
  dayTz       String?   @map("day_tz")
  /// The brand the member came in through (tm 309.1 · AI-14): the website the
  /// widget's token was minted for (WG-01 `resolveWidgetBrandId`), written
  /// when the chat opens; an agent reopening an earlier day carries that day's.
  /// Null when unknown — a channel, an agent's start, a token without a brand
  /// — and from the moment a later connection the same day comes in through
  /// another brand's site or an unknown one (`ChatService` `#keepChatBrand`),
  /// so one brand's knowledge never answers another brand's member. A label
  /// read by the knowledge filter (tm 309.2), not a scope: RLS stays per
  /// licence and no inbox narrows on it. Soft, like
  /// `knowledge_sources.brand_ids` — a deleted brand leaves its id behind.
  brandId     String?   @map("brand_id") @db.Uuid

  license          License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  threads          Thread[]
  users            ChatUser[]
  access           ChatAccess[]
  supervisions     ChatSupervision[]
  ratings          Rating[]
  tickets          Ticket[]
  skillRuns        SkillRun[]
  goalAchievements GoalAchievement[]
  trackedSales     TrackedSale[]
  aiDecisionLogs   AiDecisionLog[]
  aiGuardrailHits  AiGuardrailHit[]
  riskFlags        RiskFlag[]
  aiHandoffs       AiHandoff[]
  aiJobs           AiJob[]
  aiUnresolved     AiUnresolvedItem[]
  aiSuggestions    AiSuggestion[]

  @@index([licenseId, createdAt(sort: Desc)])
  /// The inbox list's ordering index. Kept beside the `created_at` one rather
  /// than replacing it: reports and the customer-facing lists still order a
  /// workspace's chats by when they opened.
  @@index([licenseId, lastEventAt(sort: Desc)])
  @@index([customerId])
  @@map("chats")
}

/// One continuous exchange within a chat. Closing a thread archives it; the
/// customer coming back opens a new thread on the same chat.
model Thread {
  id               String    @id @db.VarChar(12)
  chatId           String    @map("chat_id") @db.VarChar(12)
  licenseId        BigInt    @map("license_id")
  active           Boolean   @default(true)
  /// Null once assigned; set while waiting in the routing queue.
  queuePosition    Int?      @map("queue_position")
  queuedAt         DateTime? @map("queued_at") @db.Timestamptz(6)
  /// Agent currently responsible. Null means unassigned or queued.
  assigneeId       String?   @map("assignee_id") @db.Uuid
  summary          String?
  summaryUpdatedAt DateTime? @map("summary_updated_at") @db.Timestamptz(6)
  /// Monotonic per-thread event counter. Event ids are derived from it, which
  /// is what makes "everything after event N" answerable without timestamps.
  eventSequence    Int       @default(0) @map("event_sequence")
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)
  /// How this connection came to exist (ID-02): one of `CONNECTION_OPENED_VIA`
  /// (`@siyahtus/types`), enforced by the CHECK `threads_opened_via_check`.
  /// Null on a thread opened before ID-02.
  openedVia        String?   @map("opened_via")
  /// The team this connection went to (ID-02 · tm 286.3): routing's choice,
  /// the team it was opened in, or the one a transfer handed it to. Null for
  /// no single team, and on threads opened before it was recorded. No relation
  /// on purpose — the `chat_access.group_id` rule: a deleted team must not
  /// erase the record of what it handled (20261015170000_thread_group).
  groupId          BigInt?   @map("group_id")
  /// Who answers the connection (AI-11 · tm 293.1): one of
  /// `AI_CONVERSATION_MODES` (`@siyahtus/types`), enforced by the CHECK
  /// `threads_ai_mode_check`. Null until the AI or a person takes part — the
  /// AI may still answer. Written only by `services/chat/ai-mode.ts`.
  aiMode           String?   @map("ai_mode")
  /// The team whose queue the connection waits in (ADR-08a §2.1 · tm 305.1):
  /// a connection is in one team's queue at a time, and positions, renumbering
  /// and draining go team by team. Read only while `queuePosition` is set.
  /// Not `groupId`: that one records who handled the connection. No relation,
  /// the `groupId` rule — a deleted team must not erase or block the row. Null
  /// on a connection queued before tm 305 that the backfill
  /// (20261020120100_threads_queue_group_backfill) found no team for.
  queueGroupId     BigInt?   @map("queue_group_id")
  /// How pressing the connection is, as its rank: `THREAD_PRIORITY_RANK`
  /// (`@siyahtus/types`) — 0 normal, 1 high, 2 urgent — enforced by the CHECK
  /// `threads_priority_check`. A rank rather than the word, so a queue orders
  /// by `priority DESC` (ADR-08a §2.3).
  priority         Int       @default(0) @db.SmallInt
  /// Why the priority was raised (AI-12 · tm 307): the `HANDOFF_REASONS` code
  /// of the hand-over that raised it, written with it; null while nothing
  /// has. Shape by the CHECK `threads_priority_reason_check`.
  priorityReason   String?   @map("priority_reason")
  /// The expertise whoever takes the connection must hold (AI-12 · tm 307.2):
  /// the AI's hand-over route's, read by the queue drain while it waits. A soft
  /// reference to `expertise.id` — one deleted later is held by nobody, so the
  /// connection waits rather than reach an untrained agent. Null: the team's
  /// own requirement alone (`group_expertise`).
  requiredExpertiseId BigInt? @map("required_expertise_id")
  /// Who answered the connection (AR-01 · tm 335.1): one of `THREAD_HANDLED_BY`
  /// (`@siyahtus/types`), enforced by the CHECK `threads_handled_by_check`.
  /// Written once, in the transaction that closes the thread, from ADR-09a's
  /// predicate (`services/billing/ai-resolution.ts` `handledBySql`) — `ai` is
  /// exactly the invoice's AI resolution. Null while open, and on a thread
  /// closed before the column existed.
  handledBy        String?   @map("handled_by")
  /// The agents who wrote to the player in the connection (AR-02 · tm 336.1),
  /// internal notes not counted — the archive's agent filter. Written once,
  /// with `handledBy`, in the transaction that closes the thread
  /// (`services/archive/archive-filters.ts` `agentIdsSql`); null while open.
  agentIds         String[]  @map("agent_ids") @db.Uuid
  /// The risk flag types raised in the connection, cleared ones included
  /// (AR-02 · tm 336.1) — the archive's risk filter. Kept by the trigger
  /// `risk_flags_after_insert` as a flag is raised.
  riskFlagTypes    String[]  @default([]) @map("risk_flags")
  /// When the current assignee was given the connection (WG-03 · tm 340.1):
  /// the inactivity sweep's clock for "assigned and not answered yet". Kept by
  /// the trigger `threads_assigned_at` — any write that changes `assignee_id`
  /// stamps it with the database clock (or clears it with the assignee) unless
  /// the same write sets it — and moved to the hand-over moment when the AI
  /// hands a connection to the agent who already holds it. Null while nobody
  /// holds it, and on a connection assigned before the column existed.
  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz(6)
  /// Since when the connection is inactive (WG-03): quiet for the workspace's
  /// `inactive_after_seconds`, so it leaves its agent's concurrent limit. Null
  /// while it is lively; the next event clears it.
  inactiveSince    DateTime? @map("inactive_since") @db.Timestamptz(6)
  /// How many times the sweep took the connection from an agent who did not
  /// answer (reason `agent_unresponsive`) — capped by the sweep, so it cannot
  /// bounce between silent agents forever. CHECK `>= 0` in the migration.
  unresponsiveTransfers Int  @default(0) @map("unresponsive_transfers") @db.SmallInt

  chat            Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tags            ThreadTag[]
  events          Event[]
  skillRuns       SkillRun[]
  aiDecisionLogs  AiDecisionLog[]
  aiGuardrailHits AiGuardrailHit[]
  riskFlags       RiskFlag[]
  aiHandoffs      AiHandoff[]
  aiJobs          AiJob[]
  aiUnresolved    AiUnresolvedItem[]
  queueEntries    QueueEntry[]
  aiConversations AiConversation[]

  @@index([chatId, createdAt])
  @@index([licenseId, active, createdAt(sort: Desc)])
  @@index([assigneeId])
  @@index([licenseId, active, aiMode])
  /// The archive (AR-01 · tm 335.1): connections by when they started, and by
  /// when they ended — the list's default order, open ones (NULL) first. Each
  /// built CONCURRENTLY in its own migration.
  @@index([licenseId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([licenseId, closedAt(sort: Desc), id(sort: Desc)])
  /// No GIN index on `agent_ids` / `risk_flags` (AR-02 · tm 336.1, PLAN §D350):
  /// `&&` is not leakproof, so under row level security it is never an index
  /// condition — the filters narrow the rows the date and team indexes read.
  @@map("threads")
}

/// One stay of a connection in the routing queue (tm 291 · RP-04, K21).
///
/// `threads.queued_at` is cleared when the connection leaves the queue, so a
/// finished wait lives here instead: a row opens where the connection enters
/// the queue and closes, in the same transaction, where it leaves. A
/// connection may wait more than once (a transfer to another team, WG-03's
/// re-queue), but never twice at once — the partial unique index
/// `queue_entries_thread_open_key` (hand-written in the migration; Prisma has
/// no syntax for it) allows one open row per thread.
model QueueEntry {
  id        String    @id @default(uuid()) @db.Uuid
  licenseId BigInt    @map("license_id")
  threadId  String    @map("thread_id") @db.VarChar(12)
  /// The team it waited for. No relation, the `threads.group_id` rule: a
  /// deleted team must not erase the record of what waited for it.
  groupId   BigInt?   @map("group_id")
  enteredAt DateTime  @map("entered_at") @db.Timestamptz(6)
  /// Null while it still waits; set together with `outcome`.
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  /// One of `QUEUE_ENTRY_OUTCOMES` (`@siyahtus/types`), enforced by
  /// `queue_entries_outcome_check`.
  outcome   String?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([licenseId, enteredAt])
  @@index([threadId])
  @@map("queue_entries")
}

/// Everything that ever happened in a thread.
///
/// Range-partitioned by month in the migration — this is by far the largest
/// table, and partitioning is what keeps list queries, vacuum cost and archival
/// bounded as it grows. Prisma has no syntax for partitioning, so the CREATE
/// TABLE is hand-written; queries are unaffected.
model Event {
  id            String   @db.VarChar(40)
  threadId      String   @map("thread_id") @db.VarChar(12)
  /// Denormalised from the thread so transcript queries need no join.
  chatId        String   @map("chat_id") @db.VarChar(12)
  licenseId     BigInt   @map("license_id")
  type          String
  text          String?
  authorId      String?  @map("author_id")
  authorType    String   @map("author_type")
  /// `all` reaches the customer; `agents` is an internal note.
  recipients    String   @default("all")
  attachmentUrl String?  @map("attachment_url")
  properties    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([threadId, createdAt])
  @@index([chatId, createdAt])
  @@index([licenseId, createdAt])
  /// Reports filter on event properties; GIN turns that from a scan into a lookup.
  @@index([properties(ops: JsonbPathOps)], type: Gin, map: "idx_events_properties")
  /// One column here is missing on purpose, and this is the only place the
  /// schema can say so: `event_sequence BIGINT GENERATED ALWAYS AS
  /// ((split_part(id, '_', 2))::bigint) STORED`, with
  /// `events_thread_id_event_sequence_idx` over `(thread_id, event_sequence)`.
  /// It is the per-thread counter the id already carries, stored so a transcript
  /// page can be driven from an index under row level security (NFR-P6) — the
  /// measurement and the alternatives rejected are in migration
  /// 20260911170000_events_sequence_column. Prisma can express neither a
  /// generated column nor an index over one, so it is allowed by name in
  /// `scripts/check-drift.ts` rather than modelled here; nothing reads or writes
  /// it through the client, only the two raw paging queries.
  ///
  /// Also not modelled: `events_text_search_idx`, a trigram GIN over
  /// `siyahtus_search_fold(text)` `WHERE type = 'message'` — message text
  /// search (ID-07). Created `ON ONLY` the parent; each partition's index is
  /// built `CONCURRENTLY` and attached by `scripts/partition-indexes.ts`.
  /// Prisma has no syntax for an expression or a partial index. Migration
  /// 20261023100000_event_text_search_index.
  @@map("events")
}

/// Who is in a chat, and how much of it they have seen.
model ChatUser {
  chatId   String    @map("chat_id") @db.VarChar(12)
  userId   String    @map("user_id")
  userType String    @map("user_type")
  present  Boolean   @default(true)
  seenUpTo DateTime? @map("seen_up_to") @db.Timestamptz(6)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_users")
}

/// Which teams may see a chat. This is the access control list the inbox
/// filters on — an agent sees a chat only through a group they belong to.
model ChatAccess {
  chatId  String @map("chat_id") @db.VarChar(12)
  groupId BigInt @map("group_id")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, groupId])
  @@index([groupId])
  @@map("chat_access")
}

/// Which agent is watching a chat right now (FR-MOD-13.2 "Supervise").
///
/// Supervising is not assignment: the supervisor reads the conversation without
/// taking it over, so nothing in `threads` records it. Without this table the
/// Traffic board has no source at all for its `supervised` state — the button
/// today only navigates to the inbox and writes nowhere.
///
/// One row per (chat, agent): two supervisors on the same chat are two rows,
/// and the same agent re-opening the same chat updates a row instead of
/// duplicating it. `last_seen_at` is the heartbeat 13.2-d refreshes while the
/// panel is open — a row that has gone stale is a closed tab, not a watcher, so
/// the read side filters on it rather than trusting the row's existence.
///
/// Stored in Postgres rather than Redis presence on purpose (§C): the tenant
/// boundary then rests on an RLS policy the database enforces, and the row is
/// deterministic evidence the DoD gate can assert on.
model ChatSupervision {
  chatId     String   @map("chat_id") @db.VarChar(12)
  agentId    String   @map("agent_id") @db.Uuid
  licenseId  BigInt   @map("license_id")
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([chatId, agentId])
  @@index([licenseId, lastSeenAt(sort: Desc)])
  @@map("chat_supervisions")
}

/// Tags applied to a thread, not a chat: what a conversation was *about* can
/// change between one visit and the next.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  authorId  String?  @map("author_id")
  groupIds  BigInt[] @default([]) @map("group_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  threads ThreadTag[]
  tickets TicketTag[]

  @@unique([licenseId, name])
  @@map("tags")
}

/// A tag applied to a ticket (FR-MOD-08.6.2). Like `thread_tags` it has no
/// license column of its own — it inherits tenant visibility from the ticket it
/// hangs off, and RLS scopes it through that foreign key. Reuses the same `Tag`
/// library the inbox and thread tagging draw on.
model TicketTag {
  ticketId String   @map("ticket_id") @db.VarChar(12)
  tagId    String   @map("tag_id") @db.Uuid
  taggedAt DateTime @default(now()) @map("tagged_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

/// Ticket automation (FR-MOD-08.6.2): a condition plus an action. When a ticket
/// is opened, every enabled rule whose condition matches applies its action —
/// auto-assign, set priority, or tag. Both a condition and an action are
/// required (KK "koşul+eylem zorunlu"); the shapes live in the JSON columns so a
/// new condition or action kind needs no migration. Rules run in `position`
/// order, so a later rule's assignment wins over an earlier one's.
model TicketRule {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  name       String
  conditions Json     @default("{}")
  actions    Json     @default("{}")
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, enabled, position])
  @@map("ticket_rules")
}

/// Branded, variabled ticket e-mail template (FR-MOD-08.7.5): reusable subject +
/// body a workspace authors once, carrying `{{ group.field }}` placeholders
/// filled in per ticket at send time. Both halves are validated against the
/// fixed variable catalogue on every save, so a template can never be stored
/// naming a variable the product cannot fill (KK "Geçersiz değişken/format
/// engeli"). License-scoped like ticket rules; RLS narrows every row to its
/// workspace.
model TicketEmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
  @@map("ticket_email_templates")
}

/// A custom field a workspace has defined on tickets or contacts (FR-MOD-08.7.6):
/// an extra field the product does not ship with — a player id, a KYC status, an
/// account balance. Two properties carry the requirement (KK "Tip/zorunluluk"):
/// `type` decides how a value is validated, `required` whether it may be blank.
/// License-scoped like ticket rules; RLS narrows every row to its workspace. A
/// label is unique per (license, entity) so a field cannot be defined twice.
model CustomFieldDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  /// 'ticket' or 'contact'.
  entity        String
  label         String
  /// 'text' | 'number' | 'boolean' | 'date'.
  type          String
  required      Boolean  @default(false)
  /// Which of the widget's four forms also asks this field (FR-MOD-08.7.7), or
  /// null for a CRM-only field: 'pre_chat' before the conversation starts,
  /// 'post_chat' once it ends, and — on the offline "leave a message" screen —
  /// 'prospect' about the person and 'ticket' about the request. A CHECK in the
  /// migration ties each placement to the entity its answers land on: the first
  /// three to `entity = 'contact'`, 'ticket' to `entity = 'ticket'`.
  formPlacement String?  @map("form_placement")
  /// Show this field as a row-inline column on the Contacts table (FR-MOD-03.2.3)
  /// rather than only in the Details/CRM panel. A CHECK in the migration keeps
  /// this to `entity = 'contact'` — the table has no row to hang a ticket field
  /// off. Defaults false: a newly defined field never widens the table on its own.
  showInTable   Boolean  @default(false) @map("show_in_table")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([licenseId, entity, label])
  @@map("custom_field_definitions")
}

/// A value stored for one custom field on one ticket or one contact
/// (FR-MOD-08.7.6). Exactly one of `ticketId` / `customerId` is set — a CHECK in
/// the migration enforces that — and it points at the entity the definition is
/// for. The value is kept as text in its canonical form (see checkCustomFieldValue
/// in @siyahtus/types); one value per field per entity. Deleting the definition, the
/// ticket or the contact cascades the value away.
model CustomFieldValue {
  id           String   @id @default(uuid()) @db.Uuid
  licenseId    BigInt   @map("license_id")
  definitionId String   @map("definition_id") @db.Uuid
  ticketId     String?  @map("ticket_id") @db.VarChar(12)
  customerId   String?  @map("customer_id") @db.Uuid
  value        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license    License               @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  ticket     Ticket?               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer   Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([definitionId, ticketId])
  @@unique([definitionId, customerId])
  @@index([ticketId])
  @@index([customerId])
  @@map("custom_field_values")
}

model ThreadTag {
  threadId String   @map("thread_id") @db.VarChar(12)
  tagId    String   @map("tag_id") @db.Uuid
  taggedAt DateTime @default(now()) @map("tagged_at") @db.Timestamptz(6)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
  @@map("thread_tags")
}

/// Asynchronous conversations (email and the like), as opposed to live chats.
///
/// The HelpDesk layer (FR-MOD-13.6) adds three things on top of the ticket core:
///   - `priority` — an integer the queue can be worked by; higher is more urgent.
///   - `mergedIntoId` — a self reference. A merge is *non-destructive*: it only
///     points the secondary at its primary, so an unmerge is a clean inverse
///     (clear the pointer) rather than a reconstruction. A merged ticket is
///     folded under its primary and hidden from the lists.
///   - `followers` — agents watching a ticket without owning it.
model Ticket {
  id               String    @id @db.VarChar(12)
  licenseId        BigInt    @map("license_id")
  customerId       String?   @map("customer_id") @db.Uuid
  sourceChatId     String?   @map("source_chat_id") @db.VarChar(12)
  /// The connection (`threads.id`, "Chat ID") the ticket was opened from — the
  /// chat's newest when it was created. No relation on purpose: it records where
  /// the ticket came from and outlives the thread. Null off a chat and before ID-05.
  sourceThreadId   String?   @map("source_thread_id") @db.VarChar(12)
  subject          String
  status           String    @default("open")
  /// Queue priority (FR-MOD-13.6). Higher is more urgent; 0 is the default. A
  /// signed integer rather than an enum so the ordering is the database's, not
  /// a lookup the query has to carry.
  priority         Int       @default(0)
  assigneeId       String?   @map("assignee_id") @db.Uuid
  groupId          BigInt?   @map("group_id")
  /// The primary this ticket was merged into, or null when it stands alone. The
  /// FK is `ON DELETE SET NULL`, and a CHECK in the migration forbids pointing at
  /// itself; "no chains" (a merged ticket cannot itself be a target) is enforced
  /// in the service.
  mergedIntoId     String?   @map("merged_into_id") @db.VarChar(12)
  /// The earlier ticket this one follows on from (HD-03 · tm 358): the player
  /// answered a closed ticket, or one quiet past the reopen window, and the
  /// answer opened this one. `ON DELETE SET NULL`; a CHECK forbids itself.
  relatedTicketId  String?   @map("related_ticket_id") @db.VarChar(12)
  /// The forwarding address this ticket arrived at, or null when it did not
  /// arrive by e-mail (FR-MOD-08.5.3). Read by the addresses list, which reports
  /// each address's own activity — the signal that proves an address works.
  inboundAddressId String?   @map("inbound_address_id") @db.Uuid
  lastMessageAt    DateTime? @map("last_message_at") @db.Timestamptz(6)
  /// When an agent first answered the player (an `agent_reply`, HD-01) — what
  /// the first-response SLA (HD-05) measures. Null until then, never moved once
  /// set.
  firstResponseAt       DateTime? @map("first_response_at") @db.Timestamptz(6)
  /// The player's newest message and the agents' newest reply (HD-01), apart
  /// from `last_message_at`, which any activity moves: "who is waiting on whom"
  /// is the comparison of these two.
  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz(6)
  lastAgentMessageAt    DateTime? @map("last_agent_message_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license           License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceChat        Chat?                @relation(fields: [sourceChatId], references: [id], onDelete: SetNull)
  mergedInto        Ticket?              @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  inboundAddress    InboundEmailAddress? @relation(fields: [inboundAddressId], references: [id], onDelete: SetNull)
  mergedTickets     Ticket[]             @relation("TicketMerge")
  relatedTicket     Ticket?              @relation("TicketRelated", fields: [relatedTicketId], references: [id], onDelete: SetNull)
  followUps         Ticket[]             @relation("TicketRelated")
  followers         TicketFollower[]
  tags              TicketTag[]
  customFieldValues CustomFieldValue[]
  messages          TicketMessage[]

  /// The target of `ticket_messages`' (ticket_id, license_id) foreign key, so a
  /// message cannot point at another workspace's ticket: a foreign key on `id`
  /// alone is checked without RLS and would accept one. `id` leads on purpose —
  /// led by `license_id`, the planner took it over
  /// `tickets_license_customer_idx` for the Contacts `has_tickets` probe.
  @@unique([id, licenseId])
  @@index([licenseId, status, lastMessageAt(sort: Desc)])
  @@index([assigneeId])
  @@index([licenseId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "tickets_license_last_message_idx")
  @@index([licenseId, assigneeId, lastMessageAt(sort: Desc)], map: "tickets_license_assignee_idx")
  @@index([mergedIntoId])
  /// Serves the `ON DELETE SET NULL` of `related_ticket_id` — without it a
  /// ticket's deletion scans the licence's tickets for follow-ups.
  @@index([relatedTicketId], map: "tickets_related_ticket_idx")
  /// Serves the Contacts `has_tickets` filter's per-customer EXISTS check
  /// (FR-MOD-03.2.1) — nothing indexed `customer_id` before this, so that
  /// probe was a sequential scan of the license's tickets per candidate row.
  @@index([licenseId, customerId], map: "tickets_license_customer_idx")
  /// Serves the per-address activity the forwarding-address list reports
  /// (FR-MOD-08.5.3) — without it that aggregate scans the licence's tickets.
  @@index([inboundAddressId], map: "tickets_inbound_address_idx")
  @@map("tickets")
}

/// Agents watching a ticket (FR-MOD-13.6 "followers"). Like `thread_tags` it has
/// no license column of its own — it inherits tenant visibility from the ticket
/// it hangs off, and the RLS policy in the migration scopes it through that FK.
model TicketFollower {
  ticketId  String   @map("ticket_id") @db.VarChar(12)
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([ticketId, accountId])
  @@index([accountId])
  @@map("ticket_followers")
}

/// A ticket's conversation (HD-01 · tm 356): what the player wrote, the agents'
/// replies, internal notes and the product's own lines, oldest first.
///
/// The CHECKs in the migration hold the promises a service must not be able to
/// break by mistake: an internal note carries no delivery status, Message-ID or
/// In-Reply-To — it never becomes e-mail; only a reply has a delivery status;
/// only a player's message keeps (sanitised) HTML. The vocabularies are
/// `TICKET_MESSAGE_KINDS` / `TICKET_MESSAGE_AUTHOR_TYPES` /
/// `TICKET_MESSAGE_DELIVERY_STATUSES` in `@siyahtus/types`.
model TicketMessage {
  id             String   @id @default(uuid()) @db.Uuid
  licenseId      BigInt   @map("license_id")
  ticketId       String   @map("ticket_id") @db.VarChar(12)
  /// customer_message | agent_reply | internal_note | system.
  kind           String
  /// customer | agent | system | bot.
  authorType     String   @map("author_type")
  /// The account for `agent`, the customer for `customer`. No foreign key: it
  /// points into one of two tables, and a message outlives an agent who leaves.
  authorId       String?  @map("author_id") @db.Uuid
  bodyText       String   @map("body_text")
  /// Only on a `customer_message` from e-mail, and only when the quote and the
  /// signature were cut from `body_text`: the whole text, for "show full message".
  bodyTextFull   String?  @map("body_text_full")
  /// Only on a `customer_message`, and only after sanitising at intake.
  bodyHtml       String?  @map("body_html")
  /// [{ key, name, size, mime, scan_status, sensitive }] — `TicketMessageAttachment`.
  attachments    Json     @default("[]")
  /// The RFC 5322 Message-ID — the one a reply was sent under, or the one an
  /// inbound e-mail arrived with. Unique per licence (NULLs are distinct), so a
  /// redelivered e-mail stays one message.
  emailMessageId String?  @map("email_message_id")
  inReplyTo      String?  @map("in_reply_to")
  /// queued | sent | failed | suppressed — only on an `agent_reply`.
  deliveryStatus String?  @map("delivery_status")
  /// The composer's key: the same key on the same licence is one message.
  idempotencyKey String?  @map("idempotency_key")
  /// A player's message that reached the ticket from an address other than its
  /// player's (HD-03 · tm 358) — the console warns. Only on a `customer_message`.
  senderMismatch Boolean  @default(false) @map("sender_mismatch")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ticket  Ticket  @relation(fields: [ticketId, licenseId], references: [id, licenseId], onDelete: Cascade)

  @@unique([licenseId, emailMessageId])
  @@unique([licenseId, idempotencyKey])
  /// The thread, oldest first: keyset on (created_at, id).
  @@index([ticketId, createdAt, id])
  @@map("ticket_messages")
}

/// Password recovery (PRD FR-MOD-00.3). Not in §8.4 — see PLAN §D12.
///
/// Only the hash is stored: a leaked backup of this table must not be a set of
/// working reset links.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("password_reset_tokens")
}

/// A sign-up's "prove this address" link (tm 257.7) — `PasswordResetToken`'s
/// design: only the hash is stored, RLS hides every row from the application
/// role, and the `auth_*` SECURITY DEFINER functions are the only readers.
/// Redeemed with the account's password, never with the token alone.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("email_verification_tokens")
}

/// TOTP secret for two-factor authentication (NFR-S11 · FR-MOD-00.1 ·
/// S11-2FA). One row per account — `agent_memberships.twoFactorEnabled` is
/// the per-membership flag PRD §8.4 actually specifies, kept in sync as a
/// derived copy of `activatedAt` rather than a second source of truth.
///
/// RLS has no permissive policy, same as `PasswordResetToken`: only a
/// SECURITY DEFINER function reaches this table. `secret` is plain text, not
/// hashed — it must be read back to compute the next code — see the
/// migration for why that is not encrypted at rest either.
model AccountTwoFactor {
  accountId    String    @id @map("account_id") @db.Uuid
  secret       String
  activatedAt  DateTime? @map("activated_at") @db.Timestamptz(6)
  /// Last accepted TOTP step counter (RFC 6238 §5.2) — replay guard.
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_two_factor")
}

/// Single-use two-factor recovery codes (NFR-S11). Stored hashed, like
/// `PasswordResetToken`: a code is presented once and never read back, unlike
/// the TOTP secret above.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("two_factor_recovery_codes")
}

/// Team invitations (PRD FR-MOD-04.4). Not in §8.4 — see PLAN §D12.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The account that accepted this invitation and has not yet proved the
  /// address (tm 282 · GV-03). The invitation stays live until it does; the
  /// join happens in `auth_join_pending_invitations`.
  pendingAccountId String? @map("pending_account_id") @db.Uuid

  license        License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  invitedBy      Account           @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  pendingAccount Account?          @relation("InvitationPendingAccount", fields: [pendingAccountId], references: [id], onDelete: SetNull)
  groups         InvitationGroup[]

  /// The key `invitation_groups` points at, so a team row can only name an
  /// invitation of its own workspace (`id` alone is already unique).
  @@unique([id, licenseId], map: "invitations_id_license_id_key")
  @@index([licenseId, createdAt(sort: Desc)], map: "invitations_license_id_idx")
  @@index([pendingAccountId])
  @@map("invitations")
}

/// A team an invitation names (RL-04 · tm 324.1): the invitee joins it on
/// accepting, and leads it when `isLead` (RL-04-S1 — a Team Lead's invitation
/// leads at least one, which the API enforces). Both foreign keys carry the
/// licence, so one workspace's invitation cannot name another's team. Removed
/// with the invitation and with the team, as a membership is.
model InvitationGroup {
  invitationId String  @map("invitation_id") @db.Uuid
  licenseId    BigInt  @map("license_id")
  groupId      BigInt  @map("group_id")
  isLead       Boolean @default(false) @map("is_lead")

  invitation Invitation @relation(fields: [invitationId, licenseId], references: [id, licenseId], onDelete: Cascade)
  group      Group      @relation(fields: [licenseId, groupId], references: [licenseId, id], onDelete: Cascade)

  @@id([invitationId, groupId])
  @@index([licenseId, groupId])
  @@map("invitation_groups")
}

/// Customer satisfaction, recorded against the chat (PRD §8.4).
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.VarChar(12)
  licenseId BigInt   @map("license_id")
  threadId  String?  @map("thread_id") @db.VarChar(12)
  value     String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
  /// A connection's newest rating (AR-01 / AR-03 · tm 335.1), read per archive page.
  @@index([licenseId, threadId, createdAt(sort: Desc)])
  @@map("ratings")
}

// ===========================================================================
// Agent productivity
// ===========================================================================

/// Saved replies, inserted in the composer with `#shortcut`.
///
/// `visibility` and `groupId` are one decision in two columns and move together
/// — `all` carries no team, `group` requires one. A CHECK
/// (`canned_responses_visibility_check`, 20260905150000) holds the pair; Prisma
/// cannot express it, which is why it is stated here.
///
/// `groupId` deliberately carries no relation: `groups` has a composite key
/// (`licenseId, id`) and a foreign key would need both columns, but the reason
/// it stays absent is the same one `chat_access.group_id` and
/// `routing_rules.target_group_id` give — deleting a team is refused by
/// `group-service.deleteGroup` rather than repaired by the database, because
/// the only repair available (SET NULL) would widen a team's private replies to
/// the whole workspace.
model CannedResponse {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  scope      String   @default("chat")
  shortcut   String
  text       String
  groupId    BigInt?  @map("group_id")
  visibility String   @default("all")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, scope, shortcut])
  @@index([licenseId, groupId])
  @@map("canned_responses")
}

// ===========================================================================
// Engage: campaigns, goals, visitor telemetry
// ===========================================================================

/// Proactive greetings and targeted messages.
model Campaign {
  id         String    @id @default(uuid()) @db.Uuid
  licenseId  BigInt    @map("license_id")
  name       String
  type       String    @default("targeted_message")
  status     String    @default("inactive")
  /// Trigger predicate: url, time on page, exit intent, geo, …
  conditions Json      @default("{}")
  content    Json      @default("{}")
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  recurring  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  sends   CampaignSend[]

  @@index([licenseId, status])
  @@map("campaigns")
}

/// One row per visitor a campaign has fired to (FR-MOD-03.3.2/.3).
///
/// The trigger engine writes one when a live visitor matches an active
/// campaign; the unique `(campaign_id, customer_id)` pair is what stops a
/// campaign firing twice at the same person. It is also the source of the card's
/// numbers (FR-MOD-03.3.3): rows are Displayed, `engaged` rows are Chats, and
/// `converted` rows are Conversions — counted, never stored on the campaign, so
/// the figures can never drift from the sends they summarise.
///
/// The customer poll handler (`GET /customer/chat`, tm 176.2) looks up this
/// visitor's oldest undelivered send on every 4-second poll — a hot read
/// scoped to one `(license_id, customer_id)`, against a table with no
/// retention sweep, so it only grows. Measured (tm 176.1, 176k-row synthetic
/// table, one busy tenant at 119k rows / 3.6k pending): unindexed, that read
/// is a parallel seq scan, ~12 ms. A plain `(license_id, customer_id,
/// delivered_at)` btree drops that to ~2.3 ms but costs 6.4 MB and keeps
/// growing with the table forever — it indexes every row, delivered or not.
/// A **partial** index on `(license_id, customer_id) WHERE delivered_at IS
/// NULL` — hand-written in the migration, since Prisma cannot express a
/// predicate — measured 224 KB and ~0.07 ms: it only ever holds the rows a
/// poll can match, so its size tracks the pending backlog, not history. Same
/// shape as `webhook_deliveries`' pending-queue index above.
model CampaignSend {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   BigInt    @map("license_id")
  campaignId  String    @map("campaign_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  /// The proactive conversation this send opened, once the visitor engages.
  chatId      String?   @map("chat_id") @db.VarChar(12)
  /// The visitor replied — this send counts as a Chat.
  engaged     Boolean   @default(false)
  /// The visitor reached a goal — this send counts as a Conversion.
  converted   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the customer's widget actually surfaced this send's message. NULL
  /// means still owed — the poll response has not carried it to the visitor
  /// yet. Deliberately separate from `created_at` (when the trigger matched):
  /// backdating "delivered" to the match time would claim a visitor saw a
  /// message before the poll that could have shown it ever ran.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  /// When a risk flag kept this send from the player (EN-01 · tm 350); it is
  /// never delivered afterwards, even once the flag is cleared.
  suppressedAt DateTime? @map("suppressed_at") @db.Timestamptz(6)
  /// The flag type that did it (`RISK_FLAG_TYPES`, by CHECK); with `suppressedAt`.
  suppressedReason String? @map("suppressed_reason")

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([licenseId, campaignId])
  @@map("campaign_sends")
}

/// A conversion worth counting — visitor reached a page, completed a purchase.
model Goal {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  name       String
  definition Json     @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license      License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  achievements GoalAchievement[]

  @@index([licenseId, active])
  @@map("goals")
}

/// One row per visitor who has reached a goal (FR-MOD-13.3) — the last stage of
/// the visitor → chat → conversion funnel.
///
/// `goals` holds only the *definition* of a conversion; until now nothing
/// recorded that one had happened, so "achieved goals in this window" was not a
/// question the database could answer. A timestamped row is what makes it
/// answerable — and comparable with the window before it.
///
/// `campaign_sends.converted` is not that record: it is a free boolean with no
/// `goal_id`, so it cannot say *which* goal was reached, and it exists only for
/// visitors a campaign happened to fire at.
model GoalAchievement {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  goalId     String   @map("goal_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  /// The conversation the visitor was in when the goal was reached, when there
  /// was one — the funnel's middle stage.
  chatId     String?  @map("chat_id") @db.VarChar(12)
  achievedAt DateTime @default(now()) @map("achieved_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chat     Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  /// The idempotency constraint. The matcher (13.3-d) re-evaluates a visitor on
  /// every page view; a person converts on a goal once, and the second hit must
  /// be a no-op rather than a second row inflating the funnel.
  @@unique([goalId, customerId])
  @@index([licenseId, achievedAt])
  @@map("goal_achievements")
}

/// Per-license sales tracker configuration (FR-MOD-13.5, "İzleme yapılandırması").
///
/// A per-license singleton shaped like `widget_settings` before Multibrand
/// touched it: `license_id` alone is the primary key. Unlike widget
/// appearance or inbox behaviour, nothing in FR-MOD-13.5 varies tracking by
/// brand — a conversion either counts for the workspace or it doesn't — so
/// this table was designed brand-agnostic from the start, the same way
/// `goals` (13.3) was. Nothing creates the row at signup; the settings
/// endpoint (13.5-b) upserts it on first save, and a read with no row falls
/// back to the schema defaults (tracking off).
model SalesTrackerSettings {
  licenseId             BigInt   @id @map("license_id")
  enabled               Boolean  @default(false)
  currency              String   @default("USD")
  attributionWindowDays Int      @default(7) @map("attribution_window_days")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("sales_tracker_settings")
}

/// Per-license panel appearance (owner, 2026-10-13): the workspace's default
/// font preset, which only the owner sets. A singleton keyed by the license
/// alone, like `sales_tracker_settings` — the panel's look does not vary by
/// brand. No row until the first save; a read with none is "no default".
model WorkspaceAppearanceSettings {
  licenseId       BigInt    @id @map("license_id")
  fontPreset      String?   @map("font_preset")
  fontPresetSetAt DateTime? @map("font_preset_set_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("workspace_appearance_settings")
}

/// One order reported by the widget snippet's `siyahtus('trackSale', …)` call
/// (FR-MOD-13.5) — `Rating`'s event-table shape: one row per occurrence, not
/// a running total. `attributed`, `chatId` and `customerId` stay at their
/// unset defaults until the ingest endpoint (13.5-c) matches the order to a
/// chat within the license's attribution window.
model TrackedSale {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  /// The chat the visitor was in when attributed, or null before attribution
  /// runs (or when none is found). `SET NULL` on delete, like
  /// `goal_achievements.chat_id`: a sale must outlive the chat's retention
  /// window, so purging the chat drops only the pointer.
  chatId          String?  @map("chat_id") @db.VarChar(12)
  customerId      String?  @map("customer_id") @db.Uuid
  externalOrderId String   @map("external_order_id")
  amountCents     Int      @map("amount_cents")
  currency        String
  attributed      Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat     Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// The ingest endpoint may see the same order more than once (an
  /// at-least-once retry from the merchant's own backend); a second row would
  /// double the sale in every downstream report.
  @@unique([licenseId, externalOrderId])
  @@index([licenseId, createdAt])
  @@map("tracked_sales")
}

/// Browsing telemetry behind the real-time visitor list.
model Visit {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  licenseId   BigInt    @map("license_id")
  cameFrom    String?   @map("came_from")
  pages       Json      @default("[]")
  /// Personal data (NFR-S9): subject to the retention policy, and never
  /// returned to the widget.
  ip          String?
  os          String?
  browser     String?
  userAgent   String?   @map("user_agent")
  /// Where the visit came from (tm 330): resolved once from the address at the
  /// visit's start, in-process (`services/geo/`). Country and city only.
  countryCode String?   @map("country_code") @db.Char(2)
  city        String?
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, startedAt(sort: Desc)])
  @@index([licenseId, startedAt(sort: Desc)])
  @@map("visits")
}

// ===========================================================================
// AI
// ===========================================================================

/// An AI agent (customer-facing) or Copilot (agent-facing).
model AiAgent {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  kind        String   @default("ai_agent")
  name        String
  persona     Json     @default("{}")
  tone        String?
  avatarUrl   String?  @map("avatar_url")
  languages   String[] @default([])
  instruction String?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The published configuration version the AI answers from (tm 316 ·
  /// ADR-14b §2.3): a `published` version of this agent, by trigger. Null on
  /// Copilot, which is not versioned, and on an agent nothing was published for.
  publishedVersionId String?  @unique @map("published_version_id") @db.Uuid
  /// Bumped by every behaviour-changing write to the agent's editing tables
  /// (ADR-14b §2.5 step 2); `If-Match` holds a save to the revision it read.
  draftRevision      BigInt   @default(0) @map("draft_revision")

  license          License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  publishedVersion AiConfigVersion?  @relation("AiAgentPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: NoAction)
  versions         AiConfigVersion[] @relation("AiAgentVersions")
  skills           Skill[]
  knowledgeSources KnowledgeSource[]
  handoffSettings   AiHandoffSettings?
  guidanceRules     AiGuidanceRule[]
  handoffRules      AiHandoffRule[]
  guardrailSettings AiGuardrailSettings?
  guardrailRules    AiGuardrailRule[]
  forbiddenPhrases  AiForbiddenPhrase[]
  testScenarios     AiTestScenario[]
  testRuns          AiTestRun[]
  sandboxSessions   AiSandboxSession[]
  unresolvedItems   AiUnresolvedItem[]
  unresolvedGroups  AiUnresolvedCluster[]
  suggestions       AiSuggestion[]

  // One `kind = 'ai_agent'` row per licence (tm 390.1): the partial unique
  // index `ai_agents_one_per_license` lives in the migration — Prisma cannot
  // express its WHERE. A second `POST /ai-agents` is 409 `ai_agent_exists`.
  @@index([licenseId, kind])
  @@map("ai_agents")
}

/// An AI agent's hand-over settings (tm 293.2 · AI-11 §3; 05 AI-09 — tm 303.1
/// widens it with triggers, messages and after-hours text, tm 293.6 with the
/// stall timeout).
/// One row per agent; no row is `DEFAULT_AI_ASSIGNMENT_MODE`.
///
/// `assignment_mode` (`AI_ASSIGNMENT_MODES`) decides when a visitor's
/// connection gets a person: `ai_first` opens it unassigned in `ai` mode and
/// routes it when it leaves the AI, `parallel` routes it on open. Read live
/// when a connection opens (`services/chat/ai-first.ts`), never from a pinned
/// configuration version. The CHECK, the trigger holding the row to an agent of
/// its own licence, and `updated_at` (the trigger's) live in the migration
/// (20261017120000_ai_handoff_settings).
model AiHandoffSettings {
  aiAgentId             String   @id @map("ai_agent_id") @db.Uuid
  licenseId             BigInt   @map("license_id")
  assignmentMode        String   @default("parallel") @map("assignment_mode")
  /// The stall watchdog's window (tm 293.6), 15–600 by CHECK.
  aiStallTimeoutSeconds Int      @default(60) @map("ai_stall_timeout_seconds")
  /// What the AI does when the knowledge base has no answer (tm 298 · AI-06);
  /// null is `DEFAULT_NO_ANSWER`, read through `readNoAnswerSettings`.
  noAnswer              Json?    @map("no_answer")
  /// The hand-over triggers (tm 303.1 · AI-09); null is `DEFAULT_HANDOFF_TRIGGERS`,
  /// read through `readHandoffTriggers`. Versioned, unlike `assignment_mode`.
  triggers              Json?
  /// The workspace's hand-over message per reason, only the ones written
  /// (`readHandoffMessages`); a reason left out says `DEFAULT_HANDOFF_MESSAGES`.
  messages              Json?
  /// `{ text }` said when nobody is accepting chats (AI-12 §4); `readHandoffAfterHours`.
  afterHours            Json?    @map("after_hours")
  /// The agent's default "resolved" criteria (tm 303.4 · K9): a procedure
  /// condition (`Cond`) a procedure without its own is held to; null is the
  /// platform's, the player's yes. Read through `readResolutionCriteria`.
  resolutionCriteria    Json?    @map("resolution_criteria")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set by the write trigger, not by the writer.
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("ai_handoff_settings")
}

/// An AI agent's behaviour rule (tm 299.1 · AI-07): one plain sentence the
/// workspace writes for its AI, with a category, a scope (`{all}`,
/// `{skill_ids}` or `{brand_ids}`, read through `readGuidanceScope`) and a
/// priority (1 first). An editing table (ADR-14b §2.1): no publish state —
/// `active` is "on in this version" — and every write goes through
/// `services/ai/config-draft.ts`, which stamps `updated_at`. The turn reads the
/// rules through `AiConfigSource`, never this table. The CHECKs, the trigger
/// holding the row to an agent of its own licence and the move of
/// `ai_agents.instruction` live in the migration (20261019120000_ai_guidance_rules).
model AiGuidanceRule {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  aiAgentId String   @map("ai_agent_id") @db.Uuid
  title     String
  /// ≤ 600 characters by CHECK (`GUIDANCE_BODY_MAX`).
  body      String
  /// `GUIDANCE_CATEGORIES`, by CHECK.
  category  String
  scope     Json     @default("{\"all\": true}")
  priority  Int      @default(100)
  active    Boolean  @default(true)
  /// Soft references to `accounts.id`, like `Skill.createdBy`: meta fields
  /// (ADR-14b §2.2), never part of what the AI does.
  ownerId   String?  @map("owner_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, aiAgentId])
  @@map("ai_guidance_rules")
}

/// The workspace's hand-over rules (tm 303.3 · AI-09, K9): an ordered list per
/// customer-facing agent, read by a turn through `AiConfigSource` and written
/// only through `config-draft.ts`. Lists and lengths by CHECK
/// (`@siyahtus/types` `handoff-rules.ts`).
model AiHandoffRule {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  aiAgentId     String   @map("ai_agent_id") @db.Uuid
  /// 1-based; the first active rule that matches decides.
  position      Int
  active        Boolean  @default(true)
  title         String
  /// `HANDOFF_RULE_TRIGGER_TYPES`.
  triggerType   String   @map("trigger_type")
  /// The topic, the procedure skill's id, the phrase or the risk flag type;
  /// null for `ai_unresolved` and `player_request`.
  triggerValue  String?  @map("trigger_value")
  /// A soft reference to `groups.id` — a team deleted later is the usual routing.
  targetGroupId BigInt?  @map("target_group_id")
  /// A routing topic (ADR-08a); never with `targetGroupId`.
  targetTopic   String?  @map("target_topic")
  /// `urgent` | `high` | `normal`.
  priority      String   @default("normal")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, aiAgentId, position])
  @@map("ai_handoff_rules")
}

/// Which team a conversation goes to for a key (tm 307.1 · AI-12, shared
/// with AU-01; ADR-14b §2.12): a routing topic (`QUEUE_TOPIC_ROLES`) or a
/// hand-over reason (`HANDOFF_REASONS`), for one brand or — `brandId` null —
/// for every brand. Written only through `config-draft.ts`; human routing
/// reads it live, the AI from its published package (tm 316). Lists and
/// shapes by CHECK; at most one route per key and brand by two partial unique
/// indexes (hand-written in 20261020180000_handoff_routes).
model HandoffRoute {
  id                  String   @id @default(uuid()) @db.Uuid
  licenseId           BigInt   @map("license_id")
  brandId             String?  @map("brand_id") @db.Uuid
  /// `HANDOFF_ROUTE_MATCH_TYPES`.
  matchType           String   @map("match_type")
  matchKey            String   @map("match_key")
  /// A soft reference to `groups.id`, like `ai_handoff_rules.target_group_id`:
  /// the resolver checks the team still exists and moves on when it does not.
  groupId             BigInt   @map("group_id")
  /// A soft reference to `expertise.id`. A requirement whose expertise is gone
  /// is met by nobody — the conversation waits rather than reach an untrained
  /// agent.
  requiredExpertiseId BigInt?  @map("required_expertise_id")
  /// `THREAD_PRIORITIES`: the priority a conversation routed here starts with.
  defaultPriority     String   @default("normal") @map("default_priority")
  active              Boolean  @default(true)
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([licenseId, matchType, matchKey])
  @@map("handoff_routes")
}

/// A customer-facing agent's guardrail settings (tm 301.2 · AI-08): the crisis
/// text G3 sends verbatim before its hand-over, the complaint procedure G15
/// gives, whether the judge call reads risky drafts, and the Founder's approval
/// of the crisis text as it stands — editing the text clears it, and the agent
/// cannot be switched on without it (`409 ai_guardrail_setup_incomplete`,
/// `guardrailSetupProblem`). One row per agent; no row is no crisis text. An
/// editing table (ADR-14b §2.12): writes go through `config-draft.ts`. The
/// CHECKs and the trigger holding the row to an agent of its own licence live
/// in the migration (20261019150000_ai_guardrails).
model AiGuardrailSettings {
  aiAgentId     String    @id @map("ai_agent_id") @db.Uuid
  licenseId     BigInt    @map("license_id")
  crisisText    String?   @map("crisis_text")
  complaintText String?   @map("complaint_text")
  judgeEnabled  Boolean   @default(false) @map("judge_enabled")
  /// Soft references to `accounts.id`: who approved the crisis text, and when.
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("ai_guardrail_settings")
}

/// A workspace's compliance addition to the locked catalogue (tm 301.2 ·
/// AI-08): one imperative line for the prompt's `tenant_compliance` layer, a
/// category (`GUARDRAIL_CATEGORIES`), what it makes the turn do
/// (`GUARDRAIL_RULE_ACTIONS`) and a scope read through `readGuidanceScope`. An
/// editing table: `active` is "on in this version", writes go through
/// `config-draft.ts`.
model AiGuardrailRule {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  aiAgentId String   @map("ai_agent_id") @db.Uuid
  title     String
  /// ≤ 600 characters by CHECK (`GUARDRAIL_RULE_BODY_MAX`).
  body      String
  category  String
  action    String   @default("prompt_only")
  scope     Json     @default("{\"all\": true}")
  active    Boolean  @default(true)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, aiAgentId])
  @@map("ai_guardrail_rules")
}

/// What a workspace's AI replies must not say (tm 301.2 · AI-08): a phrase
/// matched against the folded reply exactly, as whole words or by a pattern of
/// the bounded dialect `forbiddenPhraseProblem` accepts; `block` rewrites, then
/// hands over, `warn` records. `lang` null applies to every reply. An editing
/// table, like the rules.
model AiForbiddenPhrase {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  aiAgentId String   @map("ai_agent_id") @db.Uuid
  phrase    String
  /// `FORBIDDEN_PHRASE_MATCHES`, by CHECK.
  match     String   @default("word")
  lang      String?
  scope     Json     @default("{\"all\": true}")
  action    String   @default("block")
  active    Boolean  @default(true)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, aiAgentId])
  @@map("ai_forbidden_phrases")
}

/// One guardrail hit (tm 301.2 · AI-08 §8): which rule a turn found broken at
/// the player's message or the AI's draft, and what the turn did. A record,
/// not configuration — never edited (`siyahtus_app` holds SELECT, INSERT,
/// DELETE). `turn_id` is the turn's `ai_decision_logs.id`, `rule_key` is `G3`,
/// `rule:<uuid>` or `phrase:<uuid>` (`guardrailHitRuleKey`) — neither a
/// relation. `evidence` quotes masked words, so the row goes with its
/// conversation (`chat_id`/`thread_id` cascade).
model AiGuardrailHit {
  id             String   @id @default(uuid()) @db.Uuid
  licenseId      BigInt   @map("license_id")
  /// The day container (panel "Thread ID").
  chatId         String   @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID").
  threadId       String   @map("thread_id") @db.VarChar(12)
  turnId         String   @map("turn_id") @db.Uuid
  ruleKey        String   @map("rule_key")
  /// `GUARDRAIL_STAGES`, by CHECK.
  stage          String
  /// `GUARDRAIL_HIT_ACTIONS`, by CHECK.
  actionTaken    String   @map("action_taken")
  evidence       String?
  patternIndex   Int?     @map("pattern_index")
  catalogVersion String   @map("catalog_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt(sort: Desc)])
  @@index([licenseId, ruleKey, createdAt(sort: Desc)])
  @@index([chatId, createdAt])
  @@index([threadId])
  @@map("ai_guardrail_hits")
}

/// A risk flag (tm 302.1 · AI-27): a structured mark on a conversation
/// (`chat`), or on the player behind it as well (`member` — `rg_signal`,
/// `self_exclusion_request`, `underage_suspected`, AI-27-S1), that
/// `riskPolicy` (`@siyahtus/types`) turns into no promotions, no bonus talk
/// and a forced hand-over. Never deleted, never rewritten: the one change is
/// `active` → `cleared` with who, when and why (the `risk_flags_before_write`
/// trigger; `siyahtus_app` holds no DELETE). `chat_id`/`thread_id` go null when
/// the retention sweep takes the conversation — a member flag outlives it —
/// and the customer's erasure takes the row. The CHECKs, the trigger and the
/// partial index of active flags per customer live in 20261019180000_risk_flags.
model RiskFlag {
  id               String    @id @default(uuid()) @db.Uuid
  licenseId        BigInt    @map("license_id")
  /// `RISK_FLAG_SCOPES`, by CHECK.
  scope            String
  /// The day container (panel "Thread ID") it was raised in.
  chatId           String?   @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID") it was raised in.
  threadId         String?   @map("thread_id") @db.VarChar(12)
  /// The chat's customer when raised in a chat (the trigger fills it in).
  customerId       String?   @map("customer_id") @db.Uuid
  /// The player's key on the operator's site (ID-03), when known.
  memberKey        String?   @map("member_key")
  /// `RISK_FLAG_TYPES`, by CHECK.
  type             String
  /// `RISK_FLAG_SEVERITIES`, by CHECK.
  severity         String
  /// `RISK_FLAG_SOURCES`, by CHECK.
  source           String
  /// The guardrail rule (`G1`…`G19`) that raised it; only when `source` is `ai_rule`.
  ruleRef          String?   @map("rule_ref")
  evidenceEventIds String[]  @default([]) @map("evidence_event_ids")
  note             String?
  /// `RISK_FLAG_BASES`, by CHECK; `declared` in F1 (AI-27-S3).
  basis            String    @default("declared")
  /// `RISK_FLAG_STATUSES`, by CHECK.
  status           String    @default("active")
  /// The account that raised it; null when the AI did.
  raisedBy         String?   @map("raised_by") @db.Uuid
  raisedAt         DateTime  @default(now()) @map("raised_at") @db.Timestamptz(6)
  clearedBy        String?   @map("cleared_by") @db.Uuid
  clearedAt        DateTime? @map("cleared_at") @db.Timestamptz(6)
  clearReason      String?   @map("clear_reason")

  license  License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat     Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  thread   Thread?   @relation(fields: [threadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([licenseId, status, type])
  @@index([chatId, raisedAt])
  @@index([threadId])
  @@index([customerId])
  @@map("risk_flags")
}

/// The AI's hand-over card (tm 304.1 · SiyahTuş analysis AI-10): what the
/// person who takes a connection from the AI starts from, built from the
/// conversation's state in the hand-over's own transaction — never by a model.
/// `id` is the hand-over's `handoff_id` (its transfer and AI-mode events carry
/// it). Written once; afterwards only `accepted_*` (the agent's first message
/// after it) and `feedback_*` (one verdict, the last click wins) change — the
/// trigger refuses every other edit. A `pii: 'high'` slot's value is never in
/// it. The CHECKs and `ai-handoff-card.ts`'s lists are one vocabulary.
model AiHandoff {
  id                    String    @id @db.Uuid
  licenseId             BigInt    @map("license_id")
  /// The day container (panel "Thread ID").
  chatId                String    @map("chat_id") @db.VarChar(12)
  /// The connection handed over (panel "Chat ID").
  threadId              String    @map("thread_id") @db.VarChar(12)
  /// The AI's conversation row, when it had one. No relation: it goes with the thread.
  aiConversationId      String?   @map("ai_conversation_id") @db.Uuid
  /// The procedure (today: the skill). No relation: deleting it must not erase the card.
  skillId               String?   @map("skill_id") @db.Uuid
  procedureKey          String?   @map("procedure_key")
  procedureSnapshotHash String?   @map("procedure_snapshot_hash")
  /// The procedure's name — the card's subject.
  intentLabel           String?   @map("intent_label")
  summary               String
  /// The player's question, on a hand-over no procedure ran.
  question              String?
  /// `AiHandoffPlayer`: the player's own claim, and whether the device is known.
  player                Json      @default("{}")
  /// `HANDOFF_REASONS`, most severe first; `primary_reason` is the first.
  reasonCodes           String[]  @map("reason_codes")
  primaryReason         String    @map("primary_reason")
  /// `AiHandoffSlotLine[]`.
  slotsSnapshot         Json      @default("[]") @map("slots_snapshot")
  /// `AiHandoffFact[]`.
  decisionFacts         Json      @default("[]") @map("decision_facts")
  /// What a person must check, since no tool could (AI-28 `pending_checks`).
  checks                Json      @default("[]")
  /// `AiHandoffStatement[]`.
  aiStatements          Json      @default("[]") @map("ai_statements")
  /// `AI_HANDOFF_OUTPUT_FLAGS`.
  outputCheckFlags      String[]  @default([]) @map("output_check_flags")
  riskFlags             String[]  @default([]) @map("risk_flags")
  /// `AI_HANDOFF_SENTIMENTS`, or null.
  sentiment             String?
  suggestedNextStep     String?   @map("suggested_next_step")
  /// `AiHandoffAttachment[]`.
  attachments           Json      @default("[]")
  /// The team it was handed to, when one was named. No relation: a team removed later stays named.
  targetGroupId         BigInt?   @map("target_group_id")
  /// `GUARDRAIL_PRIORITIES`.
  priority              String
  /// `HUMAN_REQUEST_VIAS` (tm 308 · AI-29): `button` when the player pressed
  /// "Talk to an agent"; null otherwise. CHECK in the migration.
  requestedVia          String?   @map("requested_via")
  cardText              String    @map("card_text")
  configVersionId       String?   @map("config_version_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedBy            String?   @map("accepted_by") @db.Uuid
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  /// `AI_HANDOFF_FEEDBACK_VALUES`, or null.
  feedback              String?
  feedbackReason        String?   @map("feedback_reason")
  feedbackBy            String?   @map("feedback_by") @db.Uuid
  feedbackAt            DateTime? @map("feedback_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([licenseId, createdAt])
  @@index([chatId, createdAt])
  @@index([threadId])
  @@map("ai_handoffs")
}

/// Risk flag settings (tm 302.2 · AI-27, Ayarlar › Risk bayrakları): the
/// workspace's Responsible Gaming team — its members read a flag's note and
/// evidence and hear of an urgent flag — and the addresses an urgent flag is
/// mailed to. One row per workspace; none is no team and no address.
/// `rg_group_id` is a soft reference to `groups` (keyed by licence and id): a
/// deleted team reads as none. ≤ 5 addresses by CHECK
/// (`RISK_FLAG_NOTIFY_EMAILS_MAX`). RLS and grants in the migration
/// (20261019200000_risk_flag_settings).
model RiskFlagSettings {
  licenseId    BigInt   @id @map("license_id")
  rgGroupId    BigInt?  @map("rg_group_id")
  notifyEmails String[] @default([]) @map("notify_emails")
  /// EN-01 karar 2: suspected fraud keeps a player from campaigns unless switched off.
  promoBlockFraud Boolean @default(true) @map("promo_block_fraud")
  /// EN-01 karar 2: a formal complaint does not unless switched on.
  promoBlockComplaint Boolean @default(false) @map("promo_block_complaint")
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("risk_flag_settings")
}

// ===========================================================================
// Rule bot (FR-MOD-06.6) — deterministic, LLM-free, and its own entity
// ===========================================================================

/// A rule-based chatbot: a name, an on/off switch, an ordered list of rules and
/// the teams it serves.
///
/// Deliberately NOT a third `ai_agents.kind`. PRD:577 asks for a bot "AI
/// Agent'tan AYRI, LLM'siz", and sharing that table is the opposite of separate
/// — measured, not assumed: `GET /ai-agents` filters on no `kind`, so a rule bot
/// stored there would be listed and counted as an LLM-backed agent by the AI
/// Agent console and the Team → Chatbots KPI. Every AI-shaped column on that
/// model (`persona`, `tone`, `languages`, `instruction`, and the `skills` /
/// `knowledge_sources` relations) is meaningless here as well.
///
/// The PRD's `Şema` column says `§8 bots` but §8.4 — the schema's single source
/// of truth — defines no such table; the DDL below is this task's design and is
/// recorded in PLAN §C as `Assumption: A37`.
model Bot {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  /// Off silences every rule this bot carries without deleting any of them.
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  rules   BotRule[]
  groups  BotGroup[]

  @@unique([licenseId, name])
  @@index([licenseId, enabled])
  @@map("bots")
}

/// One condition + action pair. The shapes live in JSON so a new predicate needs
/// no migration, exactly as `ticket_rules` does; both are required, which the
/// service enforces and the pure matcher enforces again for a row written around
/// it. Rules run in `position` order and the FIRST match wins — unlike ticket
/// rules, which accumulate, because a bot that answered three times would send
/// the visitor three messages for one question.
model BotRule {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  BigInt   @map("license_id")
  botId      String   @map("bot_id") @db.Uuid
  name       String
  conditions Json     @default("{}")
  actions    Json     @default("{}")
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  bot     Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([licenseId, botId, enabled, position])
  @@map("bot_rules")
}

/// The KK's second half — "gruplara priority ile atanır".
///
/// `group_agents` cannot carry this: its `agent_id` is a FK to `accounts`, and a
/// bot is not an account. `priority` reuses the same four tiers an agent's team
/// membership uses (`GROUP_PRIORITIES`) rather than inventing a second ordering
/// vocabulary for the same word.
model BotGroup {
  licenseId BigInt @map("license_id")
  botId     String @map("bot_id") @db.Uuid
  groupId   BigInt @map("group_id")
  priority  String @default("normal")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  bot     Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [licenseId, groupId], references: [licenseId, id], onDelete: Cascade)

  @@id([licenseId, botId, groupId])
  @@index([licenseId, groupId])
  @@map("bot_groups")
}

/// A named capability, expressed as an ordered list of steps compiled from a
/// natural-language instruction (ADR-14 — Skill is the single paradigm).
model Skill {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  aiAgentId       String?  @map("ai_agent_id") @db.Uuid
  name            String
  kind            String
  instruction     String?
  /// Ordered: detect_intent, request_info, tag, summarize, send_message,
  /// transfer_to_team.
  steps           Json     @default("[]")
  trigger         Json     @default("{}")
  /// `single` — the one-message step list above; `procedure` — a multi-turn
  /// procedure (tm 296 · ADR-14a `docs/adr/skill-procedure.md`).
  mode            String   @default("single")
  /// What AI-05 selects a skill by, in either mode.
  whenToUse       String?  @map("when_to_use")
  examples        String[] @default([])
  /// Between two equally likely skills the smaller number wins.
  priority        Int      @default(100)
  /// A procedure's `SlotDef`s (@siyahtus/types `slots.ts`).
  slots           Json     @default("[]")
  /// The rest of a procedure — `{steps, templates, handoff, limits}`; null on a
  /// `single` skill.
  procedure       Json?
  /// An installed template copy only its texts and team may change in (AI-15);
  /// set by the server, never by a client.
  locked          Boolean  @default(false)
  templateKey     String?  @map("template_key")
  templateVersion Int?     @map("template_version")
  /// The skill that answers when no other matches (AI-05).
  isFallback      Boolean  @default(false) @map("is_fallback")
  active          Boolean  @default(false)
  runsCount       Int      @default(0) @map("runs_count")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license        License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent        AiAgent?             @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  runs           SkillRun[]
  exampleVectors AiProcedureExample[]

  @@index([licenseId, kind, active])
  @@map("skills")
}

/// A procedure skill's example sentences, embedded (tm 297.3 · SiyahTuş
/// analysis AI-05 §2): what the understanding call's catalogue is narrowed by
/// when an agent has more than 15 procedures. Written after a skill save
/// (`procedure-examples.ts`); a procedure with no rows in the turn's
/// embedding space is never narrowed away. Its hnsw index
/// (`idx_procedure_examples_embedding_hnsw`) is created in a migration, like
/// `knowledge_chunks`'s, because Prisma cannot express index methods.
model AiProcedureExample {
  id             String                      @id @default(uuid()) @db.Uuid
  licenseId      BigInt                      @map("license_id")
  skillId        String                      @map("skill_id") @db.Uuid
  text           String
  embedding      Unsupported("vector(1536)")
  /// `EmbeddingProvider.space`, as on `knowledge_chunks` (PLAN D182).
  embeddingSpace String                      @map("embedding_space")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([licenseId, embeddingSpace])
  @@map("ai_procedure_examples")
}

/// Audit trail for skill executions — what ran, against which chat, and why it
/// did what it did.
///
/// The three token columns are what the run's inference cost, as the providers
/// reported it (tm 255.9): the chat model's input and output, and the question's
/// embedding. The AI Agent report sums them beside its run count. A stub
/// provider bills nothing and records 0. A Copilot summary written by a model
/// records its chat-model tokens on its own assist run (tm 257.5), so a count
/// of a workspace's model calls can include Copilot's; the AI Agent report
/// reads `ai_agent` skills only and does not. Copilot's other assists record 0
/// — a reply draft's query embedding is logged per call
/// (`embedding.completed`), not metered.
model SkillRun {
  id              String   @id @default(uuid()) @db.Uuid
  skillId         String   @map("skill_id") @db.Uuid
  chatId          String?  @map("chat_id") @db.VarChar(12)
  /// The connection the run answered (tm 288.2 · ID-08) — the panel's "Chat
  /// ID". Null on a preview and on runs recorded before it was kept.
  threadId        String?  @map("thread_id") @db.VarChar(12)
  licenseId       BigInt   @map("license_id")
  status          String   @default("succeeded")
  log             Json     @default("[]")
  ranAt           DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)
  llmInputTokens  Int      @default(0) @map("llm_input_tokens")
  llmOutputTokens Int      @default(0) @map("llm_output_tokens")
  embeddingTokens Int      @default(0) @map("embedding_tokens")

  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([skillId, ranAt(sort: Desc)])
  @@index([licenseId, ranAt(sort: Desc)])
  @@index([threadId])
  @@map("skill_runs")
}

/// What the AI decided on one turn, and on what grounds (tm 288.2 · ID-08) —
/// the record that answers "why did the AI say that to this player?" by
/// number. Ids, scores, flags and counts only: no message, reply or prompt
/// text (ID-08 rule). Written by `services/ai/decision-log.ts`, which never
/// lets a failed write stop the reply.
///
/// Kept as long as the conversation (ID-08-S1): a row on a connection goes
/// with it (`thread_id` cascades, so the retention sweep's thread delete takes
/// it), a row with no connection is swept by age under the same window, and
/// erasing the customer takes every row through `customer_id` / `chat_id`.
/// Rows are never edited — `siyahtus_app` holds SELECT, INSERT and DELETE.
///
/// Not partitioned: one row per AI turn is a fraction of `events`. If it ever
/// grows to that scale, the monthly range scheme `events` uses
/// (`services/chat/event-partitions.ts`) is the model to follow.
model AiDecisionLog {
  id                 String   @id @default(uuid()) @db.Uuid
  licenseId          BigInt   @map("license_id")
  /// The day container (panel "Thread ID").
  chatId             String?  @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID").
  threadId           String?  @map("thread_id") @db.VarChar(12)
  customerId         String?  @map("customer_id") @db.Uuid
  /// The customer event the turn answered, and the event it wrote. No
  /// relation: `events` is partitioned and keyed by (id, created_at).
  triggerEventId     String?  @map("trigger_event_id") @db.VarChar(40)
  replyEventId       String?  @map("reply_event_id") @db.VarChar(40)
  /// The HTTP request (`request_id` on its log lines) or the queued job that ran the turn.
  requestId          String?  @map("request_id") @db.VarChar(64)
  jobId              String?  @map("job_id") @db.VarChar(128)
  /// One of `AI_DECISIONS` (`@siyahtus/types`), enforced by `ai_decision_logs_decision_check`.
  decision           String
  /// The procedure (today: the skill) and the version and step it was on. No
  /// relation: deleting a procedure must not erase what it decided.
  procedureId        String?  @map("procedure_id") @db.Uuid
  procedureVersion   Int?     @map("procedure_version")
  step               String?
  knowledgeSourceIds String[] @default([]) @map("knowledge_source_ids") @db.Uuid
  chunkIds           String[] @default([]) @map("chunk_ids") @db.Uuid
  retrievalScores    Float[]  @default([]) @map("retrieval_scores")
  guardrailHits      String[] @default([]) @map("guardrail_hits")
  handoffReason      String?  @map("handoff_reason")
  riskFlags          String[] @default([]) @map("risk_flags")
  model              String?
  llmInputTokens     Int      @default(0) @map("llm_input_tokens")
  llmOutputTokens    Int      @default(0) @map("llm_output_tokens")
  latencyMs          Int?     @map("latency_ms")
  errorType          String?  @map("error_type")
  /// Anything else worth keeping, at most `AI_DECISION_DETAILS_MAX_BYTES` of JSON text.
  details            Json     @default("{}")
  configVersionId    String?  @map("config_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat     Chat?     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  thread   Thread?   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt(sort: Desc)])
  @@index([chatId, createdAt])
  @@index([threadId])
  @@index([customerId])
  @@map("ai_decision_logs")
}

/// The durable AI job queue (ADR-11a · tm 289 · SiyahTuş analysis GV-02): one
/// row per automatic reply a visitor message is owed, written in the same
/// transaction as the message (the outbox) and worked off by the AI job
/// worker. Replaces the in-memory `FollowUps` queue for that work, so a
/// restart no longer loses an answer.
///
/// State moves only through two SECURITY DEFINER functions
/// (`services/ai/ai-jobs.ts`): `ai_jobs_claim` takes due jobs across tenants
/// under `FOR UPDATE SKIP LOCKED` with a lease, one chat at a time in arrival
/// order; `ai_jobs_settle` records the result, fenced by the attempt number
/// the claim handed out. `siyahtus_app` may read its tenant's rows and enqueue
/// (`pending`, or `expired` at the door), nothing else. The CHECKs on `kind`,
/// `state`, each state's shape and `outcome` live in the migration
/// (20261016120000_ai_jobs) — Prisma cannot model them.
///
/// Kept as long as the conversation: every row names its thread, which
/// cascades, so the retention sweep's thread delete and the customer's
/// erasure take the queue's history with the conversation.
model AiJob {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  /// The licence's organization, so the worker can open the job's tenant
  /// context without a lookup. The insert policy holds it to
  /// `app.current_organization`.
  organizationId String    @map("organization_id") @db.Uuid
  /// The day container (panel "Thread ID") — the queue's ordering key.
  chatId         String    @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID") the visitor wrote on.
  threadId       String    @map("thread_id") @db.VarChar(12)
  /// The visitor event the reply is owed to. No relation: `events` is
  /// partitioned and keyed by (id, created_at).
  triggerEventId String    @map("trigger_event_id") @db.VarChar(40)
  /// One of `AI_JOB_KINDS`, enforced by `ai_jobs_kind_check`.
  kind           String
  /// One of `AI_JOB_STATES`, enforced by `ai_jobs_state_check`.
  state          String    @default("pending")
  /// Claims so far. Also the settle's fence: a worker whose lease ran out and
  /// was re-claimed holds a stale number and cannot settle.
  attempts       Int       @default(0)
  /// Not claimable before this (a released job's retry delay).
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  /// Set while `running`: another worker may re-claim the job once it passes.
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  /// Insert time, not transaction start (`now()`): the per-chat order is this
  /// column, and two sends on one thread can start in one order and take the
  /// thread's sequence lock in the other. Leave it to the default.
  createdAt      DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  /// The first claim.
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  /// A snake_case code (`ai_jobs_outcome_check`) — never conversation text.
  outcome        String?
  /// At most 1000 characters (`ai_jobs_last_error_check`).
  lastError      String?   @map("last_error")
  /// The HTTP request that enqueued the job (`request_id` on its log lines).
  requestId      String?   @map("request_id") @db.VarChar(64)
  /// The page the message was sent from, for the rule bot's page conditions
  /// (tm 289.5). At most 2048 characters (`ai_jobs_page_url_check`).
  pageUrl          String?  @map("page_url")
  /// The message opened its connection — the assignee's notice says "new chat".
  openedConnection Boolean  @default(false) @map("opened_connection")
  /// How the visitor who wrote the message proved who they are (tm 294 ·
  /// AI-02, K4): one of `IDENTITY_TRUSTS`, enforced by `ai_jobs_identity_trust_check`.
  /// Null reads as `claimed`.
  identityTrust    String?  @map("identity_trust")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// One job per message and kind: a second enqueue of the same event is a
  /// refused write, not a race.
  @@unique([licenseId, triggerEventId, kind])
  @@index([state, availableAt])
  @@index([chatId, createdAt])
  @@index([threadId])
  @@map("ai_jobs")
}

/// Where the AI is in one connection (tm 292.1 · SiyahTuş analysis AI-01,
/// AI-03, AI-04, AI-11; ADR-14b §2.7): one row per connection, the state a
/// turn reads and writes back. A record, not configuration.
///
/// The optimistic lock: a turn reads `version`, does its model work outside
/// any transaction and writes back only `WHERE version = :read`
/// (`services/ai/conversation/state-store.ts`). A trigger bumps `version` on
/// every UPDATE — the runtime role cannot write it — so any write, an agent's
/// takeover included, fences a turn still holding the old number. The same
/// trigger keeps `config_version_id` pinned once set and
/// `last_processed_event_seq` from moving back; the insert trigger holds the
/// row to a thread of its own licence and chat. Those triggers and the CHECKs
/// live in the migration (20261016200000_ai_conversations) — Prisma cannot
/// model them.
///
/// Goes with its connection (thread CASCADE): the retention sweep and a
/// customer's erasure take it. It holds personal data (slot values).
model AiConversation {
  id                    String    @id @default(uuid()) @db.Uuid
  licenseId             BigInt    @map("license_id")
  /// The day container (panel "Thread ID"); always the thread's own chat.
  chatId                String    @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID").
  threadId              String    @map("thread_id") @db.VarChar(12)
  /// One of `AI_CONVERSATION_MODES` (`@siyahtus/types`), enforced by
  /// `ai_conversations_mode_check`. Its logic is AI-11's (#293).
  mode                  String    @default("ai")
  modeChangedAt         DateTime? @map("mode_changed_at") @db.Timestamptz(6)
  /// An account id, `ai` or `system` — a code, never text.
  modeChangedBy         String?   @map("mode_changed_by")
  /// A snake_case reason code (`ai_conversations_mode_reason_check`).
  modeReason            String?   @map("mode_reason")
  /// The procedure (today: the skill) in progress. No relation: deleting a
  /// procedure must not erase where the conversation was.
  activeSkillId         String?   @map("active_skill_id") @db.Uuid
  /// The procedure's definition, frozen when it started (AI-03, ADR-14b §2.9),
  /// and the sha256 of its canonical JSON — always together.
  procedureSnapshot     Json?     @map("procedure_snapshot")
  procedureSnapshotHash String?   @map("procedure_snapshot_hash")
  stepId                String?   @map("step_id")
  /// One of `AI_CONVERSATION_STEP_STATUSES`, or null with no step active.
  stepStatus            String?   @map("step_status")
  /// What the AI has collected (AI-04). Personal data.
  slots                 Json      @default("{}")
  /// The one suspended topic (skill, step, slots).
  suspended             Json?
  counters              Json      @default("{}")
  signals               Json      @default("{}")
  /// The connection's summary for the same day's later connections (AI-02).
  digest                Json?
  /// One of `AI_CONVERSATION_OUTCOMES`, or null while unsettled.
  outcome               String?
  /// The connection's `event_sequence` the last turn covered. Never moves back.
  lastProcessedEventSeq Int       @default(0) @map("last_processed_event_seq")
  /// The lock's counter. The database's alone: 0 on insert, +1 on every update.
  version               Int       @default(0)
  /// The AI configuration version the conversation runs on (ADR-14b §2.7):
  /// pinned when the row opens, null until versioning ships (tm 316); a null
  /// may be filled once, a value never changes. No relation yet —
  /// `ai_config_versions` is tm 316's.
  configVersionId       String?   @map("config_version_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set by the update trigger, not by the writer.
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// One row per connection, and the way a turn finds it.
  @@unique([licenseId, chatId, threadId])
  @@index([threadId])
  @@map("ai_conversations")
}

/// Visual node/edge automation (FR-MOD-13.4). The table exists so the schema
/// matches PRD §8.4; the editor is not deferred, it is **not being built** —
/// ADR-14 settled on one paradigm, Skill, and the 31+ template target that row
/// also carried was honoured by an ADR-compliant substitute (`05.6`). So
/// nothing writes here, and nothing is expected to: this is the one model
/// `audit:schema-consumers` reports with no consumer on purpose. (Text
/// corrected in GL-15 · tm 210 — it used to say "ADR-14 defers the editor to
/// v2", which named the wrong decision and the wrong phase: v2 is the phase
/// `13.4` belongs to, and it closed with the row `⛔`.)
model Workflow {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, status])
  @@map("workflows")
}

/// A document, page or FAQ the AI may draw on — one store for the AI agent and
/// Copilot (tm 309 · AI-14, K11; `docs/adr/single-knowledge-store.md`).
///
/// Retrieval reads who a source is for — `audiences`, `aiAgentIds`,
/// `brandIds`, `validUntil` (tm 309.2: `KnowledgeService.search`'s `reader`,
/// `@siyahtus/types` `knowledgeSourceServes`); 20261021000000 wrote them for
/// the rows older than tm 309.1. `aiAgentId` is the filing, which follows the
/// scope (`config-draft.ts` `knowledgeFilingOf`) so a release that still reads
/// it keeps the same separation, until the contract step makes it nullable.
/// Their CHECKs, the `reviewedAt` backfill and the GIN indexes on `audiences`
/// and `brandIds` are in 20261020220000–0400.
model KnowledgeSource {
  id                 String    @id @default(uuid()) @db.Uuid
  aiAgentId          String    @map("ai_agent_id") @db.Uuid
  licenseId          BigInt    @map("license_id")
  type               String
  name               String
  sourceUrl          String?   @map("source_url")
  content            String?
  status             String    @default("ready")
  addedBy            String?   @map("added_by")
  /// Who may use the source (`KNOWLEDGE_AUDIENCES`): `ai_agent` — the AI's
  /// answers to players — and `copilot`. Never empty, in that order, no repeats.
  audiences          String[]  @default(["ai_agent", "copilot"])
  /// The AI agents (`kind = 'ai_agent'`) the source is for; empty = every one.
  aiAgentIds         String[]  @default([]) @map("ai_agent_ids") @db.Uuid
  /// The brands the source is for; empty = every brand. An array holds no
  /// foreign key: these are soft references, checked when written (tm 309.2).
  brandIds           String[]  @default([]) @map("brand_ids") @db.Uuid
  /// A primary language subtag (`KNOWLEDGE_LANGUAGE_PATTERN`); null = not said.
  language           String?
  /// Soft reference to `accounts.id`, like `addedBy` — a meta field (ADR-14b
  /// §2.2): whoever a due review falls to.
  ownerId            String?   @map("owner_id") @db.Uuid
  /// When a person last confirmed the source (AI-14-S3). A new source is
  /// reviewed as it is added; a re-crawl or an edit is not a review.
  reviewedAt         DateTime  @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  /// `KNOWLEDGE_REVIEW_INTERVAL_DAYS`: due again this many days after `reviewedAt`.
  reviewIntervalDays Int       @default(90) @map("review_interval_days")
  /// Past this the source answers nothing (tm 309.2); null = no end.
  validUntil         DateTime? @map("valid_until") @db.Timestamptz(6)
  /// The KB article this source mirrors once published (AI-14-S2, tm 309.2) —
  /// one source per article, gone with it.
  kbArticleId        String?   @unique @map("kb_article_id") @db.Uuid
  /// The structured-table row this source renders (AI-13, tm 310): both or neither.
  sourceTable        String?   @map("source_table")
  sourceRowId        String?   @map("source_row_id") @db.Uuid
  /// Freshness window in days for a `website` source (FR-MOD-06.3.3, tm 198.4).
  /// NULL means "never automatically" — every source's behaviour before this
  /// field existed, and every source an admin has not opted in.
  refreshAfterDays   Int?      @map("refresh_after_days")
  /// When the freshness sweep should next attempt this source. Recomputed from
  /// `refreshAfterDays` every time the source is actually refreshed — an edit,
  /// a manual reindex, or the sweep itself — never read as a hard deadline.
  nextRefreshAt      DateTime? @map("next_refresh_at") @db.Timestamptz(6)
  /// Why the most recent refresh attempt failed, if it did. Cleared on the next
  /// success. A failed refresh never touches `content` or the source's chunks
  /// (services/ai/knowledge-refresh.ts), so this is a status to read, not a
  /// sign that anything was lost.
  lastRefreshError   String?   @map("last_refresh_error")
  /// How far a `website` source's crawl reaches (`CRAWL_SCOPES`, tm 312 ·
  /// AI-17). Null on every other type, and on a website source added before
  /// the column existed — read as `single`, which is what it was crawled as.
  crawlScope         String?   @map("crawl_scope")
  /// The most pages one crawl of a `website` source keeps
  /// (`KNOWLEDGE_PAGE_LIMIT`); null on the other types, read as the default.
  pageLimit          Int?      @map("page_limit")
  /// URL path prefixes a crawl keeps to (empty — every path) and leaves out
  /// (`crawlPathInScope`); exclusion wins. Website sources only.
  includePaths       String[]  @default([]) @map("include_paths")
  excludePaths       String[]  @default([]) @map("exclude_paths")
  /// When the source's last crawl job finished, whatever came of it.
  lastCrawledAt      DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  /// Pages the last crawl left in the store (`ok` + `unchanged`) — kept on
  /// the row by the job runner, so the list and the workspace-wide page cap
  /// read a column rather than counting `knowledge_pages`. For a PDF/Word
  /// document (tm 313 · AI-18), its page count once read.
  pageCount          Int       @default(0) @map("page_count")
  /// Taken out of the draft (tm 316 · ADR-14b §2.8): a removed source stays,
  /// with its chunks, until no kept version refers to them. Null = in the draft.
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  /// The generation the source's current chunks are (ADR-14b §2.8): a
  /// re-index writes a new one beside the old instead of deleting it.
  chunkGeneration    Int       @default(1) @map("chunk_generation")
  /// The uploaded PDF/Word original (tm 313 · AI-18-S2): its object-store key
  /// (`<licence>-k-<uuid>.pdf|.docx`, which `GET /uploads/{key}` never
  /// serves), its type as read from the bytes, its length and its sha256
  /// (hex). All four or none; only a `file` source has them. One source per
  /// file per workspace (`knowledge_source_exists`).
  fileKey            String?   @unique @map("file_key")
  fileMime           String?   @map("file_mime")
  fileSize           Int?      @map("file_size")
  fileSha256         String?   @map("file_sha256") @db.Char(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  aiAgent   AiAgent          @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  kbArticle KbArticle?       @relation(fields: [kbArticleId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
  pages     KnowledgePage[]
  jobs      KnowledgeJob[]

  @@unique([licenseId, fileSha256])
  @@index([aiAgentId, type])
  @@index([licenseId])
  @@index([type, nextRefreshAt])
  @@index([audiences(ops: ArrayOps)], type: Gin)
  @@index([brandIds(ops: ArrayOps)], type: Gin)
  @@map("knowledge_sources")
}

/// Retrieval unit. The embedding column is pgvector; its hnsw index
/// (`idx_chunks_embedding_hnsw`) is created in a migration because Prisma
/// cannot express index methods. It is approximate, and only
/// `KnowledgeService.search` reads it — above the exact-search ceiling, with
/// the plan pinned and its settings rolled back (tm 254). Search through the
/// service: the planner cannot see what a vector's TOAST read costs, so a new
/// query ordered by a bare `<=>` gets the approximate index or a full scan by a
/// hair, and on the index it can miss rows without saying so.
model KnowledgeChunk {
  id             String                       @id @default(uuid()) @db.Uuid
  sourceId       String                       @map("source_id") @db.Uuid
  licenseId      BigInt                       @map("license_id")
  chunkText      String                       @map("chunk_text")
  embedding      Unsupported("vector(1536)")?
  /// The vector space `embedding` lives in, as `<provider>:<model>` -- the
  /// `EmbeddingProvider.space` that wrote it (tm 255.7 / PLAN D182).
  /// Retrieval compares a question only with chunks of its own space: two
  /// spaces' vectors side by side are neighbours by accident. The default is
  /// the lexical stub's space, which every vector written before this column
  /// existed is in; `KnowledgeService.index` always names the space it writes.
  embeddingSpace String                       @default("mock:lexical-v1") @map("embedding_space")
  tokenCount     Int?                         @map("token_count")
  position       Int                          @default(0)
  /// The crawled page the chunk was cut from (tm 312 · AI-17), so a changed
  /// page's chunks are replaced and a removed page's deleted without touching
  /// the rest of its source. Null for every chunk that is not a crawled
  /// page's — and for a website source's chunks indexed before page tracking.
  pageId         String?                      @map("page_id") @db.Uuid
  /// The pages of a PDF/Word document the chunk was cut from, 1-based and
  /// inclusive (tm 313 · AI-18) — what an answer cites. Both or neither.
  pageFrom       Int?                         @map("page_from")
  pageTo         Int?                         @map("page_to")
  /// The document heading the chunk sits under, when it had one.
  heading        String?
  /// The source's `chunkGeneration` the chunk was written in (ADR-14b §2.8).
  generation     Int                          @default(1)
  /// The published versions that see the chunk, as `ai_config_versions.seq`:
  /// from `visibleFromVersion` (null — no published version yet) until
  /// `hiddenFromVersion` (null — still visible). Each is written once and a
  /// closed range is never reopened, by trigger (20261115090000).
  visibleFromVersion BigInt?                  @map("visible_from_version")
  hiddenFromVersion  BigInt?                  @map("hidden_from_version")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  page   KnowledgePage?  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([sourceId, position])
  @@index([licenseId])
  @@index([pageId])
  @@index([licenseId, visibleFromVersion, hiddenFromVersion], map: "knowledge_chunks_visibility_idx")
  @@map("knowledge_chunks")
}

/// One page of a website source's crawl (tm 312 · AI-17): the URL in the
/// normalised spelling the frontier keeps, what became of it
/// (`KNOWLEDGE_PAGE_STATUSES`) and the hash of its extracted text — a
/// re-crawl whose hash matches embeds nothing. One row per source and URL
/// (`url_hash` = sha256 of `url`, hex). Never holds the page's text: that
/// is its chunks. RLS per licence; the CHECKs live in
/// `20261110090000_knowledge_crawl`.
model KnowledgePage {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   BigInt    @map("license_id")
  sourceId    String    @map("source_id") @db.Uuid
  url         String
  urlHash     String    @map("url_hash") @db.Char(64)
  title       String?
  /// The page's `<html lang>`, as a primary subtag; null when it said none.
  lang        String?
  /// sha256 of the extracted text, hex; null until a fetch produced text.
  contentHash String?   @map("content_hash") @db.Char(64)
  /// `KNOWLEDGE_PAGE_STATUSES`.
  status      String
  httpStatus  Int?      @map("http_status")
  /// A snake_case code (`fetch_timeout`, `ssrf_refused`…) — never page text.
  error       String?
  /// Links from the start URL (0 = the start URL or a sitemap entry).
  depth       Int       @default(0)
  /// Consecutive 404/410 answers; two make the page `removed`.
  missCount   Int       @default(0) @map("miss_count")
  chunkCount  Int       @default(0) @map("chunk_count")
  fetchedAt   DateTime? @map("fetched_at") @db.Timestamptz(6)
  /// When `content_hash` last changed — the "review what changed" list.
  changedAt   DateTime? @map("changed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  source KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@unique([sourceId, urlHash])
  @@index([sourceId, status])
  @@index([licenseId])
  @@map("knowledge_pages")
}

/// A knowledge job (tm 312 · AI-17): a website source's crawl or re-crawl —
/// later a large document's parse (AI-18) — worked through by a background
/// runner (tm 312.3), never by the request that asked for it. `frontier` is
/// what is left to fetch, so a job stopped by the day's AI allowance
/// (`waiting_budget`) or a restart resumes where it was. A source has at most
/// one job under way (`knowledge_jobs_one_active_per_source`, a partial
/// unique index Prisma cannot express). RLS per licence.
model KnowledgeJob {
  id              String    @id @default(uuid()) @db.Uuid
  licenseId       BigInt    @map("license_id")
  /// The licence's organization, so the runner can open the job's tenant
  /// context without a lookup (the `ai_jobs` shape).
  organizationId  String    @map("organization_id") @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  /// `KNOWLEDGE_JOB_KINDS`.
  kind            String
  /// `KNOWLEDGE_JOB_STATUSES`.
  status          String    @default("queued")
  /// URLs still to fetch, with their depth — the runner's to shape.
  frontier        Json      @default("[]")
  pagesDiscovered Int       @default(0) @map("pages_discovered")
  pagesDone       Int       @default(0) @map("pages_done")
  pagesOk         Int       @default(0) @map("pages_ok")
  pagesUnchanged  Int       @default(0) @map("pages_unchanged")
  pagesSkipped    Int       @default(0) @map("pages_skipped")
  pagesFailed     Int       @default(0) @map("pages_failed")
  pagesRemoved    Int       @default(0) @map("pages_removed")
  bytesFetched    BigInt    @default(0) @map("bytes_fetched")
  /// Soft reference to `accounts.id`; null when the sweep queued it.
  requestedBy     String?   @map("requested_by") @db.Uuid
  /// Not claimable before this — a `waiting_budget` job's UTC midnight.
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  /// Set while `running`: another runner may take the job once it passes.
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(6)
  attempts        Int       @default(0)
  /// A snake_case code — why the job failed or was stopped.
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([sourceId, createdAt])
  @@index([licenseId])
  @@map("knowledge_jobs")
}

// ---------------------------------------------------------------------------
// Structured knowledge tables (tm 310 · AI-13, K13 · ADR-14b §2.12)
// ---------------------------------------------------------------------------
// Four fixed tables the AI computes from rather than reads prose from, and the
// workspace's "access information" setting. `@siyahtus/types`
// `knowledge-tables.ts` holds their vocabulary, validators and the Turkish row
// text; the CHECKs live in `20261021120000_knowledge_tables`.
//
// Editing tables (ADR-14b §2.1): no publish state, every write goes through
// `services/ai/config-draft.ts`, rows are copied into the AI configuration
// package once tm 316 versions it. `brand_ids` is the brands a row is for —
// empty is every brand — a soft list the reader narrows by, never RLS (a row
// may be several brands'); a brand's own row beats the every-brand row with
// the same name. `owner_id`, `reviewed_at` and `review_interval_days` are meta
// fields (ADR-14b §2.2): due again `review_interval_days` after `reviewed_at`,
// warned about, still used. `source = 'integration'` rows are filled by an
// integration (F2) and are not edited by hand. Who-did-it columns are soft
// references, like `handoff_routes.created_by`.

/// A payment method (AI-13): what "my deposit has not arrived" is judged
/// against — the expected time, the delay threshold, the working hours.
model KbPaymentMethod {
  id                    String    @id @default(uuid()) @db.Uuid
  licenseId             BigInt    @map("license_id")
  brandIds              String[]  @default([]) @map("brand_ids") @db.Uuid
  name                  String
  /// Other names players use ("PPR"); unique with `name` within a direction
  /// and an overlapping brand scope (`findKnowledgeTableConflicts`).
  aliases               String[]  @default([])
  /// `PAYMENT_DIRECTIONS`.
  direction             String
  /// ISO 4217 alpha-3.
  currency              String    @default("TRY")
  minAmount             Decimal?  @map("min_amount") @db.Decimal(18, 2)
  maxAmount             Decimal?  @map("max_amount") @db.Decimal(18, 2)
  expectedMinutes       Int?      @map("expected_minutes")
  /// Past this many minutes a transaction counts as delayed; never below
  /// `expectedMinutes`.
  delayThresholdMinutes Int?      @map("delay_threshold_minutes")
  /// `PaymentWorkingHours`; null = around the clock.
  workingHours          Json?     @map("working_hours")
  requiresSiteRequest   Boolean   @default(false) @map("requires_site_request")
  referenceInstructions String?   @map("reference_instructions")
  /// `PAYMENT_REFERENCE_FORMATS` — a fixed list, never a tenant's regex (ReDoS).
  referenceFormat       String    @default("none") @map("reference_format")
  receiptRequired       Boolean   @default(false) @map("receipt_required")
  thirdPartyAllowed     Boolean   @default(false) @map("third_party_allowed")
  /// Crypto networks (`TRC20`, `ERC20`, …).
  networks              String[]  @default([])
  /// `PaymentCommonError[]`.
  commonErrors          Json      @default("[]") @map("common_errors")
  customerNotes         String?   @map("customer_notes")
  active                Boolean   @default(true)
  ownerId               String?   @map("owner_id") @db.Uuid
  reviewedAt            DateTime  @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewIntervalDays    Int       @default(14) @map("review_interval_days")
  /// `KNOWLEDGE_TABLE_ROW_SOURCES`.
  source                String    @default("manual")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, direction])
  @@map("kb_payment_methods")
}

/// A bonus (AI-13). Wagering is explained with a general worked example only —
/// never "your remaining wagering", which the AI cannot see.
model KbBonus {
  id                 String    @id @default(uuid()) @db.Uuid
  licenseId          BigInt    @map("license_id")
  brandIds           String[]  @default([]) @map("brand_ids") @db.Uuid
  name               String
  aliases            String[]  @default([])
  /// `BONUS_TYPES`.
  type               String    @default("other")
  minDeposit         Decimal?  @map("min_deposit") @db.Decimal(18, 2)
  wageringMultiplier Decimal?  @map("wagering_multiplier") @db.Decimal(8, 2)
  /// `BONUS_WAGERING_BASES`; null when the bonus has no wagering.
  wageringBase       String?   @map("wagering_base")
  /// `BonusContribution[]`.
  contributing       Json      @default("[]")
  minOdds            Decimal?  @map("min_odds") @db.Decimal(8, 2)
  maxBet             Decimal?  @map("max_bet") @db.Decimal(18, 2)
  maxCashout         Decimal?  @map("max_cashout") @db.Decimal(18, 2)
  validityDays       Int?      @map("validity_days")
  /// `BONUS_CLAIM_METHODS`; `code` needs `promoCode`.
  claimMethod        String    @default("auto") @map("claim_method")
  promoCode          String?   @map("promo_code")
  /// Soft references to `kb_payment_methods.id`.
  excludedMethodIds  String[]  @default([]) @map("excluded_method_ids") @db.Uuid
  activeFrom         DateTime? @map("active_from") @db.Timestamptz(6)
  /// The campaign's end; a review falls due then too (AI-13-S2).
  activeTo           DateTime? @map("active_to") @db.Timestamptz(6)
  termsText          String?   @map("terms_text")
  ownerId            String?   @map("owner_id") @db.Uuid
  reviewedAt         DateTime  @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewIntervalDays Int       @default(30) @map("review_interval_days")
  source             String    @default("manual")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("kb_bonuses")
}

/// A KYC document the workspace asks for (AI-13): what it accepts, when, how
/// long a review takes and where it is uploaded.
model KbKycDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  licenseId          BigInt   @map("license_id")
  brandIds           String[] @default([]) @map("brand_ids") @db.Uuid
  /// The document's name ("Kimlik kartı"), unique within an overlapping brand scope.
  docType            String   @map("doc_type")
  acceptanceCriteria String[] @default([]) @map("acceptance_criteria")
  whenRequired       String?  @map("when_required")
  reviewHours        Int?     @map("review_hours")
  uploadPathText     String?  @map("upload_path_text")
  chatUploadAllowed  Boolean  @default(false) @map("chat_upload_allowed")
  ownerId            String?  @map("owner_id") @db.Uuid
  reviewedAt         DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewIntervalDays Int      @default(90) @map("review_interval_days")
  source             String   @default("manual")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("kb_kyc_documents")
}

/// A limit or rule (AI-13): one keyed value, as text and/or a number with its unit.
model KbRule {
  id                 String   @id @default(uuid()) @db.Uuid
  licenseId          BigInt   @map("license_id")
  brandIds           String[] @default([]) @map("brand_ids") @db.Uuid
  /// `KB_RULE_KEY_PATTERN`, unique within an overlapping brand scope.
  key                String
  /// `KB_RULE_CATEGORIES`.
  category           String   @default("other")
  title              String
  valueText          String?  @map("value_text")
  numericValue       Decimal? @map("numeric_value") @db.Decimal(20, 4)
  unit               String?
  description        String?
  ownerId            String?  @map("owner_id") @db.Uuid
  reviewedAt         DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  reviewIntervalDays Int      @default(90) @map("review_interval_days")
  source             String   @default("manual")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, category])
  @@map("kb_rules")
}

/// The workspace's "access information" (K13 · AI-08 G14): what the AI says
/// when a player cannot reach the site or asks for its current address — only
/// what the workspace entered, from one of three sources. One row for every
/// brand (`brand_id` null) and at most one per brand; no row, no answer (the
/// AI hands over). The workspace is responsible for the content (the panel
/// says so).
model AiAccessInfo {
  id            String    @id @default(uuid()) @db.Uuid
  licenseId     BigInt    @map("license_id")
  brandId       String?   @map("brand_id") @db.Uuid
  /// `AI_ACCESS_INFO_SOURCE_TYPES`: `kb_row` — a knowledge source or table
  /// row's source (`kbSourceId`); `dynamic_url` — fetched when asked (`url`,
  /// cached `cacheSeconds`, `lastValue` when the fetch fails); `fixed_link`.
  sourceType    String    @map("source_type")
  /// Soft reference to `knowledge_sources.id`; one gone is no answer.
  kbSourceId    String?   @map("kb_source_id") @db.Uuid
  url           String?
  cacheSeconds  Int       @default(300) @map("cache_seconds")
  /// The last value a `dynamic_url` fetch returned, and when.
  lastValue     String?   @map("last_value")
  lastFetchedAt DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  /// What the AI says with a fixed link.
  fixedText     String?   @map("fixed_text")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("ai_access_info")
}

// ===========================================================================
// Configuration
// ===========================================================================

/// Rules deciding which team a new conversation lands in (ADR-08 step 1).
model RoutingRule {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  name          String?
  kind          String   @default("chat")
  /// url / domain / geolocation / page predicates.
  conditions    Json     @default("{}")
  targetGroupId BigInt?  @map("target_group_id")
  priority      Int      @default(0)
  /// The catch-all used when nothing else matches. At most one per license+kind.
  isFallback    Boolean  @default(false) @map("is_fallback")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, kind, enabled, priority])
  @@map("routing_rules")
}

/// A connected inbound channel.
model Channel {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  brandId   String   @map("brand_id") @db.Uuid
  type      String
  status    String   @default("off")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// tm 263: a live Telegram bot token, encrypted (lib/credential-cipher.ts).
  /// Null for every mock channel. Paired with `webhookSecretHash` (CHECK).
  credentialCiphertext String? @map("credential_ciphertext")
  /// SHA-256 of the secret_token Telegram presents on every webhook call.
  webhookSecretHash    String? @map("webhook_secret_hash")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Brand-scoped, not just license-scoped: one license may run the same channel
  // type once per brand (Multibrand, PRD §5.3). RLS narrows visibility to the
  // active brand on top of this key.
  @@unique([licenseId, brandId, type])
  // A second, platform-wide uniqueness rule lives in
  // 20260809090000_channel_address_uniqueness and cannot be written here:
  // UNIQUE (type, (config->>'address')) WHERE status = 'connected' AND
  // config->>'address' IS NOT NULL. It is what makes an inbound webhook's
  // address resolve to exactly one workspace (NFR-S4/S5); Prisma can express
  // neither a JSON expression index nor a WHERE predicate, so it is hand-written
  // and registered in `scripts/check-drift.ts` (KNOWN_UNMODELLABLE).
  @@map("channels")
}

/// Maps a channel's external sender identity (a Messenger PSID, a phone number)
/// to a customer (FR-MOD-08.5.4-.6). A returning contact is matched here, so
/// their history is one thread rather than a new stranger each time, and an
/// outbound reply is addressed by looking the external id back up from the chat.
model ChannelIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  channelType String   @map("channel_type")
  externalId  String   @map("external_id")
  customerId  String   @map("customer_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([licenseId, channelType, externalId])
  @@map("channel_identities")
}

/// One message that crossed a channel adapter — the audit trail of what entered
/// (inbound) and left (outbound) the workspace over Messenger/SMS/WhatsApp.
/// `chat_id` is a soft reference (no FK): the record outlives the conversation.
model ChannelMessage {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         BigInt   @map("license_id")
  channelType       String   @map("channel_type")
  direction         String
  externalId        String   @map("external_id")
  chatId            String?  @map("chat_id")
  text              String?
  providerMessageId String?  @map("provider_message_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, channelType, createdAt])
  @@index([licenseId, chatId])
  @@map("channel_messages")
}

/// A forwarding address a workspace's support mail arrives at (FR-MOD-08.5.3).
///
/// The default address is `<organization_id>@<inbound-domain>` — the row whose
/// `label` is null — and a workspace may define further ones as
/// `<organization_id>+<label>@<inbound-domain>`. The organization id in front of
/// the label is what makes an address un-collidable between tenants, and
/// `local_part` carries the whole routing key, so the database rather than a
/// parsing rule is what refuses two workspaces the same address.
///
/// Two constraints live only in 20260905140000_inbound_email_addresses: the
/// label's slug CHECK, and the partial unique index that allows a licence
/// exactly one default address (`WHERE label IS NULL`, registered in
/// `scripts/check-drift.ts` because Prisma cannot express a WHERE predicate).
model InboundEmailAddress {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  /// The part after the `+`, or null for the workspace's default address.
  label     String?
  /// The full local part a provider addressed: `<org>` or `<org>+<label>`.
  localPart String   @unique @map("local_part")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([licenseId, label])
  @@map("inbound_email_addresses")
}

/// A site the widget is installed on.
///
/// Brand-scoped, not just license-scoped (Multibrand, PRD §5.3): a site belongs
/// to exactly one brand, and the same domain may be added once per brand — the
/// `(license, brand, domain)` unique key. RLS narrows the list to the active
/// brand on top of that; a license-wide request (no brand) still sees every
/// brand's sites, so a single-brand workspace is unchanged.
model Website {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   BigInt    @map("license_id")
  brandId     String    @map("brand_id") @db.Uuid
  domain      String
  createdBy   String?   @map("created_by")
  connectedAt DateTime? @map("connected_at") @db.Timestamptz(6)
  setup       String    @default("manual")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([licenseId, brandId, domain])
  @@map("websites")
}

/// A brand under a license — the Multibrand surface (PRD §5.3 · NFR-S4).
///
/// Shaped like `Website`: license-scoped, a uuid id, `onDelete: Cascade`. Every
/// license owns at least one brand — the migration backfill and the seed lay
/// down a single `Default` (`is_default`) row, so a workspace that never touches
/// Multibrand keeps behaving exactly as one brand. At most one default per
/// license is enforced by a partial unique index (`ON brands(license_id) WHERE
/// is_default`), which Prisma cannot express and the migration adds by hand.
model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  name      String
  slug      String
  logoUrl   String?  @map("logo_url")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license          License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  channels         Channel[]
  websites         Website[]
  securitySettings SecuritySettings[]
  inboxSettings    InboxSettings[]
  widgetSettings   WidgetSettings[]
  handoffRoutes    HandoffRoute[]
  aiAccessInfo     AiAccessInfo[]
  aiTestScenarios  AiTestScenario[]
  aiUnresolved     AiUnresolvedItem[]

  @@unique([licenseId, slug])
  @@map("brands")
}

/// Outbound webhook registration.
///
/// `secretKey` is the HMAC signing key (v2-04 §6.2). Unlike the platform this
/// clones, it is never echoed back inside the payload — only the signature
/// travels, so the secret cannot leak through a customer's request logs.
model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  clientId  String?  @map("client_id")
  url       String
  action    String
  secretKey String   @map("secret_key")
  type      String   @default("license")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The automation card this subscription belongs to (FR-MOD-09.4) — a
  /// catalogue id, `zapier` or `make`. Null for a hand-registered webhook, which
  /// is what every row was before this column existed.
  ///
  /// Deliberately a plain text catalogue id and not a foreign key to
  /// `app_installations`: the catalogue is static data in @siyahtus/types, and the
  /// installation row is what the *connection* is. Tying the two by id lets the
  /// gate live where it belongs — a subscription may only be created while the
  /// card is connected, and disconnecting removes them — without a cascade that
  /// would delete a workspace's automations as a side effect of a schema
  /// relation nobody reads.
  appId String? @map("app_id")

  license    License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([licenseId, action, enabled])
  @@index([licenseId, appId])
  @@map("webhooks")
}

/// One outbound delivery attempt (FR-MOD-08.8.4 · NFR-M5; redelivery M-SCHED-e).
///
/// Every attempt — the first try, each in-request retry and each scheduled
/// redelivery — writes a row, so the trail of what was sent and how it fared is
/// complete and auditable. Two kinds of column live here and they behave
/// differently:
///
///   * **History** (`attempt`, `ok`, `status_code`, `error`, `created_at`) is
///     written once and never changed. It records one send.
///   * **Queue state** (`state`, `next_attempt_at`, `payload`) is mutable, and
///     is only ever live on the newest row of a delivery. It is what lets a
///     redelivery survive a restart: `pending` means "this attempt failed and
///     another is owed at `next_attempt_at`", and the payload beside it is the
///     exact body to re-sign and re-send.
///
/// `event_id` groups the attempts of one logical delivery (one domain event to
/// one webhook). A partial unique index on `(license_id, event_id) WHERE state
/// = 'pending'` — hand-written in the migration, since Prisma cannot express a
/// predicate — is what guarantees an event is queued in exactly one place, and
/// so can never be picked up and delivered twice.
///
/// `permanent` is now the boolean shadow of `state = 'exhausted'`, held to it
/// by a CHECK. It used to mean "the third in-request attempt failed", which
/// stopped meaning "gave up" the moment a scheduler began carrying the row on.
model WebhookDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  licenseId     BigInt    @map("license_id")
  webhookId     String    @map("webhook_id") @db.Uuid
  /// Null on rows written before redelivery existed; those can never be queued.
  eventId       String?   @map("event_id") @db.Uuid
  action        String
  attempt       Int
  ok            Boolean
  statusCode    Int?      @map("status_code")
  error         String?
  permanent     Boolean   @default(false)
  /// `pending` | `delivered` | `failed` | `exhausted`. The migration's CHECK
  /// constraint is the authority on the vocabulary; there is deliberately no
  /// default, so every writer has to say which of the four it means.
  state         String
  /// Live only while `state = 'pending'`: when the delivery is next owed a try
  /// and — pushed forward by the sweep that claims it — the lease that stops a
  /// second worker taking the same row.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// The exact serialized body to re-send, held only while a retry is still
  /// owed and cleared the moment the delivery is terminal. Text rather than
  /// jsonb because these are the bytes the signature commits to and jsonb
  /// would reorder them; kept off terminal rows so a delivered webhook leaves
  /// no lasting copy of a customer payload in the log.
  payload       String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([licenseId, webhookId, createdAt])
  @@index([licenseId, state, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Per-brand security configuration (PRD §8.4 `security_settings` · §5.3).
///
/// Keyed by `(license, brand)`, one row per brand (Multibrand). The settings
/// screen resolves the row from `X-SiyahTus-Brand`, or the license default when no
/// brand is named — so a single-brand workspace keeps its single row. RLS
/// narrows the row to the active brand on top of the license match.
model SecuritySettings {
  licenseId                 BigInt   @map("license_id")
  brandId                   String   @map("brand_id") @db.Uuid
  bannedCustomerIps         String[] @default([]) @map("banned_customer_ips")
  spamFilterEnabled         Boolean  @default(true) @map("spam_filter_enabled")
  fileSharingEnabled        Boolean  @default(true) @map("file_sharing_enabled")
  allowedFileTypes          String[] @default(["image/png", "image/jpeg", "application/pdf"]) @map("allowed_file_types")
  maxFileSizeBytes          Int      @default(10485760) @map("max_file_size_bytes")
  requireTwoFactor          Boolean  @default(false) @map("require_two_factor")
  /// Whether the `ipAllowlistEntries` list is enforced for agent/PAT/bot requests
  /// (FR-MOD-08.9.6). When true, the auth edge (plugins/auth.ts) admits only
  /// source addresses matching an entry; off, or with an empty list, imposes no
  /// restriction. Customer/widget traffic is exempt (that surface uses
  /// `bannedCustomerIps`).
  ipAllowlistEnforced       Boolean  @default(false) @map("ip_allowlist_enforced")
  /// Seconds of inactivity before a session is force-expired. Null disables
  /// the policy (the default) — nothing enforces this yet.
  sessionIdleTimeoutSeconds Int?     @map("session_idle_timeout_seconds")
  /// Per-owner cap on simultaneous active sessions. Null falls back to the
  /// fixed `MAX_ACTIVE_TOKENS_PER_OWNER` constant (25) — nothing reads this
  /// column to enforce it yet.
  maxConcurrentSessions     Int?     @map("max_concurrent_sessions")
  /// How many AI turns one member may have answered per conversation day
  /// (tm 339.1 · GV-01); 0 turns the per-member allowance off. CHECK 0-10000.
  aiTurnsPerCustomerDay     Int      @default(40) @map("ai_turns_per_customer_day")
  /// When the widget asks a visitor for a human check (tm 339.2 · GV-01):
  /// `off`, `risk` (only when the risk signals fire) or `always_on_chat_start`.
  /// CHECK holds `CAPTCHA_MODES`.
  captchaMode               String   @default("risk") @map("captcha_mode")
  /// Treat every file a player e-mails as sensitive (tm 357 · HD-02); off, only a
  /// file whose name or the mail's subject names an ID document is.
  inboundAttachmentsSensitive Boolean @default(false) @map("inbound_attachments_sensitive")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("security_settings")
}

/// Per-brand inbox behaviour (FR-MOD-08.7, "Settings/Inbox tools").
///
/// A singleton keyed by `(license, brand)`, like `SecuritySettings`. Signup does
/// not create the row — the settings endpoint upserts it on first save under the
/// resolved brand, and a read with no row falls back to the schema defaults — so
/// a workspace that has never touched these behaves as "everything off".
model InboxSettings {
  licenseId          BigInt   @map("license_id")
  brandId            String   @map("brand_id") @db.Uuid
  /// Auto-close a chat after this many seconds with no activity (FR-MOD-08.7.3).
  /// Null disables it. Only a positive value is ever written — enforced at the
  /// settings endpoint and re-checked by the sweep, so a zero or negative window
  /// (which would close every live chat at once) can never take effect.
  chatTimeoutSeconds Int?     @map("chat_timeout_seconds")
  /// The IANA zone a conversation's day is counted in (ID-04 · K3). Defaults to
  /// `DEFAULT_DAY_BOUNDARY.timezone`; the endpoint checks it against `Intl`.
  dayBoundaryTz      String   @default("Europe/Istanbul") @map("day_boundary_tz")
  /// The local hour a conversation day starts at, 0-23 (CHECK in the migration).
  /// Defaults to `DEFAULT_DAY_BOUNDARY.hour`.
  dayBoundaryHour    Int      @default(0) @map("day_boundary_hour") @db.SmallInt
  /// Seconds an assigned connection may wait for its agent's first reply before
  /// the sweep passes it to someone else in the team (WG-03 · tm 340). Null: off.
  /// Positive by CHECK; the endpoint also keeps it below the two windows after it.
  unansweredTransferSeconds Int? @map("unanswered_transfer_seconds")
  /// Seconds without an event before a connection is inactive and out of its
  /// agent's concurrent limit (WG-03). Null: off. Positive by CHECK.
  inactiveAfterSeconds Int? @map("inactive_after_seconds")
  /// Whether the inactivity sweep sets an agent it took an unanswered
  /// connection from to `not_accepting_chats` (WG-03 · tm 340.2). On by default.
  pauseUnresponsiveAgents Boolean @default(true) @map("pause_unresponsive_agents")
  /// Days after its last activity that a player's e-mailed answer still reopens
  /// a solved ticket (HD-03 · tm 358); later, or on a closed ticket, it opens a
  /// related one. 1-365 by CHECK; `TICKET_REOPEN_WINDOW_DAYS_DEFAULT`.
  ticketReopenWindowDays Int @default(30) @map("ticket_reopen_window_days")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("inbox_settings")
}

/// Per-brand widget appearance (FR-MOD-11.7, "Widget customization").
///
/// A singleton keyed by `(license, brand)`, like `InboxSettings`. Signup does
/// not create the row — the settings endpoint upserts it on first save under the
/// resolved brand, and a read with no row falls back to the schema defaults — so
/// a workspace that has never touched these renders the shipped look. The column
/// defaults mirror `DEFAULT_WIDGET_APPEARANCE` in `@siyahtus/types` value-for-value.
model WidgetSettings {
  licenseId        BigInt   @map("license_id")
  brandId          String   @map("brand_id") @db.Uuid
  /// Brand colour — a `#rrggbb` hex, checked by the settings endpoint and the
  /// `widget_settings_color_check` DB invariant so nothing but a colour is ever
  /// stored (it is embedded in the install snippet and applied to CSS).
  primaryColor     String   @default("#2d67fa") @map("primary_color")
  /// `bottom-right` | `bottom-left` — the `widget_settings_position_check`.
  position         String   @default("bottom-right")
  /// `auto` | `light` | `dark` — the `widget_settings_theme_check`.
  theme            String   @default("light")
  mobileFullscreen Boolean  @default(true) @map("mobile_fullscreen")
  /// The removable "Powered by SiyahTuş" footer (FR-MOD-11.5).
  poweredBy        Boolean  @default(true) @map("powered_by")
  /// The welcome message's bold first line and its text (owner, 2026-10-13);
  /// null shows the widget's built-in line. Lengths are the
  /// `widget_settings_welcome_*_length` checks.
  welcomeTitle     String?  @map("welcome_title")
  welcomeText      String?  @map("welcome_text")
  /// The built-in pre-chat form (WG-01): whether it opens, and the four fields'
  /// `{visible, required}` as `PrechatConfig['fields']`. Null fields = never
  /// saved: reads as `DEFAULT_PRECHAT_CONFIG` and is not enforced server-side.
  /// Shape is the `widget_settings_prechat_fields_shape` check.
  prechatEnabled   Boolean  @default(true) @map("prechat_enabled")
  prechatFields    Json?    @map("prechat_fields")
  /// The widget's language (WG-02): `auto` (the visitor's browser) or one of
  /// the eight UI languages — `widget_settings_language_check`.
  language         String   @default("auto")
  /// What `auto` falls back to; the column default `en` keeps rows that existed
  /// before WG-02 as they were, new rows are written `tr` by the application.
  fallbackLanguage String   @default("en") @map("fallback_language")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([licenseId, brandId])
  @@map("widget_settings")
}

// ===========================================================================
// Billing (ADR-13 — Stripe is mocked)
// ===========================================================================

/// The payment method on file (FR-MOD-10.3, "ödeme yöntemi güncelleme").
///
/// A singleton per license, like `SecuritySettings`. Billing is mocked
/// (ADR-13), and real card entry is out of scope (PRD §11.1/1) — so this stores
/// only the *masked* representation a real processor would hand back after
/// tokenising a card (`brand` + `last4` + expiry + holder), never a full PAN.
/// Nothing here is PCI-sensitive and nothing is charged.
model PaymentMethod {
  licenseId  BigInt   @id @map("license_id")
  /// Card network — `visa`, `mastercard`, `amex`, `discover`.
  brand      String
  /// Last four digits only — the one card fragment that is safe to store.
  last4      String   @db.Char(4)
  expMonth   Int      @map("exp_month")
  expYear    Int      @map("exp_year")
  holderName String   @map("holder_name")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  licenseId             BigInt    @map("license_id")
  plan                  String    @default("growth")
  billingCycle          String    @default("monthly") @map("billing_cycle")
  seats                 Int       @default(1)
  unitPriceCents        Int       @default(9900) @map("unit_price_cents")
  aiResolutionsIncluded Int       @default(200) @map("ai_resolutions_included")
  status                String    @default("trialing")
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd      DateTime? @map("current_period_end") @db.Timestamptz(6)
  /// The subscription ends when its period does (tm 389.10, the platform's
  /// cancellation; #384 adds the owner's own and the period-end step). Until
  /// then nothing changes, and resuming clears both.
  cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime? @map("canceled_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, status])
  @@map("subscriptions")
}

/// Metered usage, aggregated per calendar month.
///
/// `ai_resolutions` is the single counter behind both billing and the Reports
/// "Automated" figure (ADR-09) — two counters would inevitably disagree.
model UsageRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  licenseId             BigInt   @map("license_id")
  metric                String
  /// `yyyymm`.
  period                String   @db.Char(6)
  quantity              BigInt   @default(0)
  included              BigInt   @default(0)
  overageUnit           Int      @default(1) @map("overage_unit")
  overageUnitPriceCents Int      @default(0) @map("overage_unit_price_cents")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, metric, period])
  @@map("usage_records")
}

/// Today's AI tokens against the daily caps (tm 257.8 · ADR
/// `docs/adr/pilot-public-readiness.md` K-e(3)) — one row per workspace, UTC
/// day and meter, plus one row per day and meter with `licenseId` null for
/// the whole deployment. `reserved` is what calls in flight were allowed to
/// spend, `used` what finished calls really cost; a call fits when
/// `reserved + used + its estimate` stays within the cap, on both rows.
///
/// Not written through Prisma: the `ai_budget_*` SECURITY DEFINER functions
/// (migration 20261002150000) are the only writers, so the check and the
/// increment are one statement and the deployment row is out of every
/// tenant's reach. Unique with NULLS NOT DISTINCT, which Prisma cannot say —
/// the index Prisma sees is the same three columns.
model AiDailyUsage {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt?  @map("license_id")
  /// `yyyymmdd`, UTC.
  day       String   @db.Char(8)
  /// `llm` (input + output tokens) or `embedding` (input tokens); `llm_test` /
  /// `embedding_test` for a simulation's spend (tm 283.2 · AI-19-S2) — on the
  /// workspace's row only, the deployment's row counts it on the live meter.
  meter     String
  reserved  BigInt   @default(0)
  used      BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License? @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, day, meter])
  @@map("ai_daily_usage")
}

/// One member's AI turns on one conversation day (tm 339.1 · GV-01): the
/// per-member daily allowance's counter. `day` is the workspace's conversation
/// day (ID-04), the one the member's daily chat is filed under. `ai_turns` is
/// raised by one statement that also checks the cap
/// (`services/ai/customer-ai-quota.ts`); `llm_tokens` is what those turns
/// cost, for the record — it decides nothing.
model AiCustomerDailyUsage {
  licenseId  BigInt   @map("license_id")
  customerId String   @map("customer_id") @db.Uuid
  day        DateTime @db.Date
  aiTurns    Int      @default(0) @map("ai_turns")
  llmTokens  BigInt   @default(0) @map("llm_tokens")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  license  License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([licenseId, customerId, day])
  @@index([customerId])
  @@map("ai_customer_daily_usage")
}

/// The AI usage ledger (tm 283.2 · AI-16): one row per settled call that cost
/// at least one token — which feature spent it, on which meter and model tier.
/// Written only by `ai_budget_settle_usage`, in the statement that settles
/// `ai_daily_usage`, so for a (workspace, day, meter) the rows add up to the
/// counter's `used`. A breakdown for the usage screen, never the cap. The
/// application role reads its own workspace's rows and writes none.
model AiUsageEvent {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  /// The reservation's UTC day (`yyyymmdd`) — the counter's key, not `at`'s.
  day             String   @db.Char(8)
  at              DateTime @db.Timestamptz(6)
  /// `@siyahtus/types` `AI_USAGE_SURFACES`; `ai_usage_events_surface_check`.
  surface         String
  /// `@siyahtus/types` `AI_USAGE_METERS`.
  meter           String
  /// `default` | `fast` on a completion, null on an embedding.
  modelTier       String?  @map("model_tier")
  inputTokens     BigInt   @map("input_tokens")
  outputTokens    BigInt   @map("output_tokens")
  /// The conversation the call was for, when it was for one. No foreign key:
  /// the ledger outlives the conversation's retention.
  chatId          String?  @map("chat_id") @db.VarChar(12)
  /// The AI configuration version that answered (tm 290), once versions exist.
  configVersionId String?  @map("config_version_id") @db.Uuid

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, at(sort: Desc)])
  @@map("ai_usage_events")
}

/// A notice that a workspace's daily AI allowance crossed 80% or 100% (tm
/// 283.3 · AI-16-S2). The unique key is the "once": per workspace, UTC day,
/// live meter and threshold — the process whose insert lands sends the notice.
/// Written before the notice goes out, so a failed send is never repeated.
model AiUsageAlert {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  /// `yyyymmdd`, UTC — the counter's day.
  day       String   @db.Char(8)
  /// `llm` | `embedding`: the live meters only.
  meter     String
  /// 80 | 100 (`@siyahtus/types` `AI_USAGE_ALERT_THRESHOLDS`).
  threshold Int      @db.SmallInt
  /// The counter and the cap that crossed it, as the notice reported them.
  used      BigInt
  cap       BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, day, meter, threshold])
  @@map("ai_usage_alerts")
}

/// A structured-table row announced as due for review (tm 310.5 · AI-13-S2).
/// The unique key is the "once": per workspace, table, row and due date — the
/// sweep whose insert lands sends the notice, and a row reviewed and lapsing
/// again has a new `due_at` and so a new notice.
model KnowledgeTableStaleNotice {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  /// `KNOWLEDGE_TABLES`.
  tableName String   @map("table_name")
  rowId     String   @map("row_id") @db.Uuid
  dueAt     DateTime @map("due_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, tableName, rowId, dueAt], map: "knowledge_table_stale_notices_once_key")
  @@map("knowledge_table_stale_notices")
}

/// Who besides the owner hears about the AI allowance (tm 283.3), chosen by
/// the owner. Narrowed to the workspace's current owner/admin members when a
/// notice is sent, so a member who left or was demoted is simply skipped.
model AiUsageAlertRecipient {
  licenseId BigInt   @map("license_id")
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([licenseId, accountId])
  @@index([accountId])
  @@map("ai_usage_alert_recipients")
}

/// Today's outgoing mail against the daily caps (tm 257.14 · ADR
/// `docs/adr/pilot-public-readiness.md` K-e(4)). Per workspace and UTC day:
/// `workspace` (everything it sent) and `external` (what left it). With
/// `licenseId` null: `global` (the deployment) and `recipient`, one row per
/// address hash, for the account mail an anonymous caller can trigger.
/// `sent` is what was handed to the carrier — a mail the carrier refused for
/// good is given back, one that may have arrived is not.
///
/// Not written through Prisma: the `mail_budget_*` SECURITY DEFINER functions
/// (migration 20261003150000) are the only writers, so the check and the
/// increment are one statement. Unique with NULLS NOT DISTINCT, which Prisma
/// cannot say — the index Prisma sees is the same four columns.
model MailDailyUsage {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt?  @map("license_id")
  /// `yyyymmdd`, UTC.
  day           String   @db.Char(8)
  /// `workspace`, `external`, `global` or `recipient`.
  meter         String
  /// SHA-256 of the lower-cased address, on `recipient` rows only.
  recipientHash String?  @map("recipient_hash") @db.Char(64)
  sent          Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License? @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, day, meter, recipientHash])
  @@map("mail_daily_usage")
}

/// One purchased API request package (FR-MOD-09.3).
///
/// The quota a purchase buys lives in `usage_records.included` — buying raises
/// the period's included calls — so this table is not the quota, it is the
/// *record of the sale*: which license bought which catalogue package, for how
/// many calls, at what price, into which period. Nothing else holds that.
/// Payment is mocked (ADR-13), so no external processor keeps a receipt, and
/// `usage_records` carries only the summed total, with no trace of what raised
/// it. Without this row a workspace could be charged with nothing to show for
/// what, and the invoice line item (09.3-e) would have nothing to derive from.
///
/// `package_id` names an `API_PACKAGE_CATALOG` entry in code rather than a row
/// — the catalogue is static (`@siyahtus/types`) — so it carries no foreign key and
/// no domain CHECK, the same way `scheduled_reports.group_id` names a
/// REPORT_GROUPS entry; the purchase route validates it instead. The quota and
/// the price are *copied* rather than looked up, so re-pricing a package in
/// code never rewrites what a workspace already paid.
model ApiPackagePurchase {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  /// An `API_PACKAGE_CATALOG` id — `essential`, `pro`, `pro-plus`.
  packageId   String   @map("package_id")
  /// Calls this purchase added, as the catalogue priced them at sale time.
  apiCalls    BigInt   @map("api_calls")
  priceCents  Int      @map("price_cents")
  /// `yyyymm` — the `usage_records` period the quota was added to.
  period      String   @db.Char(6)
  purchasedAt DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, period])
  @@map("api_package_purchases")
}

/// One sale of AI-resolution overage packs (FR-MOD-10.1.4). The pack size lives
/// in code (`AI_RESOLUTION_PACK_SIZE`), so the row records how many packs were
/// bought *and* the resolutions they added — the second is redundant only until
/// the pack size changes, at which point it is the only honest record of what
/// was sold.
model AiPackagePurchase {
  id String @id @default(uuid()) @db.Uuid

  licenseId BigInt @map("license_id")

  /// Caller-supplied key that makes a repeated purchase request a no-op. Unique
  /// per license, so a double-submitted buy credits quota once.
  idempotencyKey String @map("idempotency_key")

  packs Int

  /// Resolutions this purchase added, as the pack size stood at sale time.
  resolutions Int

  priceCents Int @map("price_cents")

  /// `yyyymm` — the `usage_records` period the quota was added to.
  period      String   @db.Char(6)
  purchasedAt DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, idempotencyKey])
  @@index([licenseId, period])
  @@map("ai_package_purchases")
}

/// One frozen billing statement for one closed period (FR-MOD-10.3).
///
/// Before this table existed the invoice history was *derived on read*, and
/// every past period was priced from whatever `subscriptions` said today — so a
/// plan change silently rewrote statements the workspace had already been shown.
/// A row here is written once, by the period-close sweep
/// (`invoice-close-sweep.ts`), and never updated: `siyahtus_app` holds SELECT and
/// INSERT only. That is the whole point of the table, and the reason the
/// privilege is withheld rather than merely unused.
///
/// The *current* period is deliberately absent. It has not closed, nothing has
/// been billed, and its figures are supposed to move with usage — it is served
/// as an `estimate` computed on read. A period only becomes a row when it ends.
///
/// `origin` records how the figures were arrived at, because the two ways are
/// not equally strong: `issued` was frozen in the month right after the period,
/// from the subscription as it then stood; `reconstructed` was frozen later
/// (the backfill of periods that closed before this table existed), where the
/// metered and purchased lines are still exact — each carries its own price on
/// its own row — but the seat line could only be priced from the subscription
/// at write time, since per-period seat history was never retained.
model Invoice {
  id        String @id @default(uuid()) @db.Uuid
  licenseId BigInt @map("license_id")

  /// Human invoice number, `SIYAHTUS-<yyyymm>`. Frozen rather than derived: it is
  /// the identity the customer quotes back, so it must not restate itself if
  /// the format ever changes. Unique per workspace, not globally — every
  /// workspace numbers its own statements, exactly as the derived path did.
  number String

  /// `yyyymm` — the same period key `usage_records` and both purchase tables use.
  period      String   @db.Char(6)
  /// First instant of the period, UTC.
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  /// Exclusive upper bound — the first instant of the next month, UTC.
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)

  /// Statement date: the last day of the period's month. Deterministic, so it
  /// does not depend on when the sweep happened to run.
  issuedAt DateTime @map("issued_at") @db.Timestamptz(6)

  /// `issued` or `reconstructed` — see the model comment. `estimate` is not a
  /// stored value: an estimate is precisely a period with no row.
  origin String

  /// `paid` or `trial`. Frozen with the rest, so leaving the trial does not
  /// turn a workspace's trial months into paid ones. `open` is not storable
  /// for the same reason `estimate` is not.
  status String

  currency String @db.Char(3)

  subtotalCents Int @map("subtotal_cents")
  totalCents    Int @map("total_cents")

  /// When the row was written — distinct from `issuedAt`, and the only field
  /// that says how long after the period the freeze actually happened.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license   License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]
  /// Platform credits applied to this statement (tm 389.1).
  platformCredits PlatformCredit[]

  /// The only index the table needs. It is the idempotency guarantee for the
  /// sweep *and* the access path for the list, which reads one workspace's rows
  /// newest first — a btree serves that backwards, so a second `DESC` index
  /// would cost every insert and buy nothing.
  @@unique([licenseId, period])
  @@map("invoices")
}

/// One line on a frozen statement (FR-MOD-10.3).
///
/// A table rather than a JSON column on `invoices`: these are the amounts that
/// explain a charge, so each wants a typed integer and a CHECK rather than
/// whatever shape a blob happened to be written in. `position` keeps the order
/// the statement was composed in — seats, then each overage, then each package
/// bought — because a reordered statement reads as a different one.
///
/// `licenseId` is carried here as well as on the parent so the row can stand
/// under the same RLS policy every other tenant table uses, rather than
/// depending on a join for its isolation.
model InvoiceLineItem {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  licenseId   BigInt @map("license_id")
  position    Int
  description String
  amountCents Int    @map("amount_cents")
  /// The platform credit this line applies (tm 389.12), or null. A line below
  /// zero names its credit and a line naming one is below zero
  /// (`invoice_line_items_amount_check`); one line per credit.
  platformCreditId String? @unique @map("platform_credit_id") @db.Uuid

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  license        License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  platformCredit PlatformCredit? @relation(fields: [platformCreditId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ===========================================================================
// Audit
// ===========================================================================

/// Security-relevant actions. PRD §8.4 makes this available on every plan,
/// not just Enterprise as the source platform does.
model AuditLogEntry {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  actorId   String?  @map("actor_id")
  actorType String   @default("agent") @map("actor_type")
  /// `actor_type = 'platform'` only (tm 389.2): the member's account id while
  /// an operator is signed in as them. `actor_id` is then the operator.
  onBehalfOf String? @map("on_behalf_of")
  action    String
  target    String?
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Tamper-evident chain (NFR-C6 · C6-c). `chainSeq` is this workspace's own
  /// row counter — gapless by construction, so a missing number *is* a deleted
  /// entry — and `hash` is an HMAC over the row's content and `prevHash`, so a
  /// changed entry no longer matches the link that points at it. Nullable only
  /// because entries written before the chain existed cannot be back-computed:
  /// the key lives outside the database and a migration has no access to it.
  /// Claiming those rows are chained would be the false assurance this whole
  /// control exists to prevent, so they are honestly marked as not chained; the
  /// verifier reports any *post-genesis* row that is unchained as a finding.
  chainSeq BigInt? @map("chain_seq")
  prevHash String? @map("prev_hash")
  hash     String?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// No two entries may hold the same position. Postgres treats NULLs as
  /// distinct, so the pre-chain rows above are all still permitted — the
  /// constraint binds exactly the rows that make a claim.
  @@unique([licenseId, chainSeq])
  @@index([licenseId, createdAt(sort: Desc)])
  @@index([licenseId, action, createdAt(sort: Desc)])
  /// The export reads the same table the *other* way round — oldest first, from
  /// a keyset position — so the descending indexes above serve it backwards.
  /// Ascending index of its own, because a SIEM feed is a forward scan and the
  /// alternative is a sort of the workspace's entire trail on every poll.
  @@index([licenseId, createdAt, id])
  @@map("audit_log")
}

/// The head of a workspace's audit chain (NFR-C6 · C6-c).
///
/// One row per licence, holding the position and hash the *next* entry will
/// build on. It exists rather than being read back off `audit_log` for two
/// reasons, and both are about what happens after retention runs.
///
/// First, the anchor has to outlive the rows. Pruning removes the oldest
/// entries; if the next sequence number were `max(chain_seq) + 1` off the
/// table, a workspace whose trail was pruned to nothing would silently start
/// again at 1 and two different entries would carry the same position — so two
/// exports taken a year apart could disagree about which row seq 7 was.
///
/// Second, `prunedThroughSeq` is what tells a legitimate absence apart from a
/// deletion. Without it the verifier can only check that what remains is
/// contiguous, which means removing entries from the *front* of the retained
/// trail leaves no trace. With it, the first surviving row is expected at
/// `prunedThroughSeq + 1`, and anything else is a finding.
model AuditChainHead {
  licenseId        BigInt   @id @map("license_id")
  /// The position of the last entry chained for this licence. Advanced under a
  /// row lock, which is what serialises concurrent writers: two transactions
  /// reading the same head would otherwise fork the chain in two.
  seq              BigInt   @default(0)
  /// That entry's hash — the `prevHash` of whatever comes next. Null only
  /// between the row being created and the first entry landing.
  hash             String?
  /// When this licence's chain began. A row written after this instant and left
  /// unchained is a finding, which is what stops "unchained" being usable as a
  /// way to hide an entry in plain sight.
  genesisAt        DateTime @default(now()) @map("genesis_at") @db.Timestamptz(6)
  /// The highest position retention has legitimately removed. Written by
  /// `audit_prune_expired`, the one function permitted to delete from the log.
  prunedThroughSeq BigInt?  @map("pruned_through_seq")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("audit_chain_heads")
}

/// An audit entry a migration recorded but could not sign (tm 324.3).
///
/// The chain's key is derived from `AUDIT_CHAIN_SECRET`, which the database
/// never holds, so a SQL migration cannot write a valid `audit_log` row: one it
/// inserted would carry no chain, and after a workspace's genesis that reads as
/// tampering (`unchained_entry`). The migration writes the entry here instead,
/// in the statement that makes the change; the API signs it into the chain at
/// boot and deletes it in that same transaction (`services/audit/pending-audit.ts`).
/// Empty except between a deploy and the next boot. The application reads and
/// deletes; only a migration inserts.
model PendingAuditEntry {
  id         BigInt   @id @default(autoincrement())
  licenseId  BigInt   @map("license_id")
  /// One of `AUDIT_ACTIONS` — checked when signed, where the list lives.
  action     String
  target     String?
  metadata   Json     @default("{}")
  /// When the change was made. The signed entry's own timestamp is the moment
  /// it was signed, so this travels in its metadata as `occurred_at`.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, id])
  @@map("pending_audit_entries")
}

/// A workspace's permission matrix choices (tm 325.2 · RL-02): one row per
/// cell that differs from the catalogue's default (`@siyahtus/types`
/// `CAPABILITIES`). Written only by `PUT /settings/permissions`, which deletes
/// a row set back to its default. `role` is one of the columns the Founder may
/// change — `admin`, `team_lead`, `agent` (`role_capability_overrides_role_check`,
/// which Prisma cannot model); `capability` and `value` are checked against the
/// catalogue by the resolution, which ignores a row it does not recognise.
model RoleCapabilityOverride {
  licenseId  BigInt   @map("license_id")
  role       String
  capability String
  value      String
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([licenseId, role, capability])
  @@map("role_capability_overrides")
}

/// Where a workspace's audit trail is shipped, and how far it has got
/// (NFR-C6 · C6-b).
///
/// One row per (licence, target). The row is *both* the configuration and the
/// position, deliberately: they cannot be allowed to disagree. Held apart, a
/// workspace could point the export at a new destination while the old
/// destination's position carried on, and the trail would appear delivered to
/// somewhere it never reached.
///
/// The position is the last row this target has been *delivered*, as the full
/// keyset `(created_at, id)` — the same sort key the export pages on, so a
/// resume lands exactly where the last delivery ended. It is written by the
/// scheduled sink (C6-d); the pull endpoint (`GET /audit-log/export`) does not
/// touch it, because there the caller holds the cursor and two consumers
/// sharing one position would each skip the other's rows.
model SiemExportCursor {
  id        String  @id @default(uuid()) @db.Uuid
  licenseId BigInt  @map("license_id")
  /// A `SIEM_EXPORT_TARGETS` value — `file` today, the `.data/siem` sink.
  /// Constrained in the database (`siem_export_cursors_target_check`): a target
  /// nothing can deliver to would sit in the settings screen looking like a
  /// live export while nothing ever leaves.
  target    String
  /// Configuration and delivery are two decisions, like `SsoConnection.enabled`:
  /// a workspace can name its destination before turning the feed on.
  enabled   Boolean @default(false)

  /// The keyset position of the last delivered entry — `audit_log.id` and its
  /// `created_at`. Soft reference, no foreign key: retention prunes the trail
  /// (`audit_prune_expired`) and the position must survive the disappearance of
  /// the row it names, or pruning would drag the cursor back to the beginning
  /// and re-deliver everything. Both halves are set together or neither is
  /// (`siem_export_cursors_cursor_halves_check`) — half a keyset is an
  /// ambiguous resume point, and the ambiguity resolves to either skipping or
  /// re-sending an unbounded number of rows.
  lastExportedId String?   @map("last_exported_id") @db.Uuid
  lastExportedAt DateTime? @map("last_exported_at") @db.Timestamptz(6)
  /// When a delivery last completed — *not* the cursor. The two differ by the
  /// age of the trail: a sink that ran a minute ago and found nothing new has a
  /// fresh `lastRunAt` and an old `lastExportedAt`, and the status screen has to
  /// tell "nothing happened" apart from "nothing is being shipped".
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  /// Running total of entries delivered to this target, ever. Cheap to keep and
  /// the only figure that survives retention pruning the rows it counted.
  exportedCount  BigInt    @default(0) @map("exported_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, target])
  @@map("siem_export_cursors")
}

// ===========================================================================
// Apps marketplace (FR-MOD-09.1)
// ===========================================================================

/// A third-party integration a workspace has connected through the (mock) OAuth
/// flow. The catalogue of *available* apps is static (@siyahtus/types APP_CATALOG);
/// this table records only which of them a licence has connected, one row per
/// app. `externalAccount` is the account label the mock grant returned; the
/// granted scopes are the catalogue entry's, so they are not stored again here.
model AppInstallation {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  appId           String   @map("app_id")
  status          String   @default("connected")
  externalAccount String   @map("external_account")
  connectedAt     DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// SHA-256 of the API key an `api_key` app was connected with (09.2). Null for
  /// an OAuth install. Never returned by any endpoint — `apiKeyLastFour` is the
  /// only thing a client learns about the key.
  apiKeyHash     String? @map("api_key_hash")
  /// The last four characters of that key — the display hint. Set exactly when
  /// `apiKeyHash` is (a database CHECK holds the pair together).
  apiKeyLastFour String? @map("api_key_last_four")

  /// tm 263: the provider credential of a live card, AES-256-GCM under
  /// APPS_CREDENTIAL_KEY (lib/credential-cipher.ts). Never returned by any
  /// endpoint. Set exactly when `live` is (database CHECK).
  credentialCiphertext String?   @map("credential_ciphertext")
  /// The non-secret half of a credential (Freshdesk's subdomain).
  credentialConfig     Json?     @map("credential_config")
  /// When the provider last accepted the credential.
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  live                 Boolean   @default(false)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, appId])
  @@map("app_installations")
}

// ===========================================================================
// Public knowledge base (self-service KB — PRD §5.3, v2)
// ===========================================================================

/// A grouping public KB readers browse (KK "self-servis gezinme"). Deliberately
/// a separate model from `KnowledgeSource` — that table feeds the AI Agent's
/// RAG retrieval, this one is reader-facing taxonomy; the two never share rows
/// (§C-PUBKB-1). A slug is unique within a license, like `Brand`/`Expertise`.
model KbCategory {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  slug      String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  articles KbArticle[]

  @@unique([licenseId, slug])
  @@map("kb_categories")
}

/// A public KB article. `seoTitle`/`seoDescription` carry the KK "SEO'lu" half
/// of the requirement; `status` the "public" half (a draft is never served by
/// the anonymous read path, built in PUBKB-c). `categoryId` is optional so an
/// article can exist before it is filed under a category; deleting a category
/// clears the link rather than deleting the article.
model KbArticle {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      BigInt    @map("license_id")
  categoryId     String?   @map("category_id") @db.Uuid
  slug           String
  title          String
  body           String
  excerpt        String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  /// 'draft' | 'published'.
  status         String    @default("draft")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  /// Who besides the reader may use the article once it is published (tm 309 ·
  /// AI-14-S2, `KNOWLEDGE_AUDIENCES`): both unless switched off, empty = the AI
  /// does not use it. Read by the publish hook from tm 309.2.
  aiAudiences    String[]  @default(["ai_agent", "copilot"]) @map("ai_audiences")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  license         License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  category        KbCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  knowledgeSource KnowledgeSource?

  @@unique([licenseId, slug])
  @@index([licenseId, status, publishedAt(sort: Desc)])
  @@map("kb_articles")
}

/// Per-license switch and public address for the KB (license-singleton, keyed
/// and shaped like `payment_methods`). `publicSlug` is GLOBAL unique — unlike
/// every other slug in this schema — because it is the path segment on a
/// single shared public host (§C-PUBKB-4), not a value scoped inside one
/// license's own namespace.
model KbSettings {
  licenseId  BigInt   @id @map("license_id")
  enabled    Boolean  @default(false)
  publicSlug String   @unique @map("public_slug")
  siteTitle  String?  @map("site_title")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("kb_settings")
}

// ===========================================================================
// Work scheduler / staffing prediction (PRD §5.3-Vardiya, v2)
// ===========================================================================

/// An agent's standing weekly availability (WORKSCHED). Keyed `(license, agent)`
/// like `AgentMembership` — one plan per agent per workspace, and an agent who
/// works in two workspaces keeps two independent plans.
///
/// Deliberately separate from `AgentMembership.routingStatus`: that column is
/// the *live* toggle an agent flips themselves right now, this is the *plan*
/// the staffing forecast (WORKSCHED-g) reads to predict coverage ahead of time.
/// Collapsing them would make "is Ayşe online?" and "is Ayşe rostered?" the
/// same question, and the forecast needs both.
///
/// `schedule` is the `WorkScheduleSlot[]` of `@siyahtus/types`, stored as JSONB
/// because it is read and written whole — never queried slot-by-slot. The DB
/// guarantees only that it is an array (`work_schedules_schedule_is_array_check`);
/// the per-slot rules (known weekday, no repeats, `HH:MM`, start < end) are
/// `normalizeWorkSchedule()`'s job at the boundary. No row means the agent has
/// never opened the editor, which reads as `DEFAULT_WORK_SCHEDULE`.
model WorkSchedule {
  licenseId BigInt   @map("license_id")
  agentId   String   @map("agent_id") @db.Uuid
  /// IANA zone. A plan without one cannot be compared against real traffic, so
  /// the column defaults to `DEFAULT_WORK_SCHEDULE.timezone` value-for-value.
  timezone  String   @default("UTC")
  schedule  Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([licenseId, agentId])
  @@index([agentId])
  @@map("work_schedules")
}

/// A workspace's SLA targets (FR-MOD-11.5 · §5.4 "Kurumsal").
///
/// One row per licence — `license_id` *is* the primary key, because a target is
/// a workspace-wide policy rather than a list of them. The plural table name is
/// the plan's; the singular row is what the requirement asks for, and a second
/// row would immediately raise "which one applies?" with no answer written down.
///
/// Both minute columns are nullable and mean *no target*, which is a different
/// statement from a target of zero; a positivity CHECK in the migration keeps
/// the two from being confused. `business_hours_only` decides whether the clock
/// runs continuously or only during the hours `work_schedules` says the
/// workspace is open — no second calendar model was opened for it (§C-A27).
///
/// A row survives a downgrade (§C-A26): the read path stops honouring it, so a
/// re-upgrade restores the workspace's configuration instead of finding it
/// erased. `lib/entitlements.ts` is where that rule lives.
model SlaPolicy {
  licenseId            BigInt   @id @map("license_id")
  firstResponseMinutes Int?     @map("first_response_minutes")
  resolutionMinutes    Int?     @map("resolution_minutes")
  businessHoursOnly    Boolean  @default(false) @map("business_hours_only")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

/// One recorded miss — the report row a breach produces (§C-A27).
///
/// Append-only in shape, like `AgentPresenceEvent`: a row is a fact about a
/// moment that passed, so nothing edits one afterwards except `notified_at`,
/// which records that the alert for it went out. The unique key
/// `(licence, subject, target)` is what makes marking *idempotent*: the clock
/// stopping and the sweep can both notice the same miss, and the second one to
/// arrive changes nothing. Without it a case left open over a weekend would
/// collect one row per sweep.
///
/// `target_minutes` and `business_hours_only` are copied onto the row rather
/// than joined from the policy, because the policy is editable: a report that
/// re-read it would describe last month's misses against this month's targets.
model SlaBreach {
  id                String    @id @default(uuid()) @db.Uuid
  licenseId         BigInt    @map("license_id")
  /// `thread` or `ticket` — `SLA_SUBJECT_TYPES` in `@siyahtus/types`.
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id")
  /// `first_response` or `resolution` — `SLA_TARGETS` in `@siyahtus/types`.
  target            String
  targetMinutes     Int       @map("target_minutes")
  /// Elapsed when the miss was noticed; business minutes when the policy said so.
  elapsedMinutes    Int       @map("elapsed_minutes")
  businessHoursOnly Boolean   @map("business_hours_only")
  detectedAt        DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  /// When the alert for this miss was sent, or null while it is still pending.
  notifiedAt        DateTime? @map("notified_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, subjectType, subjectId, target], map: "sla_breaches_subject_key")
  @@index([licenseId, detectedAt(sort: Desc)])
  @@index([licenseId, notifiedAt])
  @@map("sla_breaches")
}

/// One recorded change of an agent's routing status — the presence history the
/// forecast compares the plan against ("rostered until 18:00, actually went
/// offline at 16:20").
///
/// Append-only in shape: a row is a fact about a moment, so there is no
/// `updated_at` and nothing edits one after the fact. It is an event log like
/// `WebhookDelivery`, not a settings row, and carries its own `license_id` so
/// the tenant policy is the plain license match.
///
/// The index is `(license, agent, changed_at)` because every reader asks the
/// same question — one agent's transitions inside one workspace over a window.
model AgentPresenceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  agentId   String   @map("agent_id") @db.Uuid
  /// One of `ROUTING_STATUSES` (`@siyahtus/types`), the same domain as
  /// `AgentMembership.routingStatus` — enforced by
  /// `agent_presence_events_status_check`, the mirror of
  /// `agent_memberships_routing_status_check`.
  status    String
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent   Account @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([licenseId, agentId, changedAt])
  @@map("agent_presence_events")
}

// ===========================================================================
// Scheduled report exports (PRD §5.3-Reports, v2)
// ===========================================================================

/// A standing instruction to mail one report group out on a cadence
/// (07.9-sched). The definition only; the scheduler that acts on it lands in
/// 07.9-sched-e and writes a `ScheduledReportRun` per period.
///
/// `groupId` names a `REPORT_GROUPS` entry (`routes/reports-export.ts`) rather
/// than a row in a table, so there is deliberately no foreign key and no domain
/// CHECK: the catalogue lives in code and grew by four groups in 07.7 alone, and
/// a database constraint would turn each addition into a migration. The route
/// (07.9-sched-b) validates the id against `reportGroup()` at the boundary, the
/// same place the manual export already does.
model ScheduledReport {
  id               String    @id @default(uuid()) @db.Uuid
  licenseId        BigInt    @map("license_id")
  /// A `REPORT_GROUPS` id — 'overview', 'leads', 'sales', …
  groupId          String    @map("group_id")
  /// 'daily' | 'weekly' | 'monthly'. Constrained in the database
  /// (`scheduled_reports_frequency_check`) because the period key the scheduler
  /// deduplicates on is derived *from* this value: an unknown frequency would
  /// yield an undefined period, and with it no "already delivered" answer.
  frequency        String
  /// 'csv' — the only shape the scheduler produces. Left unconstrained on
  /// purpose: PDF is a plausible later addition (07.7-g already renders one for
  /// the manual export) and a CHECK here would cost a migration to allow it,
  /// while a wrong value fails loudly at generation time rather than corrupting
  /// anything.
  format           String    @default("csv")
  /// Mailbox addresses the run is delivered to. Never empty
  /// (`scheduled_reports_recipients_not_empty_check`): a definition with no
  /// recipients would still claim its period and so deliver to nobody, silently,
  /// forever.
  recipients       String[]
  enabled          Boolean   @default(true)
  /// Soft reference to `accounts.id`, like `Skill.createdBy` and
  /// `KbArticle.createdBy` — no FK, so the workspace keeps its schedule when the
  /// agent who set it up leaves.
  createdByAgentId String?   @map("created_by_agent_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set by the scheduler after a successful delivery. A convenience for the
  /// list screen (07.9-sched-h) only — never the idempotency check, which reads
  /// `scheduled_report_runs`.
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(6)

  license License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  runs    ScheduledReportRun[]

  /// Not decoration — the target of `scheduled_report_runs`' composite foreign
  /// key, which is what stops one license claiming a period on another's
  /// schedule. Doubles as the index behind the by-id lookup routes (07.9-sched-c).
  @@unique([licenseId, id])
  /// The sweep's only question: which of this license's schedules are live?
  @@index([licenseId, enabled])
  @@map("scheduled_reports")
}

/// One period's delivery of a scheduled report — the history, and the lock.
///
/// `@@unique([scheduledReportId, periodKey])` is what makes the scheduler
/// idempotent: the run row is inserted *before* the mail goes out, so a second
/// sweep (a retry, an overlapping cron, two API instances) collides on the
/// constraint and knows the period is taken. That is why a failed delivery keeps
/// its row with `status = 'failed'` rather than deleting it — releasing the
/// period would let the next sweep mail the same report again. Modelled on
/// `CampaignSend`'s `(campaign_id, customer_id)` pair, which stops a campaign
/// firing twice at the same visitor.
///
/// The link to the schedule is a *composite* foreign key on
/// `(license_id, scheduled_report_id)` — the `AgentExpertise` pattern — and it
/// is a tenant guard, not a formality. With a plain `scheduled_report_id` FK,
/// tenant A could insert a run carrying its own `license_id` while pointing at
/// tenant B's schedule: the RLS `WITH CHECK` would pass, because the row really
/// is A's, yet the claim would occupy B's `(schedule, period)` slot and B's
/// report would silently never be delivered for that period. The composite key
/// makes that row impossible to write rather than merely invisible.
model ScheduledReportRun {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         BigInt   @map("license_id")
  scheduledReportId String   @map("scheduled_report_id") @db.Uuid
  /// The period this run covers, as a deterministic label derived from the
  /// frequency: `2026-07-31` (daily), `2026-W31` (weekly), `2026-07` (monthly).
  /// Shape-checked in the database (`scheduled_report_runs_period_key_check`):
  /// an empty or free-form key would collapse every period onto one row, and the
  /// report would be delivered exactly once and never again.
  periodKey         String   @map("period_key")
  periodFrom        DateTime @map("period_from") @db.Timestamptz(6)
  periodTo          DateTime @map("period_to") @db.Timestamptz(6)
  /// 'pending' (claimed, not yet delivered) | 'sent' | 'failed'.
  status            String   @default("pending")
  recipientCount    Int      @default(0) @map("recipient_count")
  rowCount          Int      @default(0) @map("row_count")
  /// Why the delivery failed, for the history screen (07.9-sched-g).
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license         License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  scheduledReport ScheduledReport @relation(fields: [licenseId, scheduledReportId], references: [licenseId, id], onDelete: Cascade)

  @@unique([scheduledReportId, periodKey])
  @@index([licenseId, scheduledReportId, createdAt])
  @@map("scheduled_report_runs")
}

/// A shareable report link (FR-MOD-07.3.1) — the "link" half of the Overview
/// header's "Share export/link".
///
/// A row is a standing, *anonymous* grant: whoever holds the token reads one
/// report group over one window with no account at all. Three columns are what
/// keep that bounded rather than open-ended, and none of them is optional by
/// accident:
///
///   * `groupId` — one `REPORT_GROUPS` id, so a link is scope-limited. No FK and
///     no domain CHECK, the `scheduled_reports.group_id` decision: the catalogue
///     lives in code and gains entries without a migration.
///   * `rangeFrom`/`rangeTo` — the window pinned at creation, not resolved per
///     view. A relative window would mean a link handed out in March quietly
///     starts answering with April's numbers.
///   * `expiresAt` — NOT NULL, and `report_share_links_expires_after_created_check`
///     makes the database say so. A nullable expiry is a permanent public URL one
///     forgotten branch away.
///
/// `tokenHash` is the whole credential story: the raw token is returned once by
/// `POST /reports/share-links` and never stored, exactly as `ApiToken` does it.
/// `tokenLastFour` exists so a workspace can tell two rows apart — four
/// characters of a 256-bit secret narrow a guess by nothing worth measuring, and
/// without them the management list is a column of identical dates.
///
/// Revocation stamps `revokedAt` rather than deleting the row: an access review
/// wants to see that a grant existed and was withdrawn, and a deleted row says
/// neither.
model ReportShareLink {
  id               String    @id @default(uuid()) @db.Uuid
  licenseId        BigInt    @map("license_id")
  /// A `REPORT_GROUPS` id — 'overview', 'leads', 'sales', …
  groupId          String    @map("group_id")
  /// SHA-256 of the token, base64url. Unique platform-wide: one token, one link.
  tokenHash        String    @unique @map("token_hash")
  /// The token's last four characters, for telling rows apart in the UI.
  tokenLastFour    String    @map("token_last_four")
  rangeFrom        DateTime  @map("range_from") @db.Timestamptz(6)
  rangeTo          DateTime  @map("range_to") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Soft reference to `accounts.id`, like `ScheduledReport.createdByAgentId` —
  /// no FK, so the link survives the agent who minted it leaving.
  createdByAgentId String?   @map("created_by_agent_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  /// The management list's only question: this licence's links, newest first.
  @@index([licenseId, createdAt])
  @@map("report_share_links")
}

// ===========================================================================
// The AI test bench (tm 314.1 · SiyahTuş analysis AI-19)
// ===========================================================================

/// A conversation the workspace wants its AI to get right (AI-19): scripted
/// (`turns` are the player's messages) or simulated (a model plays `persona`,
/// knowing `facts`, wanting `goal`), at a frozen moment, with what a tool step
/// would have returned (`tool_outputs`, AI-28) and what must come out
/// (`expectations`, `AiTestExpectations`). `brand_id` is the brand the
/// simulated conversation comes in through — a label, not a scope: the Test
/// tab lists every brand's scenarios. The vocabulary is `@siyahtus/types`
/// `ai-testing.ts`; the CHECKs and the trigger holding agent and brand to the
/// row's licence live in the migration (20261021200000_ai_testing).
model AiTestScenario {
  id           String    @id @default(uuid()) @db.Uuid
  licenseId    BigInt    @map("license_id")
  aiAgentId    String    @map("ai_agent_id") @db.Uuid
  brandId      String?   @map("brand_id") @db.Uuid
  name         String
  origin       String    @default("manual")
  /// What `origin` came from: a template key, a chat id, a QA finding id.
  originRef    String?   @map("origin_ref")
  mode         String    @default("scripted")
  persona      String    @default("normal")
  language     String    @default("tr")
  simulatedNow DateTime? @map("simulated_now") @db.Timestamptz(6)
  goal         String?
  turns        Json      @default("[]")
  facts        Json      @default("{}")
  toolOutputs  Json      @default("{}") @map("tool_outputs")
  expectations Json
  active       Boolean   @default(true)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent AiAgent          @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  brand   Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  results AiTestRunResult[]

  @@index([licenseId, aiAgentId])
  @@index([brandId])
  @@map("ai_test_scenarios")
}

/// One play of a set of scenarios against one configuration (AI-19): the
/// draft (at `draft_revision`), the published one, or a named version
/// (`config_version_id`, tm 316 — no foreign key until that table exists).
/// The counts are the results'; `compliance_*` are the platform pack's part
/// of them (AI-19-S1), on the row so the root panel (tm 389.19) reads a
/// workspace's last pack result without opening the results. Never deleted
/// by the workspace: the regression compares against an earlier run.
model AiTestRun {
  id                    String    @id @default(uuid()) @db.Uuid
  licenseId             BigInt    @map("license_id")
  aiAgentId             String    @map("ai_agent_id") @db.Uuid
  configTarget          String    @map("config_target")
  configVersionId       String?   @map("config_version_id") @db.Uuid
  draftRevision         Int?      @map("draft_revision")
  trigger               String
  status                String    @default("queued")
  scenarioCount         Int       @default(0) @map("scenario_count")
  passed                Int       @default(0)
  failed                Int       @default(0)
  errored               Int       @default(0)
  tokens                BigInt    @default(0)
  compliancePackVersion String?   @map("compliance_pack_version")
  compliancePassed      Int?      @map("compliance_passed")
  complianceFailed      Int?      @map("compliance_failed")
  error                 String?
  startedBy             String?   @map("started_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt             DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz(6)
  /// The scenarios the run plays, fixed when it is queued (tm 314.2); a worker
  /// that takes a run over plays the ones without a result.
  scenarioIds           String[]  @default([]) @map("scenario_ids") @db.Uuid
  /// How long the worker's claim holds the run; past it, the next claim takes it.
  leaseUntil            DateTime? @map("lease_until") @db.Timestamptz(6)
  /// Claims so far (`ai_test_runs_claim`); past the last, the run fails.
  attempts              Int       @default(0)

  license        License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent        AiAgent           @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  results        AiTestRunResult[]
  configVersions AiConfigVersion[]

  /// The run history of an agent, newest first; the regression's "previous run".
  /// Partial indexes Prisma cannot say (20261022090000): one open run per agent
  /// and target, one running run per workspace, and the claim's scan.
  @@index([licenseId, aiAgentId, createdAt])
  @@map("ai_test_runs")
}

/// One scenario of one run: why its conversation stopped, how it ended, its
/// transcript with every AI turn's decision trace, the hard checks that
/// decide `status`, and the judge's advice, which never does (AI-19-S3).
/// `scenario_key` is the scenario's id or a compliance key (`compliance:G3:tr`);
/// it outlives the scenario (`scenario_id` goes null) so the regression still
/// pairs it. The only edit a row takes is the judge's (column grant).
model AiTestRunResult {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     BigInt   @map("license_id")
  runId         String   @map("run_id") @db.Uuid
  scenarioId    String?  @map("scenario_id") @db.Uuid
  scenarioKey   String   @map("scenario_key")
  scenarioName  String   @map("scenario_name")
  status        String
  stopReason    String   @map("stop_reason")
  outcome       String?
  /// The team a hand-over went to (`groups.id`); no foreign key — a team
  /// deleted later must not rewrite what the run saw.
  handoffTeamId BigInt?  @map("handoff_team_id")
  transcript    Json     @default("[]")
  checks        Json     @default("[]")
  judge         Json?
  tokens        Int      @default(0)
  durationMs    Int      @default(0) @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license  License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  run      AiTestRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenario AiTestScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@unique([runId, scenarioKey])
  @@index([licenseId])
  @@index([scenarioId])
  @@map("ai_test_run_results")
}

/// "Talk like a player" (AI-19 §8): one person's conversation with the AI on
/// a configuration, the same turn as a run, kept until `expires_at` (24 hours
/// after the last turn, `AI_SANDBOX_SESSION_TTL_HOURS`, set by the API).
model AiSandboxSession {
  id              String   @id @default(uuid()) @db.Uuid
  licenseId       BigInt   @map("license_id")
  aiAgentId       String   @map("ai_agent_id") @db.Uuid
  configTarget    String   @default("draft") @map("config_target")
  configVersionId String?  @map("config_version_id") @db.Uuid
  state           Json     @default("{}")
  transcript      Json     @default("[]")
  tokens          Int      @default(0)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdBy])
  @@index([expiresAt])
  @@map("ai_sandbox_sessions")
}

/// One message the AI could not resolve (tm 317.1 · SiyahTuş analysis AI-22):
/// why (`UNRESOLVED_REASONS`), the player's words and the player's message
/// before them, masked (AI-26), the language, and the embedding the turn's
/// search already made. Written by the live turn after its reply and by the
/// close of a conversation the player left on the AI's question; never by a
/// simulation or a preview. Goes with its chat and its thread (erasure,
/// retention) and at the latest after `UNRESOLVED_TEXT_RETENTION_DAYS`.
/// `event_id` names the message (events are partitioned: no foreign key).
model AiUnresolvedItem {
  id              String                      @id @default(uuid()) @db.Uuid
  licenseId       BigInt                      @map("license_id")
  aiAgentId       String                      @map("ai_agent_id") @db.Uuid
  brandId         String?                     @map("brand_id") @db.Uuid
  /// The day container (panel "Thread ID").
  chatId          String                      @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID").
  threadId        String                      @map("thread_id") @db.VarChar(12)
  eventId         String?                     @map("event_id") @db.VarChar(40)
  textMasked      String                      @map("text_masked")
  contextMasked   String?                     @map("context_masked")
  language        String?
  reason          String
  /// The procedure the understanding call leaned to, when it named one.
  intentGuess     String?                     @map("intent_guess")
  /// The AI configuration the turn ran on (ADR-14b §2.7) — no relation until tm 316.
  configVersionId String?                     @map("config_version_id") @db.Uuid
  embedding       Unsupported("vector(1536)")?
  /// `EmbeddingProvider.space` of `embedding`; null exactly when there is none.
  embeddingSpace  String?                     @map("embedding_space")
  clusterId       String?                     @map("cluster_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  license License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent AiAgent              @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  brand   Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  chat    Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  thread  Thread               @relation(fields: [threadId], references: [id], onDelete: Cascade)
  cluster AiUnresolvedCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
  @@index([clusterId])
  @@index([chatId])
  @@index([threadId])
  @@map("ai_unresolved_items")
}

/// A group of unresolved messages that ask the same thing, per AI agent and
/// embedding space (AI-22 §4): its title, its counts and whether the workspace
/// ignored it or fixed it. Built by the clustering job (tm 317.2); the title
/// and the counts outlive the items' words (AI-22-S1).
model AiUnresolvedCluster {
  id             String                      @id @default(uuid()) @db.Uuid
  licenseId      BigInt                      @map("license_id")
  aiAgentId      String                      @map("ai_agent_id") @db.Uuid
  label          String
  labelSource    String                      @default("lexical") @map("label_source")
  centroid       Unsupported("vector(1536)")?
  embeddingSpace String                      @map("embedding_space")
  itemCount      Int                         @default(0) @map("item_count")
  count7d        Int                         @default(0) @map("count_7d")
  handoffCount   Int                         @default(0) @map("handoff_count")
  abandonCount   Int                         @default(0) @map("abandon_count")
  firstSeen      DateTime                    @map("first_seen") @db.Timestamptz(6)
  lastSeen       DateTime                    @map("last_seen") @db.Timestamptz(6)
  status         String                      @default("open")
  ignoreReason   String?                     @map("ignore_reason")
  /// The AI-21 change or version that fixed it — no relation until tm 316.
  linkedChangeId String?                     @map("linked_change_id") @db.Uuid
  resolvedAt     DateTime?                   @map("resolved_at") @db.Timestamptz(6)
  postFixCount   Int                         @default(0) @map("post_fix_count")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// What the title writer suggested (`UNRESOLVED_SUGGESTED_ACTIONS`); null from the lexical labeller (tm 317.2).
  suggestedAction String?                    @map("suggested_action")
  /// `item_count` when the title was written: grown by half, it is written again.
  labelledCount   Int                        @default(0) @map("labelled_count")
  /// When it last alarmed (AI-22-S2): at most once in `UNRESOLVED_ALERT_REPEAT_HOURS`.
  alertedAt       DateTime?                  @map("alerted_at") @db.Timestamptz(6)

  license License            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent AiAgent            @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  items   AiUnresolvedItem[]
  /// The suggestions merged into it or opened from it (tm 318.1 · AI-23).
  suggestions AiSuggestion[]

  @@index([licenseId, aiAgentId, embeddingSpace], map: "ai_unresolved_clusters_agent_space_idx")
  @@map("ai_unresolved_clusters")
}

/// A workspace's unresolved-questions settings (tm 317.2 · AI-22-S2): the
/// number of items one cluster gathers in `UNRESOLVED_SPIKE_WINDOW_MINUTES`
/// that alarms. No row is `UNRESOLVED_SPIKE_THRESHOLD_DEFAULT`. The CHECK,
/// RLS and grants live in the migration (20261022150000_ai_unresolved_clustering).
model AiUnresolvedSettings {
  licenseId      BigInt   @id @map("license_id")
  spikeThreshold Int      @default(20) @map("spike_threshold")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("ai_unresolved_settings")
}

/// The AI configuration change history (tm 315 · AI-21): one row per save of
/// an editing table (ADR-14b §2.5 step 3, `services/ai/config-history.ts`) —
/// the row before and after, their JSON-path difference, who and in which
/// role. Append-only: `siyahtus_app` holds SELECT and INSERT and nothing else
/// (the `invoices` pattern), so the record of what the AI was told cannot be
/// rewritten by whoever told it. Kept `aiConfigHistoryDays` (1825), outside
/// the audit log's 30-day prune; the workspace's deletion takes it. The
/// CHECKs, RLS, grants and the prune function live in the migration
/// (20261114090000_ai_config_changes).
model AiConfigChange {
  id            String   @id @db.Uuid
  licenseId     BigInt   @map("license_id")
  /// The customer-facing agent the change reaches, when there is one.
  aiAgentId     String?  @map("ai_agent_id") @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  action        String
  /// An account, a bot, or a system job's name (`actor_type = 'system'`).
  actorId       String?  @map("actor_id")
  actorType     String   @map("actor_type")
  /// The actor's role at the moment of the change; a later role change does not move it.
  actorRole     String?  @map("actor_role")
  at            DateTime @default(now()) @db.Timestamptz(6)
  /// The configuration version (tm 316); null before versioning.
  versionId     String?  @map("version_id") @db.Uuid
  draftRevision BigInt?  @map("draft_revision")
  before        Json?
  after         Json?
  diff          Json     @default("[]")
  note          String?
  requestId     String?  @map("request_id")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, at(sort: Desc), id(sort: Desc)])
  @@index([licenseId, entityType, entityId, at(sort: Desc)])
  @@map("ai_config_changes")
}

/// A version of a customer-facing agent's AI configuration (tm 316 · AI-20 ·
/// ADR-14b `docs/adr/ai-config-versioning.md` §2.3): the editing tables
/// compiled into one immutable package, submitted, reviewed and published.
/// The AI answers from the published one (`ai_agents.published_version_id`).
///
/// `number.minor` is the name on screen ("v12", "v12.1"); `seq` is the
/// licence's publication order, given at publication, and what a chunk's
/// visibility range holds. `package_format` 0 is the baseline the migration
/// wrote for every agent that existed (`AI_CONFIG_PACKAGE_FORMAT_BASELINE`):
/// the tables as they stood, not yet compiled — sealed once with its package.
///
/// By trigger and CHECK (20261115090000_ai_config_versions): the agent is the
/// licence's own and customer-facing; a published row's package, manifest,
/// hash and `seq` never change; status moves forward only; at most one open
/// (`in_review` | `approved`) and one `published` version per agent (partial
/// unique indexes Prisma cannot say). `siyahtus_app` cannot delete a version.
model AiConfigVersion {
  id                String    @id @default(uuid()) @db.Uuid
  licenseId         BigInt    @map("license_id")
  aiAgentId         String    @map("ai_agent_id") @db.Uuid
  number            Int
  minor             Int       @default(0)
  seq               BigInt?
  status            String
  snapshot          Json
  /// sha256 of the snapshot's canonical JSON, hex.
  snapshotHash      String    @map("snapshot_hash") @db.Char(64)
  packageFormat     Int       @map("package_format")
  /// `[{ source_id, generation, audiences, ai_agent_ids, brand_ids, language, type, valid_until }]`.
  knowledgeManifest Json      @default("[]") @map("knowledge_manifest")
  diffSummary       Json?     @map("diff_summary")
  /// The published version the package was diffed against.
  baseVersionId     String?   @map("base_version_id") @db.Uuid
  /// The agent's `draft_revision` the package was compiled from.
  draftRevision     BigInt    @map("draft_revision")
  /// The AI-19 run whose compliance pack passed for this revision.
  testRunId         String?   @map("test_run_id") @db.Uuid
  touchesCompliance Boolean   @default(false) @map("touches_compliance")
  /// Soft references to `accounts.id`, like `owner_id`; null is the system.
  submittedBy       String?   @map("submitted_by") @db.Uuid
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote        String?   @map("review_note")
  publishedBy       String?   @map("published_by") @db.Uuid
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz(6)
  /// The version a rollback copied the package of.
  rollbackOf        String?   @map("rollback_of") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  license        License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent        AiAgent           @relation("AiAgentVersions", fields: [aiAgentId], references: [id], onDelete: Cascade)
  publishedFor   AiAgent?          @relation("AiAgentPublishedVersion")
  baseVersion    AiConfigVersion?  @relation("AiConfigVersionBase", fields: [baseVersionId], references: [id], onDelete: NoAction)
  basedOn        AiConfigVersion[] @relation("AiConfigVersionBase")
  rollbackSource AiConfigVersion?  @relation("AiConfigVersionRollback", fields: [rollbackOf], references: [id], onDelete: NoAction)
  rollbacks      AiConfigVersion[] @relation("AiConfigVersionRollback")
  testRun        AiTestRun?        @relation(fields: [testRunId], references: [id], onDelete: SetNull)

  @@unique([licenseId, aiAgentId, number, minor])
  @@unique([licenseId, seq])
  @@map("ai_config_versions")
}

// ---------------------------------------------------------------------------
// Platform (root panel, tm 389 · docs/platform-admin/design.md §B2)
//
// The deployment operator's side. Every table below has row level security
// enabled with no policy and no grant to `siyahtus_app`, so the tenant API
// cannot read or write a single row; it is reached only through the
// `siyahtus_platform` role (BYPASSRLS) and the `platform_*` SECURITY DEFINER
// readers. Role, grants, CHECKs and the append-only trigger live in the
// migration (20261101090000_platform_role_and_tables).
// ---------------------------------------------------------------------------

/// A SiyahTuş operator — never a workspace `Account`. Role is one of
/// superadmin | support | billing | readonly (CHECK). TOTP is mandatory; the
/// secret is stored encrypted under `PLATFORM_SETTINGS_KEY`.
model PlatformAdmin {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.Citext
  /// scrypt (RFC 7914), the same format `accounts.password_hash` uses.
  passwordHash         String    @map("password_hash")
  role                 String
  totpSecretCiphertext String?   @map("totp_secret_ciphertext")
  totpEnrolledAt       DateTime? @map("totp_enrolled_at") @db.Timestamptz(6)
  /// The replay floor: the last TOTP step a code was accepted for (tm 389.4).
  totpLastUsedStep     BigInt?   @map("totp_last_used_step")
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(6)
  /// The operator who sent the invitation. Not a foreign key: operators are
  /// disabled, never deleted, and the attribution must survive either way.
  invitedBy            String?   @map("invited_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recoveryCodes         PlatformAdminRecoveryCode[]
  sessions              PlatformSession[]
  notes                 PlatformNote[]
  impersonationSessions PlatformImpersonationSession[]
  credits               PlatformCredit[]
  alertPrefs            PlatformAlertPrefs?

  @@map("platform_admins")
}

/// Single-use TOTP recovery codes, stored hashed.
model PlatformAdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_admin_recovery_codes")
}

/// An invitation to become an operator. Only the token's hash is stored.
model PlatformAdminInvite {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.Citext
  role       String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_admin_invites")
}

/// An operator's session. `stage` is `password` until TOTP is verified, then
/// `active`; only an active session reaches the platform routes (389.4).
model PlatformSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminId        String    @map("admin_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  stage          String    @default("password")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  totpVerifiedAt DateTime? @map("totp_verified_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  ip             String?
  userAgent      String?   @map("user_agent")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// The platform audit trail: one HMAC chain for the whole deployment, keyed
/// from `PLATFORM_SETTINGS_KEY` (writer: 389.5). Append-only — a trigger
/// refuses UPDATE and DELETE for every role. `adminId` and `licenseId` are
/// deliberately not foreign keys: the trail must outlive both.
model PlatformAuditLog {
  chainSeq   BigInt   @id @map("chain_seq")
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  licenseId  BigInt?  @map("license_id")
  reason     String?
  payload    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prevHash   String?  @map("prev_hash")
  hash       String

  @@index([licenseId, chainSeq])
  @@index([adminId, chainSeq])
  @@map("platform_audit_log")
}

/// The single head of the platform audit chain (CHECK id = 1). The writer
/// creates it on first use and advances it under a row lock.
model PlatformAuditChainHead {
  id        Int      @id @default(1)
  seq       BigInt   @default(0)
  hash      String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_audit_chain_head")
}

/// Deployment-wide settings, one jsonb value per key. The key list is closed
/// (CHECK, design.md §B2); `version` is the optimistic lock a write must match.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@map("platform_settings")
}

/// An operator's internal note about a workspace. Never shown to the tenant.
model PlatformNote {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId BigInt   @map("license_id")
  adminId   String   @map("admin_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  license License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  admin   PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([licenseId, createdAt(sort: Desc)])
  @@map("platform_notes")
}

/// Sign-up blocklist: an exact address, a domain (and its subdomains) or an
/// IP/CIDR. Read by the tenant API only through `platform_signup_blocked`.
model PlatformBlocklist {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  value     String
  reason    String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, value])
  @@map("platform_blocklist")
}

/// An operator viewing a workspace as one of its members (389.15).
model PlatformImpersonationSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @map("admin_id") @db.Uuid
  licenseId        BigInt    @map("license_id")
  accountId        String    @map("account_id") @db.Uuid
  mode             String    @default("read_only")
  handoffCodeHash  String?   @unique @map("handoff_code_hash")
  handoffExpiresAt DateTime? @map("handoff_expires_at") @db.Timestamptz(6)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  endReason        String?   @map("end_reason")

  admin   PlatformAdmin @relation(fields: [adminId], references: [id])
  license License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The tenant credentials this session was traded for (tm 389.2).
  tokens  ApiToken[]

  @@index([licenseId, startedAt(sort: Desc)])
  @@index([adminId, startedAt(sort: Desc)])
  @@map("platform_impersonation_sessions")
}

/// The platform's override of one workspace's plan (tm 389.2 · design §B3).
/// Written by the platform only — the tenant role holds SELECT and nothing
/// else; a row past `expiresAt` is ignored. A key present in `entitlements`
/// replaces the plan's value (`lib/entitlements.ts`); `seatCeiling` replaces
/// `SEAT_CEILING`; `mailDailyCap` replaces `MAIL_DAILY_PER_WORKSPACE`
/// (`mail_budget_spend`). The AI caps live on `licenses` (tm 283.2).
model LicenseOverride {
  licenseId    BigInt    @id @map("license_id")
  entitlements Json      @default("{}")
  seatCeiling  Int?      @map("seat_ceiling")
  mailDailyCap Int?      @map("mail_daily_cap")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  /// The operator (`platform_admins.id`); not a foreign key, the row outlives them.
  updatedBy    String?   @map("updated_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("license_overrides")
}

/// A credit an operator granted a workspace, in minor units (389.12).
model PlatformCredit {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   BigInt   @map("license_id")
  amountMinor BigInt   @map("amount_minor")
  currency    String
  reason      String
  adminId     String   @map("admin_id") @db.Uuid
  invoiceId   String?  @map("invoice_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The credit this row is what was left of (tm 389.12): a credit larger than
  /// the statement it landed on keeps the applied part and the rest opens here.
  remainderOf String?  @map("remainder_of") @db.Uuid

  license    License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  admin      PlatformAdmin    @relation(fields: [adminId], references: [id])
  invoice    Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  parent     PlatformCredit?  @relation("PlatformCreditRemainder", fields: [remainderOf], references: [id], onDelete: Cascade)
  remainders PlatformCredit[] @relation("PlatformCreditRemainder")
  lineItem   InvoiceLineItem?

  @@index([licenseId, createdAt(sort: Desc)])
  @@index([invoiceId])
  @@index([remainderOf])
  @@map("platform_credits")
}

/// Which alert kinds an operator wants (389.14).
model PlatformAlertPrefs {
  adminId   String   @id @map("admin_id") @db.Uuid
  kinds     String[] @default([])
  /// `en` or `tr` (tm 389.20); null reads as English. A CHECK keeps it to those two,
  /// which Prisma cannot model.
  locale    String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("platform_alert_prefs")
}

/// The AI coaching and suggestion queue (tm 318.1 · SiyahTuş analysis AI-23 ·
/// `@siyahtus/types` `ai-suggestions.ts`): an agent's mark on the AI's
/// message, or an answer of their own offered to the AI's knowledge, with a
/// masked copy of the last messages (`excerpt_masked`) that outlives the
/// conversation's retention — `thread_id` has no foreign key for that reason.
/// `team_id` is the conversation's team when it was made: what a Team Lead's
/// review is bounded to. The CHECKs, the trigger that keeps every reference in
/// the workspace, RLS and the one-per-mark partial unique index live in
/// `20261116090000_ai_suggestions`.
model AiSuggestion {
  id                String    @id @db.Uuid
  licenseId         BigInt    @map("license_id")
  aiAgentId         String    @map("ai_agent_id") @db.Uuid
  /// One of `SUGGESTION_KINDS`.
  kind              String
  /// One of `SUGGESTION_SOURCES`.
  source            String    @default("agent_flag")
  /// The day container (panel "Thread ID").
  chatId            String?   @map("chat_id") @db.VarChar(12)
  /// The connection (panel "Chat ID"); no foreign key — retention deletes it.
  threadId          String?   @map("thread_id") @db.VarChar(12)
  eventIds          String[]  @default([]) @map("event_ids")
  /// `SuggestionExcerptMessage[]`, masked when made (AI-26).
  excerptMasked     Json      @default("[]") @map("excerpt_masked")
  note              String?
  teamId            BigInt?   @map("team_id")
  /// `SuggestionProposedChange`; null until drafted or written.
  proposedChange    Json?     @map("proposed_change")
  /// What the drafting job took out (`SUGGESTION_SPECIFIC_KINDS`).
  removedSpecifics  String[]  @default([]) @map("removed_specifics")
  /// `llm` or `lexical`; null when no job drafted it.
  draftedBy         String?   @map("drafted_by")
  duplicateOf       String?   @map("duplicate_of") @db.Uuid
  clusterId         String?   @map("cluster_id") @db.Uuid
  similarChunkIds   String[]  @default([]) @map("similar_chunk_ids") @db.Uuid
  /// One of `SUGGESTION_STATUSES`.
  status            String    @default("new")
  reviewerId        String?   @map("reviewer_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote        String?   @map("review_note")
  /// The AI-21 change accepting it wrote; no foreign key — the history prunes itself.
  resultingChangeId String?   @map("resulting_change_id") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  license     License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  aiAgent     AiAgent              @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  chat        Chat?                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  duplicate   AiSuggestion?        @relation("AiSuggestionDuplicate", fields: [duplicateOf], references: [id], onDelete: SetNull)
  duplicates  AiSuggestion[]       @relation("AiSuggestionDuplicate")
  cluster     AiUnresolvedCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  reviewer    Account?             @relation("AiSuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  author      Account?             @relation("AiSuggestionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([licenseId, status, teamId, createdAt], map: "ai_suggestions_license_status_team_created_idx")
  @@index([createdBy, createdAt])
  @@index([chatId])
  @@map("ai_suggestions")
}
