{
  "name": "@siyahtus/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:pilot": "playwright test --config playwright.pilot.config.ts",
    "test:session": "playwright test --config playwright.session.config.ts",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint tests"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "axe-core": "~4.14.0",
    "typescript": "^5.7.2"
  }
}
