{
  "name": "@nexa/rtm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "tsx ../api/scripts/with-test-datastores.ts vitest run --passWithNoTests",
    "test:unit": "tsx ../api/scripts/with-test-datastores.ts vitest run --passWithNoTests --dir src",
    "test:integration": "tsx ../api/scripts/with-test-datastores.ts vitest run --passWithNoTests --dir test/integration"
  },
  "dependencies": {
    "@nexa/types": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
