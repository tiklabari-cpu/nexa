{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "NEXA_REGION",

    "DATABASE_URL",
    "DATABASE_APP_URL",
    "REDIS_URL",

    "NEXA_TEST_ISOLATION",
    "NEXA_TEST_LICENSE_ID_OFFSET",

    "API_PORT",
    "API_HOST",
    "API_BASE_URL",
    "TRUST_PROXY_HOPS",
    "SHUTDOWN_DRAIN_MS",
    "RTM_PORT",
    "RTM_HOST",
    "RTM_BASE_URL",
    "RTM_MAX_CONNECTIONS",
    "WEB_PORT",
    "WEB_ORIGIN",
    "WEB_APP_URL",
    "WIDGET_PORT",
    "WIDGET_BASE_URL",
    "INBOUND_EMAIL_DOMAIN",
    "INBOUND_EMAIL_SECRET",

    "JWT_SIGNING_KEY",
    "WEBHOOK_HMAC_SEED",
    "CUSTOMER_TOKEN_SECRET",
    "UPLOAD_SIGNING_KEY",
    "AUDIT_CHAIN_SECRET",
    "ACCESS_TOKEN_TTL",
    "REFRESH_TOKEN_TTL",
    "CUSTOMER_TOKEN_TTL",
    "AUTH_CODE_TTL",
    "TWO_FACTOR_ENROLLMENT_TICKET_TTL",

    "RATE_LIMIT_AGENT_PER_MIN",
    "RATE_LIMIT_AGENT_BURST",
    "RATE_LIMIT_CUSTOMER_PER_MIN",
    "RATE_LIMIT_ANON_PER_MIN",
    "RATE_LIMIT_AUTH_FAILURES_PER_MIN",
    "RATE_LIMIT_PUBKB_PER_MIN",
    "RATE_LIMIT_SCIM_PER_MIN",
    "RATE_LIMIT_RTM_PER_SEC",
    "RATE_LIMIT_HEALTH_PER_MIN",
    "RATE_LIMIT_TWO_FACTOR_PER_HOUR",

    "SCHEDULER_ENABLED",
    "SCHEDULE_JITTER_PCT",
    "SCHEDULE_CHAT_TIMEOUT_MS",
    "SCHEDULE_SLA_MS",
    "SCHEDULE_SIEM_MS",
    "SCHEDULE_SCHEDULED_REPORTS_MS",
    "SCHEDULE_RETENTION_MS",
    "SCHEDULE_WEBHOOK_REDELIVERY_MS",
    "RETENTION_ENABLED",
    "RETENTION_THREAD_DAYS",
    "RETENTION_VISIT_DAYS",
    "RETENTION_MAIL_DAYS",
    "RETENTION_AUDIT_DAYS",
    "WEBHOOK_MAX_ATTEMPTS",

    "TRIAL_DAYS",
    "UNIT_PRICE_CENTS",
    "AI_RESOLUTIONS_INCLUDED",
    "AI_OVERAGE_CENTS",
    "API_CALLS_INCLUDED",
    "API_CALL_OVERAGE_CENTS",

    "LLM_PROVIDER",
    "LLM_PROVIDER_REGION",
    "MAIL_PROVIDER",
    "MAIL_DIR",
    "PUSH_PROVIDER",
    "PUSH_DIR",
    "SIEM_DIR",
    "SIEM_PROVIDER",
    "SIEM_EXPORT_HORIZON_MS",
    "STORAGE_PROVIDER",
    "STORAGE_LOCAL_DIR",
    "UPLOAD_URL_TTL",
    "STRIPE_PROVIDER",
    "VIRUS_SCANNER",
    "OTEL_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
