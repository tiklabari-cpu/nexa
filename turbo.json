  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SIYAHTUS_BUILD_SOURCEMAPS"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@siyahtus/widget#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@siyahtus/widget#test:unit": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
